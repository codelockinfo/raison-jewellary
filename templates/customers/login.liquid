<div class="customer-login-page">
  <div class="container--narrow">
    <div class="login-form-container" id="login">
      <header class="section-header">
        <h1 class="section-header__title">Login</h1>
        <p class="section-header__sub">Enter your details to access your account.</p>
      </header>

      {% form 'customer_login' %}
        {{ form.errors | default_errors }}

        <div class="field">
          <label for="CustomerEmail">Email</label>
          <input type="email" name="customer[email]" id="CustomerEmail" placeholder="Email" autocomplete="email" autocorrect="off" autocapitalize="off" required>
        </div>

        {% if form.password_needed %}
          <div class="field">
            <label for="CustomerPassword">Password</label>
            <input type="password" name="customer[password]" id="CustomerPassword" placeholder="Password" required>
          </div>
          <div class="recover-link">
            <a href="#recover" id="RecoverPassword">Forgot your password?</a>
          </div>
        {% endif %}

        <div class="form-actions">
          <button type="submit" class="primary-btn full-width" aria-label="Sign In">Sign In</button>
        </div>

        <div class="register-link">
          <span>New customer?</span>
          <a href="{{ routes.account_register_url }}">Create an account</a>
        </div>
      {% endform %}
    </div>

    <div class="recover-form-container" id="recover" style="display: none;">
      <header class="section-header">
        <h1 class="section-header__title">Reset your password</h1>
        <p class="section-header__sub">We will send you an email to reset your password.</p>
      </header>

      {% form 'recover_customer_password' %}
        {{ form.errors | default_errors }}

        {% if form.posted_successfully? %}
          <span class="form-success" id="RecoverEmailSent">We've sent you an email with a link to update your password.</span>
        {% endif %}

        <div class="field">
          <label for="RecoverEmail">Email</label>
          <input type="email" name="email" id="RecoverEmail" placeholder="Email" autocomplete="email" autocorrect="off" autocapitalize="off" required>
        </div>

        <div class="form-actions">
          <button type="submit" class="primary-btn full-width" aria-label="Submit">Submit</button>
          <button type="button" class="link-btn" id="HideRecoverPasswordLink" aria-label="Cancel">Cancel</button>
        </div>
      {% endform %}
    </div>
  </div>
</div>

<style>
.customer-login-page {
  padding: 80px 0;
  background: #fdfdfd;
  min-height: 70vh;
  display: flex;
  align-items: center;
}
.container--narrow {
  max-width: 450px;
  margin: 0 auto;
  width: 100%;
  padding: 0 20px;
}
.login-form-container, .recover-form-container {
  background: #FEFEFE;
  padding: 40px;
  border-radius: 12px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.05);
  border: 1px solid #eee;
}
.section-header {
  text-align: center;
  margin-bottom: 30px;
}
.section-header__title {
  font-size: 2rem;
  margin-bottom: 8px;
  font-weight: 600;
  color: #111;
}
.section-header__sub {
  color: #666;
  font-size: 0.95rem;
}
.field {
  margin-bottom: 15px;
}
.field label {
  display: block;
  margin-bottom: 8px;
  font-weight: 500;
  font-size: 0.95rem;
  color: #111;
  text-align: left;
}
.field input {
  width: 100%;
  padding: 12px 16px;
  border: 1px solid #ddd;
  border-radius: 8px;
  font-size: 1rem;
  transition: all 0.3s ease;
}
.field input:focus {
  border-color: #000;
  outline: none;
  box-shadow: 0 0 0 2px rgba(0,0,0,0.05);
}
.recover-link {
  text-align: right;
  margin-bottom: 25px;
}
.recover-link a {
  font-size: 0.85rem;
  color: #666;
  text-decoration: none;
}
.recover-link a:hover {
  color: #000;
  text-decoration: underline;
}
.form-actions {
  margin-bottom: 25px;
}
.primary-btn {
  background: #000;
  color: #FEFEFE;
  border: none;
  padding: 14px;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
  transition: opacity 0.3s;
  width: 100%;
  font-size: 1rem;
}
.primary-btn:hover {
  opacity: 0.9;
}
.link-btn {
  background: none;
  border: none;
  color: #666;
  text-decoration: underline;
  display: block;
  margin: 15px auto 0;
  cursor: pointer;
}
.register-link {
  text-align: center;
  font-size: 0.9rem;
  color: #666;
  border-top: 1px solid #eee;
  padding-top: 20px;
}
.register-link a {
  color: #000;
  font-weight: 600;
  text-decoration: none;
  margin-left: 5px;
}
.register-link a:hover {
  text-decoration: underline;
}
.form-success {
  display: block;
  background: #e8f5e9;
  color: #2e7d32;
  padding: 10px;
  border-radius: 6px;
  margin-bottom: 20px;
  font-size: 0.9rem;
  border: 1px solid #c8e6c9;
}
.errors {
  background: #ffebee;
  color: #c62828;
  padding: 10px;
  border-radius: 6px;
  margin-bottom: 20px;
  font-size: 0.85rem;
  list-style: none;
  border: 1px solid #ffcdd2;
}
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const recoverTrigger = document.getElementById('RecoverPassword');
    const recoverCancel = document.getElementById('HideRecoverPasswordLink');
    const loginForm = document.getElementById('login');
    const recoverForm = document.getElementById('recover');

    if (recoverTrigger) {
      recoverTrigger.addEventListener('click', function(e) {
        e.preventDefault();
        loginForm.style.display = 'none';
        recoverForm.style.display = 'block';
      });
    }

    if (recoverCancel) {
      recoverCancel.addEventListener('click', function(e) {
        e.preventDefault();
        loginForm.style.display = 'block';
        recoverForm.style.display = 'none';
      });
    }

    // Check URL hash for direct access to recover
    if (window.location.hash === '#recover') {
      loginForm.style.display = 'none';
      recoverForm.style.display = 'block';
    }
  });
</script>
