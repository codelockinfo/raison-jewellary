    "editorial_story": {
      "type": "editorial-story",
      "settings": {
        "section_id": "story",
        "eyebrow": "ABOUT RISEON",
        "founder_name": "Apurva Yadav",
        "founder_role": "Founder, Riseon Jewels",
        "story_text": "Growing up with financial challenges taught me how much independence means to a woman. After my MBA and a career in an MNC, I wanted to build something that reflected women’s ambition and everyday progress. That purpose became Riseon Jewels—lightweight gold and lab-grown diamond jewellery for women creating their own identity. Each design is intended to celebrate her journey, from a first salary to a promotion or a personal new beginning. Through our Brand Partner Programme, my vision is also to help women pursue flexible earning opportunities through genuine jewellery sales. As Riseon grows, I want more women to feel confident celebrating their achievements and shaping their own future.",
        "button_label": "Explore everyday fine jewellery",
        "button_link": "#shop"
      }
    },
