    <script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
    <script src="{{ 'header.js' | asset_url }}" defer></script>

    <script>
      // Skeleton Loader — remove skeleton-loading class to reveal content
      (function() {
        function revealContent() {
          document.documentElement.classList.remove('skeleton-loading');
          document.body.classList.remove('skeleton-loading');
          
          // Re-init swiper instances and fire resize
          requestAnimationFrame(() => {
            document.querySelectorAll('.swiper, .swiper-container, .swiper-initialized').forEach(el => {
              if (el.swiper) {
                el.swiper.update();
              }
            });
            window.dispatchEvent(new Event('resize'));
          });
        }
        
        // Reveal after DOM is ready + very short smooth delay
        // We no longer wait for 'load' because that waits for EVERY image (slow!)
        document.addEventListener('DOMContentLoaded', function() {
          setTimeout(revealContent, 100);
        });
        
        // Hard failsafe — always reveal quickly
        setTimeout(revealContent, 1500);
      })();
    </script>


    
  </body>
</html>

