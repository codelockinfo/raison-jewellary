<footer class="riseon-footer" id="Footer-{{ section.id }}">
  <div class="footer-main">
    <div class="footer-brand">
      <a href="{{ routes.root_url }}" class="brand" aria-label="{{ shop.name }} home">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 220 }}" alt="{{ section.settings.logo.alt | default: shop.name }}" loading="lazy">
        {%- else -%}
          <img src="https://riseon-jewels.r-katariya56.chatgpt.site/riseon-logo-trimmed.png" alt="Riseon Jewels" loading="lazy">
        {%- endif -%}
        <span class="brand-tm" aria-label="Trademark">TM</span>
      </a>
      <p>{{ section.settings.brand_tagline | default: 'Modern fine jewellery for women rising in their own way.' }}</p>
      
      <div class="socials">
        {%- if section.settings.show_instagram != false -%}
          <a class="social-instagram" href="{{ section.settings.instagram_link | default: '#' }}" aria-label="Riseon Jewels on Instagram" title="Instagram" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle class="social-fill" cx="17.4" cy="6.7" r="1.15"></circle></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.show_youtube != false -%}
          <a class="social-youtube" href="{{ section.settings.youtube_link | default: '#' }}" aria-label="Riseon Jewels on YouTube" title="YouTube" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 8.2c-.2-1.5-1-2.6-2.5-2.8C16.6 5.1 14.3 5 12 5s-4.6.1-6.5.4C4 5.6 3.2 6.7 3 8.2 2.8 9.4 2.7 10.7 2.7 12s.1 2.6.3 3.8c.2 1.5 1 2.6 2.5 2.8 1.9.3 4.2.4 6.5.4s4.6-.1 6.5-.4c1.5-.2 2.3-1.3 2.5-2.8.2-1.2.3-2.5.3-3.8s-.1-2.6-.3-3.8Z"></path><path class="social-fill" d="m10 9 5 3-5 3V9Z"></path></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.show_facebook != false -%}
          <a class="social-facebook" href="{{ section.settings.facebook_link | default: '#' }}" aria-label="Riseon Jewels on Facebook" title="Facebook" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.2 21v-8h2.7l.4-3h-3.1V8.1c0-.9.3-1.5 1.6-1.5h1.7V3.9c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.4V10H8v3h2.8v8h3.4Z"></path></svg>
          </a>
        {%- endif -%}
      </div>
    </div>

    <!-- 1. SHOP -->
    <div class="footer-col">
      <h3>SHOP</h3>
      {%- if section.settings.menu_shop.links.size > 0 -%}
        {%- for link in section.settings.menu_shop.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="/collections/all">All Jewellery</a>
        <a href="/collections/ring">Rings</a>
        <a href="/collections/earring">Earrings</a>
        <a href="/collections/pendant-for-her">Pendants</a>
        <a href="/collections/bracelate-for-her">Bracelets &amp; Bangles</a>
        <a href="/collections/nose-pin">Nose Pin</a>
        <a href="/collections/mangalsutra-pendant">Mangalsutra</a>
        <a href="#shop">Gifts</a>
      {%- endif -%}
    </div>

    <!-- 2. CUSTOMER CARE -->
    <div class="footer-col">
      <h3>CUSTOMER CARE</h3>
      {%- if section.settings.menu_care.links.size > 0 -%}
        {%- for link in section.settings.menu_care.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="/pages/product-care">Product Care</a>
        <a href="/pages/track-order">Track Order</a>
        <a href="/pages/shipping-information">Shipping Information</a>
        <a href="/pages/faq">FAQs</a>
        <a href="{{ routes.account_login_url }}">Customer Login</a>
      {%- endif -%}
    </div>

    <!-- 3. ABOUT RISEON -->
    <div class="footer-col">
      <h3>ABOUT RISEON</h3>
      {%- if section.settings.menu_about.links.size > 0 -%}
        {%- for link in section.settings.menu_about.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="/pages/about-us">The Brand</a>
        <a href="/pages/brand-partner-programme">Brand Partner Programme</a>
        <a href="/pages/brand-partner-programme">Partner Login</a>
        <a href="/pages/contact-us">Careers</a>
        <a href="/pages/contact-us">Contact Us</a>
      {%- endif -%}
    </div>

    <!-- 4. RISEON JOURNAL -->
    <div class="footer-col">
      <h3>RISEON JOURNAL</h3>
      {%- if section.settings.menu_journal.links.size > 0 -%}
        {%- for link in section.settings.menu_journal.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="/pages/size-guide">Find Your Ring Size</a>
        <a href="/blogs/news">Diamond Shape vs Cut</a>
        <a href="/blogs/news">Prong, Bezel or Halo?</a>
        <a href="/blogs/news">Desk-to-Dinner Jewellery</a>
        <a href="/blogs/news">Read a Diamond Report</a>
      {%- endif -%}
    </div>

    <!-- 5. POLICIES -->
    <div class="footer-col">
      <h3>POLICIES</h3>
      {%- if section.settings.menu_policies.links.size > 0 -%}
        {%- for link in section.settings.menu_policies.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="/policies/privacy-policy">Privacy Policy</a>
        <a href="/policies/terms-of-service">Terms of Service</a>
        <a href="/policies/shipping-policy">Shipping Policy</a>
        <a href="/policies/refund-policy">Return &amp; Refund Policy</a>
        <a href="/policies/warranty-policy">Warranty Policy</a>
        <a href="/pages/brand-partner-programme">Partner Terms</a>
      {%- endif -%}
    </div>
  </div>

  <!-- Popular searches bar -->
  <div class="popular">
    <strong>Popular searches</strong>
    <span>{{ section.settings.popular_searches | default: 'Lightweight Gold Jewellery · Laboratory-Grown Diamond Rings · Office-Wear Jewellery for Women · Daily-Wear Diamond Earrings · Gold Pendants for Women · Jewellery Up to ₹24,999' }}</span>
  </div>

  <!-- Legal & Copyright bar -->
  <div class="legal">
    <span>© {{ 'now' | date: '%Y' }} Riseon Jewels. All rights reserved.</span>
    <span>Secure payments · Made with care in India</span>
  </div>
</footer>

{% schema %}
{
  "name": "Footer (Riseon)",
  "class": "footer-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Logo"
    },
    {
      "type": "text",
      "id": "brand_tagline",
      "label": "Brand Tagline",
      "default": "Modern fine jewellery for women rising in their own way."
    },
    {
      "type": "header",
      "content": "Social Links"
    },
    {
      "type": "checkbox",
      "id": "show_instagram",
      "label": "Show Instagram",
      "default": true
    },
    {
      "type": "url",
      "id": "instagram_link",
      "label": "Instagram Link"
    },
    {
      "type": "checkbox",
      "id": "show_youtube",
      "label": "Show YouTube",
      "default": true
    },
    {
      "type": "url",
      "id": "youtube_link",
      "label": "YouTube Link"
    },
    {
      "type": "checkbox",
      "id": "show_facebook",
      "label": "Show Facebook",
      "default": true
    },
    {
      "type": "url",
      "id": "facebook_link",
      "label": "Facebook Link"
    },
    {
      "type": "header",
      "content": "Navigation Menus (Optional overrides)"
    },
    {
      "type": "link_list",
      "id": "menu_shop",
      "label": "Shop Menu"
    },
    {
      "type": "link_list",
      "id": "menu_care",
      "label": "Customer Care Menu"
    },
    {
      "type": "link_list",
      "id": "menu_about",
      "label": "About Menu"
    },
    {
      "type": "link_list",
      "id": "menu_journal",
      "label": "Journal Menu"
    },
    {
      "type": "link_list",
      "id": "menu_policies",
      "label": "Policies Menu"
    },
    {
      "type": "header",
      "content": "Footer Badges & Searches"
    },
    {
      "type": "textarea",
      "id": "popular_searches",
      "label": "Popular Searches Text",
      "default": "Lightweight Gold Jewellery · Laboratory-Grown Diamond Rings · Office-Wear Jewellery for Women · Daily-Wear Diamond Earrings · Gold Pendants for Women · Jewellery Up to ₹24,999"
    }
  ]
}
{% endschema %}
