            { "value": "align-left-bottom", "label": "Left Bottom" },
            { "value": "align-center-top", "label": "Center Top" },
            { "value": "align-center-center", "label": "Center Middle" },
            { "value": "align-center-bottom", "label": "Center Bottom" },
