<section
  class="footer-popular-searches color-{{ section.settings.color_scheme }}"
  style="
    --fps-padding-desktop: {{ section.settings.padding_desktop }};
    --fps-padding-mobile: {{ section.settings.padding_mobile }};
  "
>
  <div class="footer-popular-searches__container container-width">
    {% if section.settings.main_heading != blank %}
      <h2 class="footer-popular-searches__main-heading">
        {{ section.settings.main_heading }}
      </h2>
    {% endif %}

    <div class="footer-popular-searches__list">
      {% for block in section.blocks %}
        {% assign filter_param = block.settings.filter_param | default: section.settings.filter_param %}
        {% assign jewellery_type = block.settings.jewellery_type | strip %}

        <div class="footer-popular-searches__item" {{ block.shopify_attributes }}>
          {% if block.settings.heading != blank %}
            <h3 class="footer-popular-searches__heading">
              {{ block.settings.heading }}
            </h3>
          {% endif %}

          {% if block.settings.collections != blank %}
            <div class="footer-popular-searches__links">
              {% assign rendered_links_count = 0 %}

              {% for selected_collection in block.settings.collections %}
                {% if selected_collection != blank %}
                  {% assign link_label = selected_collection.title %}

                  {% if block.settings.link_label_prefix != blank %}
                    {% capture link_label %}
                      {{ block.settings.link_label_prefix | strip }} {{ selected_collection.title }}
                    {% endcapture %}
                  {% endif %}

                  {% if rendered_links_count > 0 %}
                    <span class="footer-popular-searches__separator">|</span>
                  {% endif %}

                  {% if jewellery_type != blank %}
                    <a
                      href="{{ selected_collection.url }}?{{ filter_param }}={{ jewellery_type | url_encode }}"
                      class="footer-popular-searches__link"
                    >
                      {{ link_label | strip }}
                    </a>
                  {% else %}
                    <a
                      href="{{ selected_collection.url }}"
                      class="footer-popular-searches__link"
                    >
                      {{ link_label | strip }}
                    </a>
                  {% endif %}

                  {% assign rendered_links_count = rendered_links_count | plus: 1 %}
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .footer-popular-searches {
    padding: var(--fps-padding-desktop);
  }

  .footer-popular-searches__main-heading {
    margin: 0 0 18px;
    font-size: 24px;
    font-weight: 700;
  }

  .footer-popular-searches__item {
    margin-bottom: 18px;
  }

  .footer-popular-searches__item:last-child {
    margin-bottom: 0;
  }

  .footer-popular-searches__heading {
    margin: 0 0 6px;
    font-size: 20px;
    font-weight: 600;
  }

  .footer-popular-searches__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .footer-popular-searches__link {
    color: rgb(var(--color-foreground));
    text-decoration: none;
  }

  .footer-popular-searches__link:hover {
    text-decoration: underline;
  }

  .footer-popular-searches__separator {
    color: rgb(var(--color-foreground));
    opacity: 0.7;
  }

  @media screen and (max-width: 768px) {
    .footer-popular-searches__container {
        padding: 0 15px;
    }
    .footer-popular-searches {
      padding: var(--fps-padding-mobile);
    }

    .footer-popular-searches__main-heading {
      font-size: 18px !important;
      margin-bottom: 14px;
    }

    .footer-popular-searches__heading {
      font-size: 16px !important;
      line-height: 1.35;
    }

    .footer-popular-searches__item {
      margin-bottom: 16px;
    }

    .footer-popular-searches__links {
      gap: 5px;
      font-size: 14px;
      line-height: 1.5;
    }
  }
</style>

{% schema %}
{
  "name": "Footer Popular Searches",
  "settings": [
    {
      "type": "text",
      "id": "main_heading",
      "label": "Main heading",
      "default": "Popular Searches"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "filter_param",
      "label": "Default metafield filter parameter",
      "default": "filter.p.m.custom.jewellery_type",
      "info": "Example: filter.p.m.custom.jewellery_type"
    },
    {
      "type": "header",
      "content": "Section Padding Desktop"
    },
    {
      "type": "text",
      "id": "padding_desktop",
      "label": "Padding Desktop",
      "default": "40px 0px 40px 0px",
      "info": "top right bottom left"
    },
    {
      "type": "header",
      "content": "Section Padding Mobile"
    },
    {
      "type": "text",
      "id": "padding_mobile",
      "label": "Padding Mobile",
      "default": "20px 0px 20px 0px",
      "info": "top right bottom left"
    }
  ],
  "blocks": [
    {
      "type": "search_group",
      "name": "Search group",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Group heading",
          "default": "Gold Jewellery"
        },
        {
          "type": "text",
          "id": "jewellery_type",
          "label": "Jewellery type metafield value",
          "default": "Gold",
          "info": "Example: Gold, Silver, Rose Gold. This must exactly match product metafield value."
        },
        {
          "type": "collection_list",
          "id": "collections",
          "label": "Collections",
          "limit": 20
        },
        {
          "type": "text",
          "id": "link_label_prefix",
          "label": "Link label prefix",
          "default": "Gold",
          "info": "Example: Gold. If collection title is Rings, link will show Gold Rings."
        },
        {
          "type": "text",
          "id": "filter_param",
          "label": "Override metafield filter parameter",
          "info": "Optional. Example: filter.p.m.custom.jewellery_type"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer Popular Searches"
    }
  ]
}
{% endschema %}