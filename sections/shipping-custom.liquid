
<section
  class="icon-text-bar img-{{ section.settings.image_align }} text-{{ section.settings.text_align }} color-{{ section.settings.color_scheme }}"
  style="
    --icon-height: {{ section.settings.icon_height }}px;
    --grid-cols-desktop: {{ section.settings.grid_columns_desktop }};
    --grid-cols-mobile: {{ section.settings.grid_columns_mobile }};
  "
>
  <style>
    #shopify-section-{{ section.id }} .icon-text-bar {
      padding: {{ section.settings.padding_desktop }};
    }
    @media (max-width: 768px) {
      #shopify-section-{{ section.id }} .icon-text-bar {
        padding: {{ section.settings.padding_mobile }};
      }
    }
  </style>
  <div class="container_width">
    <div class="icon-text-grid">

      {% for block in section.blocks %}
        {% assign link = block.settings.link | default: '#' %}

        <a href="{{ link }}" class="icon-text-item">

          <div class="icon-wrap">
            {% if block.settings.image %}
              <img
                src="{{ block.settings.image | image_url: width: block.settings.image.width }}"
                alt="{{ block.settings.image.alt | default: block.settings.heading | default: 'Shipping Icon' }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
              >
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'placeholder-icon' }}
            {% endif %}
          </div>

          <div class="text-wrap">
            {% if block.settings.heading != blank %}
              <div class="item-heading">
                      {% render 'heading-style-banner',
          heading: block.settings.heading,
          heading_tag: section.settings.heading_tag,
          heading_style: section.settings.heading_style,
          heading_alignment: section.settings.heading_alignment,
          wrapper_class: 'icon-text-bar'
        %}
              </div>
            {% endif %}

            {% if block.settings.subheading != blank %}
              <p class="item-subheading">{{ block.settings.subheading }}</p>
            {% endif %}
          </div>

        </a>
      {% endfor %}

    </div>
  </div>


</section>

{% schema %}
{
  "name": "Shipping",
  "settings": [
    {
       "type": "header",
       "content": "Layout Settings"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "grid_columns_desktop",
      "label": "Items per row (Desktop)",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "grid_columns_mobile",
      "label": "Items per row (Mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
        {
      "type": "text",
      "id": "padding_desktop",
      "label": "Padding (Desktop)",
      "default": "40px 20px",
      "info": "Values: top right bottom left"
    },
    {
      "type": "text",
      "id": "padding_mobile",
      "label": "Padding (Mobile)",
      "default": "20px 10px",
      "info": "Values: top right bottom left"
    },
    {
       "type": "header",
       "content": "Icon Settings"
    },
    {
      "type": "range",
      "id": "icon_height",
      "label": "Icon Height",
      "min": 20,
      "max": 100,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
       "type": "header",
       "content": "Heading Settings"
    },
     {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading Level (Size)",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h1"
    },
    {
      "type": "header",
      "content": "Alignment Settings"
    },
    {
      "type": "select",
      "id": "image_align",
      "label": "Image Alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Icon Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon / Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Free Delivery"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "On orders over ₹500"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Shipping",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "heading": "Free Delivery",
            "subheading": "For orders over ₹500"
          }
        },
        {
          "type": "item",
          "settings": {
            "heading": "2700+ Collection Points",
            "subheading": "Across India"
          }
        },
        {
          "type": "item",
          "settings": {
            "heading": "Easy Returns",
            "subheading": "At any nearby store"
          }
        },
        {
          "type": "item",
          "settings": {
            "heading": "Fast Delivery",
            "subheading": "To your doorstep"
          }
        }
      ]
    }
  ]
}
{% endschema %}
