

  <section
    class="vertical-story-slider section-{{ section.id }}
      layout-{{ section.settings.media_position }}
      h-{{ section.settings.horizontal_align }}
      color-{{ section.settings.color_scheme }}
      skeleton-container"
       style="
      --section-margin: {{ section.settings.desktop_margin | default: '0px' }};
      --section-margin-mobile: {{ section.settings.mobile_margin | default: '0px' }};
    "
  >
  <div class="skeleton-visible">
    <div style="height: 100vh; display: flex; align-items: center; justify-content: center; background: #000;">
       <div style="display: flex; width: 100%; max-width: 1200px; gap: 40px; padding: 60px; flex-direction: {% if section.settings.media_position == 'right' %}row-reverse{% else %}row{% endif %};">
          <div style="flex: 1; display: flex; justify-content: center;">
             <div class="skeleton-box skeleton-shimmer" style="width: 80%; height: 500px; border-radius: 15px;"></div>
          </div>
          <div style="flex: 1; display: flex; flex-direction: column; justify-content: center;">
             <div class="skeleton-box skeleton-shimmer skeleton-title" style="height: 50px; width: 300px; margin-bottom: 20px;"></div>
             <div class="skeleton-box skeleton-shimmer skeleton-text medium" style="margin-bottom: 30px;"></div>
             <div class="skeleton-box skeleton-shimmer" style="width: 150px; height: 50px; border-radius: 5px;"></div>
          </div>
       </div>
    </div>
  </div>

    {% unless section.settings.background_image %}
      <div class="vertical-slide-placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {% endunless %}

    <div class="swiper verticalSwiper-{{ section.id }}">
      <div class="swiper-wrapper">

        {% for block in section.blocks %}
          <div class="swiper-slide story-slide">
            <div class="story-inner media-width-{{ section.settings.media_width }}">

              <!-- MEDIA -->
              <div class="story-media">
                {% if block.settings.media_type == 'image' %}
                  {% if block.settings.image %}
                    {% assign fetch_priority = 'low' %}
                    {% if section.settings.lazy_load == 'eager' %}
                      {% assign fetch_priority = 'high' %}
                    {% endif %}
                    <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.image.alt }}" loading="{{ section.settings.lazy_load | default: 'lazy' }}" fetchpriority="{{ fetch_priority }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
                  {% else %}
                    {{ 'lifestyle-1' | placeholder_svg_tag }}
                  {% endif %}
                {% else %}
                  {% if block.settings.video %}
                    {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true }}
                  {% else %}
                    <div class="video-placeholder">
                      {{ 'lifestyle-2' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                {% endif %}
              </div>

              <!-- CONTENT -->
              <div class="story-content">
                {% if block.settings.label != blank %}
                  <span class="story-label">{{ block.settings.label }}</span>
                {% endif %}

                <div class="story-heading">
                  {% if block.settings.heading != blank %}
                    {% render 'heading-style-banner',
                      heading: block.settings.heading,
                      heading_tag: section.settings.heading_tag,
                      heading_style: section.settings.heading_style,
                      heading_alignment: section.settings.heading_alignment,
                      wrapper_class: 'vertical-story-slider'
                    %}
                  {% endif %}
                </div>

                {% if block.settings.text != blank %}
                  <div class="story-text">{{ block.settings.text }}</div>
                {% endif %}

                {% if block.settings.button_text != blank %}
                  <a href="{{ block.settings.button_link }}" class="story-btn">
                    {{ block.settings.button_text }}
                  </a>
                {% endif %}
              </div>

            </div>
          </div>
        {% endfor %}

      </div>

      <div class="swiper-pagination"></div>
    </div>
  </section>

  <style>
  .section-{{ section.id }} {
    height: 100vh;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  overflow: visible;
  position: relative;
    {% if section.settings.background_image %}
      background-image: url({{ section.settings.background_image | image_url: width: 2000 }});
    {% endif %}
    margin: var(--section-margin);
  }

  .section-{{ section.id }}::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #000;
    opacity: {{ section.settings.background_overlay_opacity | divided_by: 100.0 }};
    z-index: 1;
  }

  .vertical-slide-placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }
  .vertical-slide-placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

.vertical-story-slider .swiper,
.vertical-story-slider .swiper-wrapper {
  touch-action: pan-y;
}

  .vertical-story-slider .swiper {
    height: 100%;
    position: relative;
    z-index: 2; /* Ensure content is above overlay */
  }

  .story-slide {
    display: flex;
    align-items: center;
  }

  /* ================= CONTAINER WIDTH ================= */
  .section-{{ section.id }} .story-inner {
    margin-left: auto;
    margin-right: auto;
    width: 100%;
  }

{% comment %} Removed old max-width classes in favor of dynamic styles {% endcomment %}

  /* ================= INNER ================= */
  .story-inner {
    display: flex;
    padding: 60px;
    color: #FEFEFE;
  }

  /* Layout */
  .layout-left .story-media { order: 1; }
  .layout-left .story-content { order: 2; }

  .layout-right .story-media { order: 2; }
  .layout-right .story-content { order: 1; }

  /* Media width */
  .media-width-small .story-media { width: 40%; }
  .media-width-small .story-content { width: 60%; }

  .media-width-medium .story-media,
  .media-width-medium .story-content { width: 50%; }

  .media-width-large .story-media { width: 60%; }
  .media-width-large .story-content { width: 40%; }

  /* Media */
  .story-media {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .story-media img,
  .story-media video {
    width: 75%;
    object-fit: cover;
  }

  /* Content */
  .story-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Alignment */
  .v-top .story-content { justify-content: flex-start; }
  .v-middle .story-content { justify-content: center; }
  .v-bottom .story-content { justify-content: flex-end; }

  .h-left .story-content { text-align: left; align-items: flex-start; }
  .h-center .story-content { text-align: center; align-items: center; }
  .h-right .story-content { text-align: right; align-items: flex-end; }

  /* Typography */
  .story-label {
    letter-spacing: 2px;
    opacity: 0.8;
    margin-bottom: 12px;
    color: var(--color-text);
  }

  /* Typography */
  .story-heading {
    color: var(--color-heading);
    margin-bottom: 20px;
    max-width: 550px;
  }

  .story-text {
    color: var(--color-subtext);
    max-width: 550px;
    line-height: 1.7;
    margin-bottom: 30px;
  }

  /* Button */
  .story-btn {
    background: var(--color-button);
    color: var(--color-button-text);
    padding: 12px 26px;
    text-decoration: none;
    border:none !important;
  }

  .story-btn:hover {
    color: var(--color-button-text-hover);
    background: var(--color-button-hover);
  }

  /* Pagination */
  .vertical-story-slider .swiper-pagination-bullets {
    right: 30px;
  }

  .vertical-story-slider .swiper-pagination-bullet {
    background: var(--color-pagination-bullet) !important;
    opacity: 0.5 !important;
  }

  .vertical-story-slider .swiper-pagination-bullet-active {
    background: var(--color-pagination-bullet-active) !important;
    opacity: 1 !important;
  }

  /* ================= MOBILE ================= */
  @media (max-width: 768px) {
    .section-{{ section.id }} {
      height: 100vh;
      margin: var(--section-margin-mobile);
      overflow: visible;
      {% if section.settings.background_image_mobile %}
        background-image: url({{ section.settings.background_image_mobile | image_url: width: 1200 }});
      {% endif %}
    }


    .vertical-story-slider .swiper {
      height: 100%;
    }

    .section-{{ section.id }} .story-inner {
      flex-direction: column;
      padding: 20px 15px;
      justify-content: center;
      height: 100%;
    }

    /* Increase specificity to override desktop media-width classes */
    .section-{{ section.id }} .story-media,
    .section-{{ section.id }} .story-content {
      width: 100% !important; 
      padding: 0;
      order: unset !important; /* Reset layout order for stacking */
    }

    .section-{{ section.id }} .story-media {
      margin-bottom: 20px;
      justify-content: center;
    }
    
    /* Mobile Alignment Overrides */
    .section-{{ section.id }}.h-left .story-content {
      text-align: left;
      align-items: flex-start;
    }
    .section-{{ section.id }}.h-left .story-text {
        margin-left: 0;
        margin-right: auto;
    }

    .section-{{ section.id }}.h-center .story-content {
      text-align: center;
      align-items: center;
    }
    .section-{{ section.id }}.h-center .story-text {
        margin-left: auto;
        margin-right: auto;
    }

    .section-{{ section.id }}.h-right .story-content {
      text-align: right;
      align-items: flex-end;
    }
    .section-{{ section.id }}.h-right .story-text {
        margin-left: auto;
        margin-right: 0;
    }
    
    /* Ensure image is large enough on mobile */
    .section-{{ section.id }} .story-media img,
    .section-{{ section.id }} .story-media video {
      width: 100%; 
      max-height: 350px; 
      object-fit: contain;
    }

    .story-heading {
      margin-bottom: 15px;
    }

    .story-text {
      margin-bottom: 20px;
    }

    .story-btn {
      border-radius: {{ section.settings.button_radius }}px;
    }
  }

  </style>

  <!-- ================= SCRIPT ================= -->
  {% comment %} Swiper is loaded globally in theme.liquid {% endcomment %}
<script>
document.addEventListener('DOMContentLoaded', function () {
  const isMobile = window.matchMedia('(max-width: 768px)').matches;

  new Swiper('.verticalSwiper-{{ section.id }}', {
    direction: 'vertical',
    slidesPerView: 1,
    speed: 700,

    /* 🔥 KEY FIX */
    touchReleaseOnEdges: true,

    /* Desktop scroll */
    mousewheel: !isMobile
      ? {
          enabled: true,
          releaseOnEdges: true,
          forceToAxis: true,
          thresholdDelta: 40,   // 🔥 REQUIRED FOR DESKTOP
      sensitivity: 1
        }
      : false,

    /* Mobile touch must stay enabled */
    allowTouchMove: true,

    pagination: {
      el: '.section-{{ section.id }} .swiper-pagination',
      clickable: true
    }
  });
});
</script>



  {% schema %}
  {
    "name": "Vertical Story Slider",
    "settings": [
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "scheme-1"
      },
      {
        "type": "select",
        "id": "lazy_load",
        "label": "Image Loading",
        "options": [
          { "value": "lazy", "label": "Lazy" },
          { "value": "eager", "label": "Eager" }
        ],
        "default": "lazy"
      },
      { "type": "image_picker", "id": "background_image", "label": "Background Image" },
      { "type": "image_picker", "id": "background_image_mobile", "label": "Background Image (Mobile)" },
      {
        "type": "select",
        "id": "media_position",
        "label": "Media Position",
        "default": "left",
        "options": [
          { "value": "left", "label": "Left" },
          { "value": "right", "label": "Right" }
        ]
      },
      {
        "type": "select",
        "id": "media_width",
        "label": "Media Width",
        "default": "medium",
        "options": [
          { "value": "small", "label": "Small" },
          { "value": "medium", "label": "Medium (50/50)" },
          { "value": "large", "label": "Large" }
        ]
      },
      {
        "type": "select",
        "id": "horizontal_align",
        "label": "Content Horizontal Align",
        "default": "left",
        "options": [
          { "value": "left", "label": "Left" },
          { "value": "center", "label": "Center" },
          { "value": "right", "label": "Right" }
        ]
      },
      {
        "type": "select",
        "id": "heading_tag",
        "label": "Heading Level (Size)",
        "options": [
          { "value": "h1", "label": "H1" },
          { "value": "h2", "label": "H2" },
          { "value": "h3", "label": "H3" },
          { "value": "h4", "label": "H4" },
          { "value": "h5", "label": "H5" },
          { "value": "h6", "label": "H6" }
        ],
        "default": "h1"
      },
      { "type": "text", "id": "desktop_margin", "label": "Margin Desktop (top right bottom left)", "default": "60px 0px 60px 0px" },
      { "type": "text", "id": "mobile_margin", "label": "Margin Mobile (top right bottom left)", "default": "40px 0px 40px 0px" },
      { "type": "range", "id": "background_overlay_opacity", "label": "Background Overlay Opacity", "min": 0, "max": 100, "step": 5, "default": 0 }
    ],
    "blocks": [
      {
        "type": "slide",
        "name": "Slide",
        "settings": [
          {
            "type": "select",
            "id": "media_type",
            "label": "Media Type",
            "default": "image",
            "options": [
              { "value": "image", "label": "Image" },
              { "value": "video", "label": "Video" }
            ]
          },
          { "type": "image_picker", "id": "image", "label": "Image" },
          { "type": "video", "id": "video", "label": "Video" },
          { "type": "text", "id": "label", "label": "Label", "default": "#1" },
          { "type": "text", "id": "heading", "label": "Heading" },
          { "type": "textarea", "id": "text", "label": "Text" },
          { "type": "text", "id": "button_text", "label": "Button Text" },
          { "type": "url", "id": "button_link", "label": "Button Link" }
        ]
      }
    ],
    "presets": [
      {
        "name": "Vertical Story Slider",
        "blocks": [
          {
            "type": "slide",
            "settings": {
              "media_type": "image",
              "label": "NEW ARRIVAL",
              "heading": "Summer Collection",
              "text": "Discover our latest summer styles designed for comfort and elegance.",
              "button_text": "Shop Now"
            }
          },
          {
            "type": "slide",
            "settings": {
              "media_type": "image",
              "label": "BEST SELLER",
              "heading": "Signature Series",
              "text": "Explore our most popular pieces loved by customers worldwide.",
              "button_text": "View Details"
            }
          }
        ]
      }
    ]
  }
  {% endschema %}
