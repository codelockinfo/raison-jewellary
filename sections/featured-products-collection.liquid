<section class="section products-section" id="ProductsSection-{{ section.id }}">
  <div class="section-head section-head-centered">
    <div>
      <span class="eyebrow">{{ section.settings.eyebrow | default: 'THE RISEON EVERYDAY EDIT' }}</span>
      <h2>{{ section.settings.heading | default: 'Shop by Collection' }}</h2>
    </div>
    {%- if section.settings.view_all_text != blank -%}
      <a href="{{ section.settings.collection.url | default: section.settings.view_all_link | default: '/collections/all' }}">
        {{ section.settings.view_all_text | default: 'View all designs →' }}
      </a>
    {%- endif -%}
  </div>

  <div class="product-grid">
    {%- assign featured_collection = section.settings.collection -%}
    {%- if featured_collection != blank and featured_collection.products_count > 0 -%}
      {%- for product in featured_collection.products limit: section.settings.products_to_show -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    {%- else -%}
      <!-- Default reference products matching https://riseon-jewels.r-katariya56.chatgpt.site/jewellery/rings -->
      {% render 'product-card', 
        custom_title: 'Aurelia Arc Ring',
        custom_price: '₹18,999',
        custom_compare_price: '',
        custom_subtitle: 'Gold · Laboratory-Grown Diamond',
        custom_badge: 'NEW',
        custom_tags: 'Everyday Edit · Marquise · Solitaire',
        custom_image: 'https://riseon-jewels.r-katariya56.chatgpt.site/categories/shop-ring-v2.png',
        custom_url: '/collections/ring'
      %}
      {% render 'product-card', 
        custom_title: 'Mira Dewdrop Studs',
        custom_price: '₹24,999',
        custom_compare_price: '',
        custom_subtitle: 'Gold · Laboratory-Grown Diamonds',
        custom_badge: 'BESTSELLER',
        custom_tags: 'Bestseller Edit · Certified · Modern',
        custom_image: 'https://riseon-jewels.r-katariya56.chatgpt.site/categories/shop-earring-v2.png',
        custom_url: '/collections/earring'
      %}
      {% render 'product-card', 
        custom_title: 'Elara Line Bracelet',
        custom_price: '₹48,999',
        custom_compare_price: '',
        custom_subtitle: 'Gold · Laboratory-Grown Diamonds',
        custom_badge: 'OFFICE EDIT',
        custom_tags: 'Office Edit · Refined · Everyday',
        custom_image: 'https://riseon-jewels.r-katariya56.chatgpt.site/categories/shop-bracelet-bangles-v2.png',
        custom_url: '/collections/bracelate-for-her'
      %}
      {% render 'product-card', 
        custom_title: 'Luna Light Pendant',
        custom_price: '₹15,999',
        custom_compare_price: '',
        custom_subtitle: 'Gold · Laboratory-Grown Diamond',
        custom_badge: 'MINIMAL EDIT',
        custom_tags: 'Minimal Edit · Lightweight · Solitaire',
        custom_image: 'https://riseon-jewels.r-katariya56.chatgpt.site/categories/shop-pendant-v2.png',
        custom_url: '/collections/pendant-for-her'
      %}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop by Collection",
  "class": "featured-products-collection-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE RISEON EVERYDAY EDIT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 4,
      "label": "Products to Show",
      "default": 4
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Text",
      "default": "View all designs →"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    }
  ],
  "presets": [
    {
      "name": "Shop by Collection"
    }
  ]
}
{% endschema %}
