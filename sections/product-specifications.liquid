{% comment %}
  Product Specifications Section
  Matching RISEON JEWELS "PRODUCT INFORMATION" box design
{% endcomment %}

<section class="easy-spec-section" id="ProductSpecifications-{{ section.id }}" aria-label="Product specifications and price breakup">
  <div class="easy-spec-panel">
    <div class="easy-spec-panel-head">
      <span>{{ section.settings.heading | default: 'PRODUCT INFORMATION' }}</span>
      {% if section.settings.show_sku %}
        <strong data-spec-sku>
          {% if section.settings.sku_override != blank %}
            {{ section.settings.sku_override }}
          {% else %}
            {{ product.selected_or_first_available_variant.sku | default: 'RI-INA-STACKABLE-BANG-R-7in' }}
          {% endif %}
        </strong>
      {% endif %}
    </div>

    <div class="easy-spec-panel-body">
      {% for block in section.blocks %}
        <article class="easy-spec-group{% if block.type == 'price_breakup' %} easy-price-card{% endif %}" {{ block.shopify_attributes }}>
          {% if block.settings.title != blank %}
            <h2>{{ block.settings.title }}</h2>
          {% endif %}

          {% if block.type == 'price_breakup' %}
            {% if block.settings.description != blank %}
              <div class="easy-pending-copy">{{ block.settings.description }}</div>
            {% endif %}

            {% if block.settings.value_1 != blank or block.settings.value_2 != blank or block.settings.value_3 != blank or block.settings.value_4 != blank or block.settings.value_5 != blank %}
              <div class="easy-breakup-list">
                {% if block.settings.label_1 != blank and block.settings.value_1 != blank %}
                  <div class="easy-breakup-row">
                    <span class="easy-breakup-label">{{ block.settings.label_1 }}</span>
                    <strong class="easy-breakup-val">{{ block.settings.value_1 }}</strong>
                  </div>
                {% endif %}
                {% if block.settings.label_2 != blank and block.settings.value_2 != blank %}
                  <div class="easy-breakup-row">
                    <span class="easy-breakup-label">{{ block.settings.label_2 }}</span>
                    <strong class="easy-breakup-val">{{ block.settings.value_2 }}</strong>
                  </div>
                {% endif %}
                {% if block.settings.label_3 != blank and block.settings.value_3 != blank %}
                  <div class="easy-breakup-row">
                    <span class="easy-breakup-label">{{ block.settings.label_3 }}</span>
                    <strong class="easy-breakup-val">{{ block.settings.value_3 }}</strong>
                  </div>
                {% endif %}
                {% if block.settings.label_4 != blank and block.settings.value_4 != blank %}
                  <div class="easy-breakup-row">
                    <span class="easy-breakup-label">{{ block.settings.label_4 }}</span>
                    <strong class="easy-breakup-val">{{ block.settings.value_4 }}</strong>
                  </div>
                {% endif %}
                {% if block.settings.label_5 != blank and block.settings.value_5 != blank %}
                  <div class="easy-breakup-row is-total">
                    <span class="easy-breakup-label">{{ block.settings.label_5 }}</span>
                    <strong class="easy-breakup-val">{{ block.settings.value_5 }}</strong>
                  </div>
                {% endif %}
              </div>
            {% endif %}

          {% else %}
            {% comment %} Standard Specification Group {% endcomment %}
            <dl>
              {% for i in (1..8) %}
                {% assign label_key = 'label_' | append: i %}
                {% assign val_key = 'value_' | append: i %}
                {% assign row_label = block.settings[label_key] %}
                {% assign row_val = block.settings[val_key] %}

                {% if row_label != blank %}
                  {% assign label_lower = row_label | downcase %}
                  {% assign data_attr = '' %}

                  {% if row_val == blank %}
                    {% if label_lower contains 'product code' or label_lower contains 'sku' %}
                      {% assign row_val = product.selected_or_first_available_variant.sku | default: 'RI-INA-STACKABLE-BANG-R-7in' %}
                      {% assign data_attr = 'data-spec-key="sku"' %}
                    {% elsif label_lower contains 'product type' %}
                      {% assign row_val = product.type | default: 'Bracelet' %}
                    {% elsif label_lower contains 'collection' %}
                      {% assign row_val = product.collections.first.title | default: 'Everyday Edit' %}
                    {% elsif label_lower contains 'purity' %}
                      {% assign data_attr = 'data-spec-key="purity"' %}
                    {% elsif label_lower contains 'colour' or label_lower contains 'color' %}
                      {% assign data_attr = 'data-spec-key="color"' %}
                    {% elsif label_lower contains 'length' or label_lower contains 'size' %}
                      {% assign data_attr = 'data-spec-key="length"' %}
                    {% endif %}
                  {% else %}
                    {% if label_lower contains 'product code' or label_lower contains 'sku' %}
                      {% assign data_attr = 'data-spec-key="sku"' %}
                    {% elsif label_lower contains 'purity' %}
                      {% assign data_attr = 'data-spec-key="purity"' %}
                    {% elsif label_lower contains 'colour' or label_lower contains 'color' %}
                      {% assign data_attr = 'data-spec-key="color"' %}
                    {% elsif label_lower contains 'length' or label_lower contains 'size' %}
                      {% assign data_attr = 'data-spec-key="length"' %}
                    {% endif %}
                  {% endif %}

                  <div>
                    <dt>{{ row_label }}</dt>
                    <dd {{ data_attr }}>{{ row_val }}</dd>
                  </div>
                {% endif %}
              {% endfor %}
            </dl>

            {% if block.settings.content != blank %}
              <div class="easy-pending-copy" style="margin-top: 14px;">{{ block.settings.content }}</div>
            {% endif %}
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>

  {% if section.settings.disclaimer_note != blank %}
    <p class="easy-data-note">{{ section.settings.disclaimer_note }}</p>
  {% endif %}
</section>

<style>
  #ProductSpecifications-{{ section.id }} {
    background: {{ section.settings.section_bg | default: '#fbfaf9' }};
    border-top: 1px solid #eee8e4;
    border-bottom: 1px solid #eee8e4;
    padding-top: {{ section.settings.padding_top | default: 36 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 78 }}px;
    padding-left: 6vw;
    padding-right: 6vw;
  }

  #ProductSpecifications-{{ section.id }} .easy-spec-panel {
    background: {{ section.settings.card_bg | default: '#ffffff' }};
    border: 1px solid {{ section.settings.border_color | default: '#e4dcd8' }};
    border-radius: 4px;
    width: min(1280px, 100%);
    margin: 0 auto;
    overflow: hidden;
    box-shadow: 0 10px 28px rgba(78, 3, 46, 0.035);
  }

  #ProductSpecifications-{{ section.id }} .easy-spec-panel-head {
    background: #fffdfc;
    border-bottom: 1px solid #e8e1dd;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    min-height: 72px;
    padding: 18px 28px;
    display: flex;
  }

  #ProductSpecifications-{{ section.id }} .easy-spec-panel-head span {
    color: {{ section.settings.title_color | default: '#4e032e' }};
    letter-spacing: 0.14em;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
  }

  #ProductSpecifications-{{ section.id }} .easy-spec-panel-head strong {
    color: #746a6e;
    font-size: 13px;
    font-weight: 600;
    font-family: inherit;
  }

  #ProductSpecifications-{{ section.id }} .easy-spec-panel-body {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    display: grid;
  }

  #ProductSpecifications-{{ section.id }} .easy-spec-group {
    padding: 28px 30px 30px;
  }

  #ProductSpecifications-{{ section.id }} .easy-spec-group:nth-child(odd) {
    border-right: 1px solid #e8e1dd;
  }

  #ProductSpecifications-{{ section.id }} .easy-spec-group:nth-child(-n+2) {
    border-bottom: 1px solid #e8e1dd;
  }

  #ProductSpecifications-{{ section.id }} .easy-spec-group h2 {
    color: {{ section.settings.group_title_color | default: '#3a1726' }};
    border-bottom: 1px solid #eee8e4;
    margin: 0 0 16px;
    padding-bottom: 13px;
    font-family: var(--font-heading, 'Cormorant Garamond', Georgia, serif);
    font-size: 27px;
    font-weight: 600;
    line-height: 1.15;
  }

  #ProductSpecifications-{{ section.id }} .easy-spec-group dl {
    margin: 0;
    padding: 0;
  }

  #ProductSpecifications-{{ section.id }} .easy-spec-group dl > div {
    border-bottom: 1px solid #f2eeeb;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    padding: 10px 0;
    display: flex;
  }

  #ProductSpecifications-{{ section.id }} .easy-spec-group dl > div:last-child {
    border-bottom: 0;
  }

  #ProductSpecifications-{{ section.id }} .easy-spec-group dt,
  #ProductSpecifications-{{ section.id }} .easy-spec-group dd {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
  }

  #ProductSpecifications-{{ section.id }} .easy-spec-group dt {
    color: #7b7075;
    font-weight: 400;
    text-align: left;
  }

  #ProductSpecifications-{{ section.id }} .easy-spec-group dd {
    color: #372a30;
    text-align: right;
    font-weight: 600;
  }

  #ProductSpecifications-{{ section.id }} .easy-pending-copy {
    color: #73686d;
    margin: 0;
    font-size: 14px;
    line-height: 1.75;
  }

  #ProductSpecifications-{{ section.id }} .easy-breakup-list {
    margin-top: 14px;
    padding: 0;
  }

  #ProductSpecifications-{{ section.id }} .easy-breakup-row {
    border-bottom: 1px solid #f2eeeb;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 9px 0;
    display: flex;
    font-size: 14px;
  }

  #ProductSpecifications-{{ section.id }} .easy-breakup-row .easy-breakup-label {
    color: #7b7075;
  }

  #ProductSpecifications-{{ section.id }} .easy-breakup-row .easy-breakup-val {
    color: #372a30;
    font-weight: 600;
  }

  #ProductSpecifications-{{ section.id }} .easy-breakup-row.is-total {
    border-top: 1px solid #d9cbc6;
    border-bottom: 0;
    margin-top: 6px;
    padding-top: 13px;
    font-size: 15px;
  }

  #ProductSpecifications-{{ section.id }} .easy-breakup-row.is-total .easy-breakup-label,
  #ProductSpecifications-{{ section.id }} .easy-breakup-row.is-total .easy-breakup-val {
    color: #3a1726;
    font-weight: 700;
  }

  #ProductSpecifications-{{ section.id }} .easy-data-note {
    color: #73686d;
    width: min(1280px, 100%);
    margin: 18px auto 0;
    font-size: 12px;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    #ProductSpecifications-{{ section.id }} {
      padding-top: 36px;
      padding-bottom: 48px;
      padding-left: 16px;
      padding-right: 16px;
    }
    #ProductSpecifications-{{ section.id }} .easy-spec-panel-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
      padding: 17px 20px;
    }
    #ProductSpecifications-{{ section.id }} .easy-spec-panel-body {
      grid-template-columns: 1fr;
    }
    #ProductSpecifications-{{ section.id }} .easy-spec-group {
      padding: 24px 20px;
      border-bottom: 1px solid #e8e1dd !important;
      border-right: 0 !important;
    }
    #ProductSpecifications-{{ section.id }} .easy-spec-group:last-child {
      border-bottom: 0 !important;
    }
    #ProductSpecifications-{{ section.id }} .easy-spec-group h2 {
      font-size: 24px;
    }
  }
</style>

<script>
  (function() {
    window._productVariants = window._productVariants || {{ product.variants | json }};

    function updateSpecDetails(variant) {
      if (!variant) return;

      // Update Header SKU & Row SKU
      if (variant.sku) {
        document.querySelectorAll('[data-spec-sku], [data-spec-key="sku"]').forEach(function(el) {
          el.textContent = variant.sku;
        });
      }

      // Update variant options if present
      if (variant.options && variant.options.length) {
        variant.options.forEach(function(opt) {
          if (!opt) return;
          const optStr = String(opt).trim();
          
          // Purity match: 14K, 18K, 9K, 22K
          if (/^\d{1,2}\s*[kK]$/i.test(optStr) || /karat/i.test(optStr)) {
            document.querySelectorAll('[data-spec-key="purity"]').forEach(function(el) {
              el.textContent = optStr;
            });
          }
          // Colour match: Rose, Yellow, White
          else if (/^(rose|yellow|white|platinum|gold)$/i.test(optStr)) {
            document.querySelectorAll('[data-spec-key="color"]').forEach(function(el) {
              el.textContent = optStr;
            });
          }
          // Length / Size match: 6.5 in, 7 in, 7.5 in, 18 cm
          else if (/\b(in|inch|cm|mm)\b/i.test(optStr) || /^\d+(\.\d+)?\s*(in|cm|mm)?$/i.test(optStr)) {
            document.querySelectorAll('[data-spec-key="length"]').forEach(function(el) {
              el.textContent = optStr;
            });
          }
        });
      }
    }

    // Event listener for variant change
    document.addEventListener('variant:change', function(e) {
      if (e.detail && e.detail.variant) {
        updateSpecDetails(e.detail.variant);
      }
    });

    // Form change event listener
    document.addEventListener('change', function(e) {
      if (e.target && e.target.name === 'id') {
        const val = e.target.value;
        if (window._productVariants) {
          const matched = window._productVariants.find(function(v) { return String(v.id) === String(val); });
          if (matched) updateSpecDetails(matched);
        }
      }
    });
  })();
</script>

