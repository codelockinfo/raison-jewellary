<section class="collection-note" id="CollectionDisclosure-{{ section.id }}" aria-labelledby="collection-disclosure-title-{{ section.id }}">
  {%- if section.settings.eyebrow != blank -%}
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
  {%- endif -%}

  {%- if section.settings.heading != blank -%}
    <h2 id="collection-disclosure-title-{{ section.id }}">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div>
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <article {{ block.shopify_attributes }}>
          <b>{{ block.settings.number | default: forloop.index | prepend: '0' | slice: -2, 2 }}</b>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.description }}</p>
        </article>
      {%- endfor -%}
    {%- else -%}
      <article>
        <b>01</b>
        <h3>Gold purity &amp; weight</h3>
        <p>Karat, net gold weight, hallmark and HUID status shown product-wise.</p>
      </article>

      <article>
        <b>02</b>
        <h3>Diamond information</h3>
        <p>Laboratory-grown origin, shape, carat, colour-clarity and report status.</p>
      </article>

      <article>
        <b>03</b>
        <h3>Transparent price</h3>
        <p>Gold, diamond, making charge and GST breakup before checkout.</p>
      </article>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection Disclosure",
  "class": "collection-disclosure-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "BUY WITH CLARITY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What every Riseon listing will disclose"
    }
  ],
  "blocks": [
    {
      "type": "disclosure_item",
      "name": "Disclosure Card",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Card Number (e.g. 01)",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Gold purity & weight"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Karat, net gold weight, hallmark and HUID status shown product-wise."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Disclosure",
      "blocks": [
        {
          "type": "disclosure_item",
          "settings": {
            "number": "01",
            "title": "Gold purity & weight",
            "description": "Karat, net gold weight, hallmark and HUID status shown product-wise."
          }
        },
        {
          "type": "disclosure_item",
          "settings": {
            "number": "02",
            "title": "Diamond information",
            "description": "Laboratory-grown origin, shape, carat, colour-clarity and report status."
          }
        },
        {
          "type": "disclosure_item",
          "settings": {
            "number": "03",
            "title": "Transparent price",
            "description": "Gold, diamond, making charge and GST breakup before checkout."
          }
        }
      ]
    }
  ]
}
{% endschema %}
