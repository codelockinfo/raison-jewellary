              {% when 'collapsible_tab' %}
                {%- assign tab_content_check = block.settings.content | strip_html | strip -%}
                {%- if tab_content_check != blank or block.settings.page != blank or block.settings.content contains '<img' or block.settings.content contains '<iframe' -%}
                  <div class="product-collapsible-tab" {{ block.shopify_attributes }}>
