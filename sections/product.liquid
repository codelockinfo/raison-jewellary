
<style>
  .product-media-slider .swiper-button-next,
  .product-media-slider .swiper-button-prev {
    background-color: {{ section.settings.arrow_bg_color }};
    color: {{ section.settings.arrow_color }};
    border-radius: {{ section.settings.arrow_border_radius }}%;
  }
  .zoom-button {
    background: {{ section.settings.arrow_bg_color }};
    color: {{ section.settings.arrow_color }};
  }
  .product-item-img {
    {% if section.settings.enable_cursor_zoom %}
      cursor: zoom-in;
    {% endif %}
  }
  .product-media-slider {
    position: relative;
  }
  .product-page-badges-container {
    position: absolute;
    top: 15px;
    left: 15px;
    z-index: 10;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .product-page-badges-container .product-card__badge {
    pointer-events: auto;
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
  }
  .product-details .m-price__badges {
    display: none !important;
  }
  .product-features-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  align-items: stretch;
  margin: 16px 0;
  padding: 0;
  border: 1px solid #E8E4DF;
  border-radius: 4px;
  overflow: hidden;
}

.product-feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  font-size: 12.5px;
  color: #333333;
  line-height: 1.35;
  text-align: center;
  padding: 14px 10px;
  text-decoration: none;
  transition: background 0.2s ease;
  border-right: 1px solid #E8E4DF;
  position: relative;
}

.product-feature-item:last-child {
  border-right: none;
}

a.product-feature-item:hover {
  background: #FAF7F5;
  text-decoration: none;
  color: #4E032A;
}

.product-feature-item img {
  width: 24px;
  height: 24px;
  object-fit: contain;
  display: block;
  flex-shrink: 0;
}

.product-feature-item span {
  display: block;
  font-size: 12.5px;
  color: inherit;
  white-space: normal;
  word-break: break-word;
}

/* Delivery Pincode Block */
.delivery-pincode-block {
  border: 1px solid #E8E4DF;
  border-radius: 4px;
  padding: 14px 16px;
  margin: 12px 0;
}

.delivery-pincode-block__label {
  font-size: 12px;
  font-weight: 700;
  color: #777777;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 10px;
  display: block;
}

.delivery-pincode-block__form {
  display: flex;
  gap: 0;
  align-items: stretch;
  border: 1px solid #CCCCCC;
  border-radius: 2px;
  overflow: hidden;
}

.delivery-pincode-block__input {
  flex: 1;
  border: none;
  outline: none;
  padding: 10px 12px;
  font-size: 14px;
  color: #333333;
  background: #FFFFFF;
  min-width: 0;
  font-family: inherit;
}

.delivery-pincode-block__input::placeholder {
  color: #AAAAAA;
  font-size: 14px;
}

.delivery-pincode-block__btn {
  background: #FFFFFF;
  border: none;
  border-left: 1px solid #CCCCCC;
  padding: 10px 18px;
  font-size: 13.5px;
  font-weight: 600;
  color: #4E032A;
  cursor: pointer;
  letter-spacing: 0.02em;
  transition: background 0.2s ease, color 0.2s ease;
  white-space: nowrap;
  font-family: inherit;
}

.delivery-pincode-block__btn:hover {
  background: #4E032A;
  color: #FFFFFF;
}

.delivery-pincode-block__result {
  margin-top: 8px;
  font-size: 13px;
  line-height: 1.5;
  min-height: 0;
}

.delivery-pincode-block__result.is-success {
  color: #2D7A4F;
}

.delivery-pincode-block__result.is-error {
  color: #C0392B;
}

.delivery-pincode-block__result.is-loading {
  color: #777777;
}

.product-feature-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  color: #111;
  line-height: 1.3;
  white-space: nowrap;
  text-decoration: none;
  transition: opacity 0.2s ease;
}

a.product-feature-item:hover {
  opacity: 0.75;
  text-decoration: underline;
}

.product-feature-item img {
  width: 24px;
  height: 24px;
  object-fit: contain;
}
.color-swatches .swatch {
  position: relative;
  display: inline-flex;
  cursor: pointer;
}

.color-swatches .swatch input {
  display: none;
}

.color-circle {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  display: block;
  border: 1px solid #ddd;
}

.color-swatches .swatch input:checked + .color-circle {
  border: 2px solid #000;
  box-shadow: 0 0 0 2px #FEFEFE, 0 0 0 3px #000;
}

.text-swatches .swatch input {
  display: none;
}
.product-rating {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: -20px 0 -10px;
  font-size: 14px;
  color: #111;
}

.product-rating__stars {
  position: relative;
  display: inline-block;
  font-size: 18px;
  line-height: 1;
  letter-spacing: 2px;
  color: #d6d6d6;
}

.product-rating__stars-filled {
  position: absolute;
  top: 0;
  left: 0;
  width: var(--rating-percent);
  overflow: hidden;
  white-space: nowrap;
  color: #f5a623;
}

.product-rating__value {
  font-weight: 600;
}

.product-rating__count {
  color: #666;
}

.product-rating--empty {
  color: #777;
}
@media (min-width: 769px) {
  {% comment %} .product-gallery {
    position: sticky;
    top: 90px;
    align-self: start !important;
    height: auto !important;
    margin-top: 0 !important;
  } {% endcomment %}
  .product-gallery {
    position: static !important;
    top: auto !important;
    margin-top: 0 !important;
  }
}

@media (max-width: 768px) {
  .product-gallery.thumbnail-layout-left {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  
  .product-gallery.thumbnail-layout-left .thumbnails {
    order: 2;
    flex-direction: row;
    width: 100%;
    max-height: none;
    overflow-x: auto;
    overflow-y: hidden;
    margin-top: 0;
  }
  
  .product-gallery.thumbnail-layout-left .product-media-slider {
    order: 1;
    width: 100%;
  }
  
  .product-gallery.thumbnail-layout-left .thumb {
    width: 70px;
    min-width: 70px;
    flex-shrink: 0;
  }
}
@media (max-width: 510px) {
  .product-features-row {
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }
  .product-feature-item {
    white-space: normal;
    font-size: 11px;
    padding: 10px 6px;
  }
}

@media (max-width: 350px) {
  .product-features-row {
    grid-template-columns: 1fr;
  }
  .product-feature-item {
    border-right: none;
    border-bottom: 1px solid #E8E4DF;
  }
  .product-feature-item:last-child {
    border-bottom: none;
  }
}
</style>

{% if section.settings.show_breadcrumbs %}
  <div class="product-breadcrumbs-wrapper">
    {% render 'breadcrumbs' %}
  </div>
{% endif %}

<div class="product-page skeleton-container">
  <!-- SKELETON: GALLERY -->
  <div class="skeleton-visible product-gallery thumbnail-layout-{{ section.settings.thumbnail_layout }}">
    {% if section.settings.show_thumbnails and section.settings.thumbnail_layout == 'left' %}
       <div class="thumbnails">
          {% for i in (1..4) %}
            <div class="skeleton-box skeleton-shimmer" style="width: 80px; aspect-ratio: 2/3; border-radius: 8px;"></div>
          {% endfor %}
       </div>
    {% endif %}
    <div style="flex: 1; min-width: 0;">
       <div class="skeleton-box skeleton-shimmer" style="width: 100%; aspect-ratio: 2/3; border-radius: 14px;"></div>
         {% if section.settings.show_thumbnails and section.settings.thumbnail_layout == 'bottom' %}
         <div class="thumbnails">
            {% for i in (1..4) %}
              <div class="skeleton-box skeleton-shimmer" style="width: 100px; aspect-ratio: 2/3; border-radius: 8px;"></div>
            {% endfor %}
         </div>
       {% endif %}
       {% for block in section.blocks %}
         {% if block.type == 'certification' %}
           <div class="skeleton-box skeleton-shimmer" style="width: 100%; height: 95px; margin-top: 14px; border-radius: 4px;"></div>
         {% endif %}
       {% endfor %}
    </div>
  </div>

  <!-- SKELETON: INFO -->
  <div class="skeleton-visible product-details-info">
    {% for block in section.blocks %}
      {% if block.type == 'certification' %}{% continue %}{% endif %}
      <div class="main-product__block main-product__block-{{ block.type }}">
        {% case block.type %}
          {% when 'title' %}
            <div class="skeleton-box skeleton-shimmer skeleton-title" style="height: 48px; width: 90%;"></div>
{% when 'rating' %}
  {% liquid
    assign rating_obj = product.metafields.custom.product_rating.value
    assign rating_count = product.metafields.custom.product_rating_count.value | default: 0
  %}

  {% if rating_obj != blank %}
    {% liquid
      assign rating_value = rating_obj.rating | default: rating_obj
      assign rating_max = rating_obj.scale_max | default: 5
      assign rating_percent = rating_value | times: 100 | divided_by: rating_max
    %}

    <div class="product-rating" {{ block.shopify_attributes }}>
      <div
        class="product-rating__stars"
        aria-label="{{ rating_value }} out of {{ rating_max }} stars"
      >
        <span class="product-rating__stars-empty">★★★★★</span>
        <span
          class="product-rating__stars-filled"
          style="--rating-percent: {{ rating_percent }}%;"
        >
          ★★★★★
        </span>
      </div>

      <span class="product-rating__value">
        {{ rating_value | round: 1 }}
      </span>
    </div>

  {% elsif block.settings.show_empty_rating %}
    <div class="product-rating product-rating--empty" {{ block.shopify_attributes }}>
      No reviews yet
    </div>
  {% endif %}
          {% when 'price' %}
            <div class="skeleton-box skeleton-shimmer skeleton-text" style="width: 30%; height: 32px;"></div>
          {% when 'variants' %}
            <div class="variant-group">
               <div class="skeleton-box skeleton-shimmer skeleton-text medium" style="margin-bottom: 15px; width: 100px;"></div>
               <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                  {% for i in (1..5) %}
                     <div class="skeleton-box skeleton-shimmer" style="width: 44px; height: 44px; border-radius: 50%;"></div>
                  {% endfor %}
               </div>
            </div>
          {% when 'quantity' %}
            <div class="qty-wrapper" style="display: flex; gap: 15px; align-items: center;">
               <div class="skeleton-box skeleton-shimmer" style="width: 140px; height: 44px; border-radius: 0;"></div>
               <div class="skeleton-box skeleton-shimmer" style="flex: 1; height: 50px; border-radius: 10px;"></div>
            </div>
          {% when 'buttons' %}
            <div class="skeleton-box skeleton-shimmer" style="width: 100%; height: 50px; border-radius: 10px;"></div>
          {% when 'collapsible_tab' or 'description' %}
            <div class="skeleton-box skeleton-shimmer" style="width: 100%; height: 50px; border-radius: 4px;"></div>
          {% when 'wishlist' %}
             <div class="skeleton-box skeleton-shimmer" style="width: 44px; height: 44px; border-radius: 50%;"></div>
            {% when 'icon_text_row' %}
              <div class="product-features-row" {{ block.shopify_attributes }}>
                {% if block.settings.icon_1 != blank or block.settings.text_1 != blank %}
                  {% if block.settings.link_1 != blank %}
                    <a href="{{ block.settings.link_1 }}" class="product-feature-item">
                  {% else %}
                    <div class="product-feature-item">
                  {% endif %}
                    {% if block.settings.icon_1 != blank %}
                      <img src="{{ block.settings.icon_1 | image_url: width: 60 }}" alt="{{ block.settings.text_1 | escape }}" width="24" height="24" loading="lazy">
                    {% endif %}
                    <span>{{ block.settings.text_1 }}</span>
                  {% if block.settings.link_1 != blank %}
                    </a>
                  {% else %}
                    </div>
                  {% endif %}
                {% endif %}

                {% if block.settings.icon_2 != blank or block.settings.text_2 != blank %}
                  {% if block.settings.link_2 != blank %}
                    <a href="{{ block.settings.link_2 }}" class="product-feature-item">
                  {% else %}
                    <div class="product-feature-item">
                  {% endif %}
                    {% if block.settings.icon_2 != blank %}
                      <img src="{{ block.settings.icon_2 | image_url: width: 60 }}" alt="{{ block.settings.text_2 | escape }}" width="24" height="24" loading="lazy">
                    {% endif %}
                    <span>{{ block.settings.text_2 }}</span>
                  {% if block.settings.link_2 != blank %}
                    </a>
                  {% else %}
                    </div>
                  {% endif %}
                {% endif %}

                {% if block.settings.icon_3 != blank or block.settings.text_3 != blank %}
                  {% if block.settings.link_3 != blank %}
                    <a href="{{ block.settings.link_3 }}" class="product-feature-item">
                  {% else %}
                    <div class="product-feature-item">
                  {% endif %}
                    {% if block.settings.icon_3 != blank %}
                      <img src="{{ block.settings.icon_3 | image_url: width: 60 }}" alt="{{ block.settings.text_3 | escape }}" width="24" height="24" loading="lazy">
                    {% endif %}
                    <span>{{ block.settings.text_3 }}</span>
                  {% if block.settings.link_3 != blank %}
                    </a>
                  {% else %}
                    </div>
                  {% endif %}
                {% endif %}
              </div>
        {% endcase %}
      </div>
    {% endfor %}
  </div>
  <div class="product-gallery thumbnail-layout-{{ section.settings.thumbnail_layout }}">
      {% if section.settings.show_thumbnails and section.settings.thumbnail_layout == 'left' %}
        <div class="thumbnails">
          {% for media in product.media %}
            {% if media.media_type == 'image' %}
              <img src="{{ media | image_url: width: 150 }}"
                class="thumb {% if forloop.index == 1 %}active{% endif %}"
                data-media-id="{{ media.id }}"
                data-index="{{ forloop.index0 }}"
                alt="{{ media.alt | default: product.title | escape }}"
                width="150"
                height="{{ 150 | divided_by: media.aspect_ratio | round }}"
              >
            {% elsif media.media_type == 'video' or media.media_type == 'external_video' %}
              <img
                src="{{ media.preview_image | image_url: width: 150 }}"
                class="thumb video-thumb {% if forloop.index == 1 %}active{% endif %}"
                data-media-id="{{ media.id }}"
                data-index="{{ forloop.index0 }}"
                alt="{{ media.preview_image.alt | default: product.title | escape }}"
                width="150"
                height="{{ 150 | divided_by: media.preview_image.aspect_ratio | round }}"
              >
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      <div class="swiper product-media-slider">
        <!-- Badges for Product Gallery -->
        <div class="product-page-badges-container">
           {%- assign current_v = product.selected_or_first_available_variant -%}
           <span class="product-card__badge product-card__badge--sold-out" style="display: {% if current_v.available %}none{% else %}inline-block{% endif %}; background-color: {{ settings.badge_sold_out_background_color | default: '#000000' }}; color: {{ settings.badge_sold_out_text_color | default: '#FEFEFE' }}; border-radius: {{ settings.badge_corner_radius | default: 4 }}px;">
             {{ settings.badge_sold_out_text | default: 'Sold Out' }}
           </span>
           <span class="product-card__badge product-card__badge--sale" style="display: {% if current_v.compare_at_price > current_v.price %}inline-block{% else %}none{% endif %}; background-color: {{ settings.badge_color | default: settings.badge_sale_background_color | default: '#ff0000' }}; color: {{ settings.badge_text_color | default: settings.badge_sale_text_color | default: '#FEFEFE' }}; border-radius: {{ settings.badge_corner_radius | default: 4 }}px;">
             {% if current_v.compare_at_price > current_v.price %}
               SAVE {{ current_v.compare_at_price | minus: current_v.price | times: 100 | divided_by: current_v.compare_at_price | round }}%
             {% else %}
               {% if settings.badge_sale_text != blank %}{{ settings.badge_sale_text }}{% else %}Sale{% endif %}
             {% endif %}
           </span>
        </div>
        <div class="swiper-wrapper">
          {% for media in product.media %}
            <div class="swiper-slide" data-media-id="{{ media.id }}">
              {% if media.media_type == 'image' %}
                <img
                  src="{{ media | image_url: width: 900 }}"
                  class="product-item-img"
                  alt="{{ media.alt | default: product.title }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  {% if forloop.first %}fetchpriority="high"{% endif %}
                  width="{{ media.width }}"
                  height="{{ media.height }}"
                >
              {% elsif media.media_type == 'video' %}
                  {{ media | video_tag: autoplay: false, loop: true, muted: true, controls: true, playsinline: true, class: 'product-item-video' }}
              {% elsif media.media_type == 'external_video' %}
                <div class="product-item-video">
                  {{ media | external_video_tag }}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
        <!-- Add Navigation -->
        {% if section.settings.show_arrows %}
          <div class="swiper-button-prev">{% render 'icon-slider-nav', direction: 'prev' %}</div>
          <div class="swiper-button-next">{% render 'icon-slider-nav', direction: 'next' %}</div>
        {% endif %}

        {% if section.settings.enable_zoom %}
          <button class="zoom-button" aria-label="Zoom Image">
            <span>Zoom in</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              <line x1="11" y1="8" x2="11" y2="14"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
          </button>
        {% endif %}
      </div>

      {% if section.settings.show_thumbnails and section.settings.thumbnail_layout == 'bottom' %}
        <div class="thumbnails">
          {% for media in product.media %}
            {% if media.media_type == 'image' %}
              <img
                src="{{ media | image_url: width: 150 }}"
                class="thumb {% if forloop.index == 1 %}active{% endif %}"
                data-media-id="{{ media.id }}"
                data-index="{{ forloop.index0 }}"
                alt="{{ media.alt | default: product.title | escape }}"
                width="150"
                height="{{ 150 | divided_by: media.aspect_ratio | round }}"
                loading="lazy"
              >
            {% elsif media.media_type == 'video' or media.media_type == 'external_video' %}
              <img
                src="{{ media.preview_image | image_url: width: 150 }}"
                class="thumb video-thumb {% if forloop.index == 1 %}active{% endif %}"
                data-media-id="{{ media.id }}"
                data-index="{{ forloop.index0 }}"
                alt="{{ media.preview_image.alt | default: product.title | escape }}"
                width="150"
                height="{{ 150 | divided_by: media.preview_image.aspect_ratio | round }}"
                loading="lazy"
              >
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      {%- for block in section.blocks -%}
        {%- if block.type == 'certification' -%}
          <section class="easy-gallery-cert" aria-label="Diamond certification and gold hallmarking" {{ block.shopify_attributes }}>
            <div class="easy-gallery-cert-head">
              <span>{{ block.settings.heading | default: 'CERTIFICATION & HALLMARKING' }}</span>
              {% if block.settings.subtext != blank %}
                <small>{{ block.settings.subtext }}</small>
              {% endif %}
            </div>
            <div class="easy-gallery-cert-grid">
              {% if block.settings.title_1 != blank %}
                <article>
                  <span class="easy-lab-logo">
                    {% if block.settings.image_1 != blank %}
                      <img src="{{ block.settings.image_1 | image_url: width: 200 }}" alt="{{ block.settings.title_1 | escape }}" width="82" height="58" loading="lazy">
                    {% else %}
                      <img src="{{ 'igi-logo.png' | asset_url }}" alt="{{ block.settings.title_1 | escape }}" width="82" height="58" loading="lazy">
                    {% endif %}
                  </span>
                  <div>
                    <strong>{{ block.settings.title_1 }}</strong>
                    {% if block.settings.subtext_1 != blank %}<small>{{ block.settings.subtext_1 }}</small>{% endif %}
                  </div>
                </article>
              {% endif %}

              {% if block.settings.title_2 != blank %}
                <article>
                  <span class="easy-lab-logo">
                    {% if block.settings.image_2 != blank %}
                      <img src="{{ block.settings.image_2 | image_url: width: 200 }}" alt="{{ block.settings.title_2 | escape }}" width="82" height="58" loading="lazy">
                    {% else %}
                      <img src="{{ 'sgl-logo.png' | asset_url }}" alt="{{ block.settings.title_2 | escape }}" width="82" height="58" loading="lazy">
                    {% endif %}
                  </span>
                  <div>
                    <strong>{{ block.settings.title_2 }}</strong>
                    {% if block.settings.subtext_2 != blank %}<small>{{ block.settings.subtext_2 }}</small>{% endif %}
                  </div>
                </article>
              {% endif %}

              {% if block.settings.title_3 != blank %}
                <article>
                  <span class="easy-lab-logo bis-logo">
                    {% if block.settings.image_3 != blank %}
                      <img src="{{ block.settings.image_3 | image_url: width: 200 }}" alt="{{ block.settings.title_3 | escape }}" width="82" height="58" loading="lazy">
                    {% else %}
                      <img src="{{ 'bis-logo.png' | asset_url }}" alt="{{ block.settings.title_3 | escape }}" width="82" height="58" loading="lazy">
                    {% endif %}
                  </span>
                  <div>
                    <strong>{{ block.settings.title_3 }}</strong>
                    {% if block.settings.subtext_3 != blank %}<small>{{ block.settings.subtext_3 }}</small>{% endif %}
                  </div>
                </article>
              {% endif %}

              {% if block.settings.title_4 != blank %}
                <article>
                  <span class="easy-lab-logo">
                    {% if block.settings.image_4 != blank %}
                      <img src="{{ block.settings.image_4 | image_url: width: 200 }}" alt="{{ block.settings.title_4 | escape }}" width="82" height="58" loading="lazy">
                    {% endif %}
                  </span>
                  <div>
                    <strong>{{ block.settings.title_4 }}</strong>
                    {% if block.settings.subtext_4 != blank %}<small>{{ block.settings.subtext_4 }}</small>{% endif %}
                  </div>
                </article>
              {% endif %}
            </div>
          </section>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="product-details-info">
      {% form 'product', product, id: "product-form" %}
        <input
          type="hidden"
          name="id"
          value="{{ product.selected_or_first_available_variant.id }}"
    data-variant-input
        >


        <div class="product-details">
          {% for block in section.blocks %}
            {% if block.type == 'certification' %}{% continue %}{% endif %}
         <div
      class="main-product__block main-product__block-{{ block.type }}"
      {{ block.shopify_attributes }}
    >
              {% case block.type %}

                {% when 'title' %}
            <div class="product-title-row" {{ block.shopify_attributes }}>
              <h1 class="product-title">
                {{ product.title }}
              </h1>

            {% for wblock in section.blocks %}
              {% if wblock.type == 'wishlist' and wblock.settings.show_next_to_title %}
                <div class="wishlist-next-title">
                  {% render 'wishlist-button', product: product %}
                </div>
              {% endif %}
            {% endfor %}
            </div>
            {% when 'rating' %}
  {% liquid
    assign rating_obj = product.metafields.custom.product_rating.value
    assign rating_count = product.metafields.custom.product_rating_count.value | default: 0
  %}

  {% if rating_obj != blank %}
    {% liquid
      assign rating_value = rating_obj.rating | default: rating_obj
      assign rating_max = rating_obj.scale_max | default: 5
      assign rating_percent = rating_value | times: 100 | divided_by: rating_max
    %}

    <div class="product-rating" {{ block.shopify_attributes }}>
      <div
        class="product-rating__stars"
        aria-label="{{ rating_value }} out of {{ rating_max }} stars"
      >
        <span class="product-rating__stars-empty">★★★★★</span>
        <span
          class="product-rating__stars-filled"
          style="--rating-percent: {{ rating_percent }}%;"
        >
          ★★★★★
        </span>
      </div>

      <span class="product-rating__value">
        {{ rating_value | round: 1 }}
      </span>
    </div>

  {% elsif block.settings.show_empty_rating %}
    <div class="product-rating product-rating--empty" {{ block.shopify_attributes }}>
      No reviews yet
    </div>
  {% endif %}

             {%- when 'price' -%}
          <div class="product-block-group--price">
            {% render 'product-prices',
              use_variant: true,
              product: product,
              show_sale_badge: block.settings.show_saving,
              price_text_size: 'm:text-xl md:m:text-2xl',
              sale_badge_type: block.settings.sale_badge_type
            %}
          </div>

         {% when 'inventory' %}
    {% if settings.enable_inventory_message %}
      {% assign v = product.selected_or_first_available_variant %}

      <div
        class="inventory-notice"
        data-qty="{{ v.inventory_quantity }}"
