<!-- Ask a Question Modal -->
<div id="AskQuestionModal" class="custom-popup-modal">
  <div class="modal-overlay"></div>
  <div class="modal-container">
    <button class="modal-close" aria-label="Close">&times;</button>
    <div class="modal-header">
      <h2>Ask a Question</h2>
    </div>
    <div class="modal-content">
      {% form 'contact', id: 'contact-form-ask' %}
        <input type="hidden" name="contact[product]" value="{{ product.title }}">
        <input type="hidden" name="contact[product url]" value="{{ shop.url }}{{ product.url }}">
        <input type="hidden" name="return_to" value="{{ product.url }}?contact_posted=true">

        <style>
          .send-button {
            cursor: pointer !important;
          }
        </style>

        {% if form.posted_successfully? %}
          <script>
            document.addEventListener('DOMContentLoaded', () => {
              if (typeof window.showToast === 'function') {
                window.showToast('{{ 'contact.form.post_success' | t | default: 'Message sent successfully!' }}', 'success');
              }
              // Clear URL parameter so toast doesn't fire on refresh
              if (window.location.search.includes('contact_posted=true')) {
                const url = new URL(window.location.href);
                url.searchParams.delete('contact_posted');
                window.history.replaceState({} , '', url.pathname + url.search + url.hash);
              }
            });
          </script>

          <script>
            // Prepare product data for DataLayer
            var productData = {
              item_id: {{ product.id | json }},
              item_name: {{ product.title | json }},
              item_brand: {{ product.vendor | json }},
              item_category: {{ product.type | json }},
              price: {{ product.price | money_without_currency | json }},
              url: {{ shop.url | append: product.url | json }}
            };

            // Push to dataLayer
            window.dataLayer = window.dataLayer || [];
            dataLayer.push({
              event: 'Ask a Question',
              product_data: {
                products: [productData]
              }
            });
          </script>
        {% endif %}

        {{ form.errors | default_errors }}
        <div class="form-grid">
          <div class="field">
            <label for="ContactFormName" class="visually-hidden">Your name</label>
            <input type="text" name="contact[name]" id="ContactFormName" placeholder="Your name*" required>
          </div>
          <div class="field">
            <label for="ContactFormPhone" class="visually-hidden">Your phone number</label>
            <input type="tel" name="contact[phone]" id="ContactFormPhone" placeholder="Your phone number">
          </div>
        </div>
        <div class="field">
          <label for="ContactFormEmail" class="visually-hidden">Your email</label>
          <input type="email" name="contact[email]" id="ContactFormEmail" placeholder="Your email*" required autocorrect="off">
        </div>
        <div class="field" style="margin-bottom: 0;">
          <label for="ContactFormMessage" class="visually-hidden">Your message</label>
          <textarea rows="4" name="contact[body]" id="ContactFormMessage" placeholder="Your message*" required></textarea>
        </div>
        <p class="form-info">* Required fields cannot be left blank.</p>
        <button type="submit" class="primary-btn full-width send-button" aria-label="Send Your Message">Send Your Message</button>
      {% endform %}
    </div>
  </div>
</div>

<!-- Share Modal -->
<div id="ShareModal" class="custom-popup-modal">
  <div class="modal-overlay"></div>
  <div class="modal-container">
    <button class="modal-close" aria-label="Close">&times;</button>
    <div class="modal-header">
      <h2>Copy link</h2>
    </div>
    <div class="modal-content">
      <div class="share-copy-field">
        <input type="text" value="{{ shop.url }}{{ product.url }}" readonly id="ShareLinkInput">
        <button class="copy-btn-icon" aria-label="Copy link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
        </button>
      </div>
      <div class="share-socials">
        <p>Share:</p>
        <div class="social-icons">
          <a href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url }}{{ product.url }}" target="_blank">
            <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3l-.5 3h-2.5v6.8c4.56-.93 8-4.96 8-9.8z"/></svg>
          </a>
          <a href="https://twitter.com/intent/tweet?text={{ product.title }}&url={{ shop.url }}{{ product.url }}" target="_blank">
            <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="https://pinterest.com/pin/create/button/?url={{ shop.url }}{{ product.url }}&media={{ product.featured_media | image_url: width: 1000 }}&description={{ product.title }}" target="_blank">
            <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.966 1.406-5.966s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.654 2.568-.994 3.993-.284 1.194.593 2.167 1.769 2.167 2.124 0 3.756-2.241 3.756-5.476 0-2.861-2.056-4.86-4.991-4.86-3.399 0-5.395 2.549-5.395 5.184 0 1.027.395 2.127.889 2.726a.455.455 0 0 1 .11.419c-.041.17-.131.53-.15.608-.025.105-.081.127-.188.077-1.054-.491-1.711-2.031-1.711-3.268 0-3.66 2.661-7.02 7.671-7.02 4.027 0 7.157 2.87 7.157 6.707 0 4.001-2.522 7.218-6.023 7.218-1.176 0-2.281-.611-2.659-1.332l-.723 2.752c-.262 1.006-1.011 2.227-1.503 3.024A12.01 12.01 0 0 0 12 24c6.621 0 12-5.378 12-12S18.621 0 12.017 0z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
</div>

<!-- Sticky Add to Cart Bar -->
{% if section.settings.show_sticky_cart %}
<div id="sticky-cart-bar" class="sticky-cart-bar">
  <div class="sticky-cart-content container_width">
    <div class="sticky-cart-left">
      <img class="sticky-cart-img" src="{{ product.featured_image | image_url: width: 100 }}" alt="{{ product.title | escape }}" width="100" height="100">
      <div class="sticky-cart-info">
        <h3 class="sticky-cart-title">{{ product.title }}</h3>
        <div class="sticky-cart-price">
          {% render 'product-prices', product: product, use_variant: true, show_sale_badge: false %}
        </div>
      </div>
    </div>
    <div class="sticky-cart-right">
      <button id="sticky-add-to-cart" class="sticky-cart-btn">
        Add to Cart
      </button>
    </div>
  </div>
</div>
{% endif %}

<script>
document.addEventListener('DOMContentLoaded', function () {
  const thumbs = document.querySelectorAll('.thumb');
  const variantInput = document.querySelector('input[name="id"]');
  const priceContainer = document.querySelector('.m-price');
  const regularPriceEl = priceContainer ? priceContainer.querySelector('.m-price-item--regular') : null;
  const saleWrapper = priceContainer ? priceContainer.querySelector('.m-price__sale') : null;
  const regularWrapper = priceContainer ? priceContainer.querySelector('.m-price__regular') : null;
  const salePriceEl = priceContainer ? priceContainer.querySelector('.m-price-item--sale') : null;
  const comparePriceEl = priceContainer ? priceContainer.querySelector('.m-price-item--compare') : null;
  const unitPriceWrapper = priceContainer ? priceContainer.querySelector('.m-price__unit') : null;
  const variants = {{ product.variants | json }};
  let swiper;

  if (typeof Swiper !== 'undefined') {
      swiper = new Swiper('.product-media-slider', {
        slidesPerView: 1,
        spaceBetween: 10,
        autoHeight: false,
        observer: true,
        observeParents: true,
        navigation: {
          nextEl: '.swiper-button-next',
          prevEl: '.swiper-button-prev',
        },
      on: {
        slideChange: function () {
          const index = this.activeIndex;
          thumbs.forEach(t => t.classList.remove('active'));
          if (thumbs[index]) thumbs[index].classList.add('active');

          // Toggle zoom button for video slides
          const zoomBtn = document.querySelector('.zoom-button');
          if (zoomBtn) {
            const activeSlide = this.slides[index];
            const isVideo = activeSlide.querySelector('video') || activeSlide.querySelector('iframe');
            zoomBtn.style.display = isVideo ? 'none' : 'flex';
          }
        }
      }
    });
  }

    // Update Swiper height when images load
    document.querySelectorAll('.product-item-img').forEach(img => {
      img.addEventListener('load', () => {
        if (swiper) swiper.update();
      });
    });

  // Zoom Functionality
  const zoomBtn = document.querySelector('.zoom-button');
  const zoomModal = document.getElementById('ProductZoomModal');
  const closeZoom = document.querySelector('.zoom-close');
  const zoomInBtn = document.querySelector('.zoom-in-btn');
  const zoomOutBtn = document.querySelector('.zoom-out-btn');
  let zoomSwiper;
  let currentScale = 1;

  if (zoomBtn && zoomModal) {
    if (typeof Swiper !== 'undefined') {
      zoomSwiper = new Swiper('.product-zoom-slider', {
        slidesPerView: 1,
        spaceBetween: 30,
        navigation: {
          nextEl: '.zoom-next',
          prevEl: '.zoom-prev',
        },
      });
    }

    zoomBtn.addEventListener('click', () => {
      const activeIndex = swiper ? swiper.activeIndex : 0;
      if (zoomSwiper) {
        zoomSwiper.slideTo(activeIndex, 0);
      }
      zoomModal.classList.add('active');
      document.body.style.overflow = 'hidden';
      currentScale = 1;
      updateZoom();
    });

    closeZoom.addEventListener('click', () => {
      zoomModal.classList.remove('active');
      document.body.style.overflow = '';
      if (swiper && zoomSwiper) {
        swiper.slideTo(zoomSwiper.activeIndex, 0);
      }
    });

    zoomInBtn.addEventListener('click', () => {
      currentScale += 0.5;
      updateZoom();
    });

    zoomOutBtn.addEventListener('click', () => {
      if (currentScale > 1) {
        currentScale -= 0.5;
        updateZoom();
      }
    });

    function updateZoom() {
      const activeImg = document.querySelector('.product-zoom-slider .swiper-slide-active img');
      if (activeImg) {
        activeImg.style.transform = `scale(${currentScale})`;
      }
    }

    // Hide zoom buttons as requested
    if(zoomInBtn) zoomInBtn.style.display = 'none';
    if(zoomOutBtn) zoomOutBtn.style.display = 'none';

    // Modal close on background click
    zoomModal.addEventListener('click', (e) => {
      if (e.target === zoomModal || e.target.classList.contains('zoom-modal-content')) closeZoom.click();
    });
  }

    thumbs.forEach(thumb => {
    thumb.addEventListener('click', () => {
      const index = parseInt(thumb.dataset.index);
      if (swiper) {
        swiper.slideTo(index);
      }
      thumbs.forEach(t => t.classList.remove('active'));
      thumb.classList.add('active');
    });
  });

  // Modal Click-to-Zoom & Pan Logic
  const zoomContainers = document.querySelectorAll('.zoom-image-container');
  zoomContainers.forEach(container => {
    container.style.cursor = 'zoom-in'; // Explicitly set starting cursor

    container.addEventListener('click', function(e) {
      if (currentScale === 1) {
        currentScale = 1.2; 
        this.style.cursor = 'zoom-out';
      } else {
        currentScale = 1;
        this.style.cursor = 'zoom-in';
      }
      updateZoom();
    });
  });

  // Update variant
  
  function updateSelectedSummary(selectedOptions) {
    const summaryBoxes = document.querySelectorAll('[data-variant-summary]');
    const form = document.querySelector('#product-form');
    if (!summaryBoxes.length || !form) return;

    summaryBoxes.forEach(box => {
      const template = box.getAttribute('data-template') || 'Selected: [purity] [color] Gold · Bracelet length [length]';
      let purityVal = '';
      let colorVal = '';
      let lengthVal = '';

      const groups = form.querySelectorAll('.variant-group');
      groups.forEach((g, idx) => {
        const optName = (g.getAttribute('data-option-name') || '').toLowerCase();
        const checked = g.querySelector('input:checked');
        const val = checked ? checked.value : (selectedOptions[idx] || '');

        if (optName.includes('purity') || optName.includes('karat') || optName.includes('kt')) {
          purityVal = val;
        } else if (optName.includes('color') || optName.includes('colour')) {
          colorVal = val;
        } else if (optName.includes('length') || optName.includes('size')) {
          lengthVal = val;
        }
      });

      if (!purityVal && selectedOptions[0]) purityVal = selectedOptions[0];
      if (!colorVal && selectedOptions[1]) colorVal = selectedOptions[1];
      if (!lengthVal && selectedOptions[2]) lengthVal = selectedOptions[2];

      let result = template;
      result = result.replace(/\[purity\]|\{purity\}/gi, purityVal);
      result = result.replace(/\[colou?r\]|\{colou?r\}/gi, colorVal);
      result = result.replace(/\[(length|size)\]|\{(length|size)\}/gi, lengthVal);

      selectedOptions.forEach((optVal, i) => {
        const reg = new RegExp(`\\\[option${i + 1}\\\]|\\{option${i + 1}\\}`, 'gi');
        result = result.replace(reg, optVal);
      });

      const prefixEl = box.querySelector('.summary-prefix');
      const textEl = box.querySelector('.summary-dynamic-text');

      if (prefixEl && textEl) {
        const prefixMatch = result.match(/^(Selected:?)\s*(.*)$/i);
        if (prefixMatch) {
          prefixEl.textContent = prefixMatch[1];
          textEl.textContent = prefixMatch[2];
        } else {
          prefixEl.textContent = '';
          textEl.textContent = result;
        }
      } else {
        box.textContent = result;
      }
    });
  }

  function updatePurityAvailability(selectedOptions) {
    const form = document.querySelector('#product-form');
    if (!form || typeof variants === 'undefined') return;
    const purityGroup = form.querySelector('.variant-group[data-option-type="purity"]');
    if (!purityGroup) return;

    const purityIndex = parseInt(purityGroup.getAttribute('data-option-index'), 10);
    const otherSelected = [...selectedOptions];

    purityGroup.querySelectorAll('.variant-option-label').forEach(label => {
      const input = label.querySelector('input');
      if (!input) return;
      const purityVal = input.value;
      const testOptions = [...otherSelected];
      testOptions[purityIndex] = purityVal;

      const matchingVar = variants.find(v =>
        v.options.every((o, i) => o === testOptions[i])
      );

      const statusEl = label.querySelector('.variant-card__status');
      const cardEl = label.querySelector('.variant-card--purity');
      if (statusEl) {
        const availableText = statusEl.getAttribute('data-available-text') || 'Available';
        const pendingText = statusEl.getAttribute('data-pending-text') || 'Pending';

        if (matchingVar && matchingVar.available) {
          statusEl.textContent = availableText;
          statusEl.className = 'variant-card__status status--available';
          if (cardEl) cardEl.classList.remove('is-pending');
        } else {
          statusEl.textContent = pendingText;
          statusEl.className = 'variant-card__status status--pending';
          if (cardEl && !input.checked) cardEl.classList.add('is-pending');
        }
      }
    });
  }

  function updateVariant() {
    const form = document.querySelector('#product-form');
    if (!form) return;
    
    const galleryBadgeSoldOut = document.querySelector('.product-page-badges-container .product-card__badge--sold-out');
    const galleryBadgeSale = document.querySelector('.product-page-badges-container .product-card__badge--sale');

    const selected = [];
    form.querySelectorAll('.variant-group').forEach(g => {
      const c = g.querySelector('input:checked');
      if (c) {
        selected.push(c.value);
        const valSpan = g.querySelector('.variant-selected-value');
        if(valSpan) valSpan.textContent = c.value;
      }
    });

    const match = variants.find(v =>
      v.options.every((o, i) => o === selected[i])
    );

    updateSelectedSummary(selected);
    updatePurityAvailability(selected);

    // Custom Money Formatter
    function formatMoney(cents, format) {
      if (typeof cents == 'string') { cents = cents.replace('.', ''); }
      let value = '';
      const placeholderRegex = /\{\{\s*(\w+)\s*\}\}/;
      const formatString = format || window.Shopify.money_format || "{{ shop.money_format }}";
      
      function defaultOption(opt, def) {
         return (typeof opt == 'undefined' ? def : opt);
      }
      
      function formatWithDelimiters(number, precision, thousands, decimal) {
        precision = defaultOption(precision, 2);
        thousands = defaultOption(thousands, ',');
        decimal   = defaultOption(decimal, '.');
        
        if (isNaN(number) || number == null) { return 0; }
        
        number = (number/100.0).toFixed(precision);
        
        var parts   = number.split('.'),
            dollars = parts[0].replace(/(\d)(?=(\d{3})+(?!\d))/g, '$1' + thousands),
            cents   = parts[1] ? (decimal + parts[1]) : '';
        
        return dollars + cents;
      }
      
      switch(formatString.match(placeholderRegex)[1]) {
        case 'amount':
          value = formatWithDelimiters(cents, 2);
          break;
        case 'amount_no_decimals':
          value = formatWithDelimiters(cents, 0);
          break;
        case 'amount_with_comma_separator':
          value = formatWithDelimiters(cents, 2, '.', ',');
          break;
        case 'amount_no_decimals_with_comma_separator':
          value = formatWithDelimiters(cents, 0, '.', ',');
          break;
      }
      
      return formatString.replace(placeholderRegex, value);
    }

    if (match) {
      variantInput.value = match.id;

      // Update Add to Cart Button
      const addToCartBtn = form.querySelector('[data-add-to-cart]');
      const stickyAddToCartBtn = document.getElementById('sticky-add-to-cart');
      
      if (addToCartBtn) {
        const btnText = addToCartBtn.querySelector('.add-to-cart-button__text');
        if (match.available) {
          addToCartBtn.disabled = false;
          addToCartBtn.removeAttribute('aria-disabled');
          if (btnText) btnText.textContent = "Add to Cart";
        } else {
          addToCartBtn.disabled = true;
          addToCartBtn.setAttribute('aria-disabled', 'true');
          if (btnText) btnText.textContent = "Sold Out";
        }
      }

      if (stickyAddToCartBtn) {
        if (match.available) {
          stickyAddToCartBtn.disabled = false;
          stickyAddToCartBtn.textContent = "Add to Cart";
        } else {
          stickyAddToCartBtn.disabled = true;
          stickyAddToCartBtn.textContent = "Sold Out";
        }
      }

      // Update gallery badges
      if(galleryBadgeSoldOut) {
          galleryBadgeSoldOut.style.display = match.available ? 'none' : 'inline-block';
      }
      if(galleryBadgeSale) {
          if (match.compare_at_price > match.price) {
              const savePercent = Math.round(((match.compare_at_price - match.price) / match.compare_at_price) * 100);
              galleryBadgeSale.textContent = `SAVE ${savePercent}%`;
              galleryBadgeSale.style.display = 'inline-block';
          } else {
              galleryBadgeSale.style.display = 'none';
          }
      }
      
      const allPriceContainers = document.querySelectorAll('.m-price');
      allPriceContainers.forEach(priceContainer => {
          const regularPriceEl = priceContainer.querySelector('.m-price-item--regular');
          const saleWrapper = priceContainer.querySelector('.m-price__sale');
          const regularWrapper = priceContainer.querySelector('.m-price__regular');
          const salePriceEl = priceContainer.querySelector('.m-price-item--sale');
          const comparePriceEl = priceContainer.querySelector('.m-price-item--compare');
          const unitPriceWrapper = priceContainer.querySelector('.m-price__unit');

          if (match.compare_at_price > match.price) {
            priceContainer.classList.add('m-price--on-sale');
            if(saleWrapper) {
                saleWrapper.style.display = 'flex';
                if(salePriceEl) salePriceEl.innerHTML = formatMoney(match.price, "{{ shop.money_format }}");
                if(comparePriceEl) comparePriceEl.innerHTML = formatMoney(match.compare_at_price, "{{ shop.money_format }}");
            }
            if(regularWrapper) regularWrapper.style.display = 'none';
          } else {
            priceContainer.classList.remove('m-price--on-sale');
            if(saleWrapper) saleWrapper.style.display = 'none';
            if(regularWrapper) {
                regularWrapper.style.display = 'block';
                if(regularPriceEl) regularPriceEl.innerHTML = formatMoney(match.price, "{{ shop.money_format }}");
            }
          }

          // Update Unit Price
          if (match.unit_price_measurement) {
              const unitPriceText = formatMoney(match.unit_price, "{{ shop.money_format }}");
              const referenceValue = match.unit_price_measurement.reference_value;
              const referenceUnit = match.unit_price_measurement.reference_unit;
              const html = `<span>${unitPriceText}</span> / <span>${referenceValue} ${referenceUnit}</span>`;
              
              if (!unitPriceWrapper) {
                  const newDiv = document.createElement('div');
                  newDiv.className = 'm-price__unit';
                  newDiv.innerHTML = html;
                  priceContainer.appendChild(newDiv);
              } else {
                  unitPriceWrapper.style.display = 'block';
                  unitPriceWrapper.innerHTML = html;
              }
          } else {
              if(unitPriceWrapper) unitPriceWrapper.style.display = 'none';
          }
      });

    if (match.featured_media && swiper) {
  const position = match.featured_media.position - 1; // Swiper is 0 index
  swiper.slideTo(position);
}

      // Dispatch event to update inventory notice and other listeners
      document.dispatchEvent(new CustomEvent('variant:change', {
        detail: { variant: match }
      }));

    } else {
      // Handle Unavailable
      if(galleryBadgeSoldOut) galleryBadgeSoldOut.style.display = 'none';
      if(galleryBadgeSale) galleryBadgeSale.style.display = 'none';

      const addToCartBtn = form.querySelector('[data-add-to-cart]');
      const stickyAddToCartBtn = document.getElementById('sticky-add-to-cart');
      if (addToCartBtn) {
        addToCartBtn.disabled = true;
        addToCartBtn.setAttribute('aria-disabled', 'true');
        const btnText = addToCartBtn.querySelector('.add-to-cart-button__text');
        if (btnText) btnText.textContent = "Unavailable";
      }
      if (stickyAddToCartBtn) {
        stickyAddToCartBtn.disabled = true;
        stickyAddToCartBtn.textContent = "Unavailable";
      }
    }
  }

  document.querySelectorAll('.variant-group input').forEach(r =>
    r.addEventListener('change', updateVariant)
  );

  // Initial variant state & summary sync
  updateVariant();

  const stickyBtn = document.getElementById('sticky-add-to-cart');
  const stickyCart = document.getElementById('sticky-cart-bar');
  const mainAddToCart = document.querySelector('[data-add-to-cart]');
  const mainQtyInput = document.querySelector('[data-quantity-selector-input]');
  const stickyQtyInput = document.querySelector('[data-sticky-quantity-input]');

  if (stickyBtn) {
    stickyBtn.addEventListener('click', () => {
      const form = document.getElementById('product-form');
      if (form) {
        const mainAddToCartBtn = form.querySelector('[data-add-to-cart]');
        if (mainAddToCartBtn) {
          mainAddToCartBtn.click();
        } else {
          form.requestSubmit();
        }
      }
    });
  }

  if (stickyCart && mainAddToCart) {
    window.addEventListener('scroll', () => {
      const rect = mainAddToCart.getBoundingClientRect();
      if (rect.bottom < 0) {
        stickyCart.classList.add('active');
      } else {
        stickyCart.classList.remove('active');
      }
    });
  }

  // Sync Quantity
  if (mainQtyInput && stickyQtyInput) {
    mainQtyInput.addEventListener('change', () => {
      stickyQtyInput.value = mainQtyInput.value;
    });
    stickyQtyInput.addEventListener('change', () => {
      mainQtyInput.value = stickyQtyInput.value;
    });
    
    document.addEventListener('click', (e) => {
        if (e.target.closest('[data-sticky-quantity-decrease]') || e.target.closest('[data-sticky-quantity-increase]')) {
            setTimeout(() => {
                mainQtyInput.value = stickyQtyInput.value;
                mainQtyInput.dispatchEvent(new Event('change'));
            }, 10);
        }
        if (e.target.closest('[data-quantity-selector-button]')) {
             setTimeout(() => {
                stickyQtyInput.value = mainQtyInput.value;
                stickyQtyInput.dispatchEvent(new Event('change'));
            }, 10);
        }
    });
  }

  document.querySelectorAll('.tab-header').forEach(header => {
    header.addEventListener('click', () => {
      const item = header.parentElement;
      const content = item.querySelector('.tab-content');
      const isActive = item.classList.contains('active');
      
      if (isActive) {
        item.classList.remove('active');
        content.style.maxHeight = '0';
        header.setAttribute('aria-expanded', 'false');
      } else {
        item.classList.add('active');
        content.style.maxHeight = content.scrollHeight + 'px';
        header.setAttribute('aria-expanded', 'true');
      }
    });
  });

  {% if section.settings.enable_cursor_zoom %}
  // Image Zoom on Hover (Cursor Move)
  const productImages = document.querySelectorAll('.product-item-img');
  
  if (window.matchMedia('(min-width: 1025px)').matches) {
      productImages.forEach(img => {
        img.addEventListener('mousemove', function(e) {
          const { left, top, width, height } = this.getBoundingClientRect();
          const x = ((e.clientX - left) / width) * 100;
          const y = ((e.clientY - top) / height) * 100;
          
          this.style.transformOrigin = `${x}% ${y}%`;
          this.style.transform = 'scale(2)';
        });
        
        img.addEventListener('mouseleave', function() {
          this.style.transform = 'scale(1)';
          this.style.transformOrigin = 'center';
        });
      });
  }
  {% endif %}
  // Custom Modals Logic (Ask Question & Share)
  function setupModal(triggerSelector, modalId) {
    const trigger = document.querySelector(triggerSelector);
    const modal = document.getElementById(modalId);
    if (!trigger || !modal) return;

    const overlay = modal.querySelector('.modal-overlay');
    const closeBtn = modal.querySelector('.modal-close');

    trigger.addEventListener('click', () => {
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
    });

    const closeModal = () => {
      modal.classList.remove('active');
      document.body.style.overflow = '';
    };

    closeBtn.addEventListener('click', closeModal);
    overlay.addEventListener('click', closeModal);
  }

  setupModal('.ask-question-trigger', 'AskQuestionModal');
  setupModal('.share-trigger', 'ShareModal');

  // Share Copy functionality
  const copyBtn = document.querySelector('.copy-btn-icon');
  const shareInput = document.getElementById('ShareLinkInput');
  if (copyBtn && shareInput) {
    copyBtn.addEventListener('click', () => {
      shareInput.select();
      document.execCommand('copy');
      
      const originalSvg = copyBtn.innerHTML;
      copyBtn.style.width = 'auto';
      copyBtn.style.padding = '0 10px';
      copyBtn.innerHTML = '<span style="font-size:12px; color:white;">Copied!</span>';
      setTimeout(() => {
        copyBtn.innerHTML = originalSvg;
        copyBtn.style.width = '';
        copyBtn.style.padding = '';
      }, 2000);
    });
  }

  // Terms & Conditions enforcement for the product page
  const productTermsCheck = document.querySelector('.product-details-info [data-terms-checkbox]');
  const buyNowWrapper = document.querySelector('.button_area');

  if (productTermsCheck) {
    const handleBuyNowClick = (e) => {
      if (!productTermsCheck.checked) {
        productTermsCheck.reportValidity();
        e.stopPropagation();
        e.stopImmediatePropagation();
        e.preventDefault();
      }
    };

    if (buyNowWrapper) {
      // Use capture phase to intercept the click before Shopify Dynamic Checkout scripts
      buyNowWrapper.addEventListener('click', handleBuyNowClick, true);
    }

    // Ensure buttons are always visually enabled
    const enableProductButtons = () => {
      const buyNowContainer = document.querySelector('.button_area .shopify-payment-button');
      if (buyNowContainer) {
        buyNowContainer.style.pointerEvents = 'auto';
        buyNowContainer.style.opacity = '1';
        const innerBtn = buyNowContainer.querySelector('button');
        if (innerBtn) innerBtn.removeAttribute('disabled');
      }
    };

    enableProductButtons();
    window.addEventListener('pageshow', enableProductButtons);
    document.addEventListener('shopify:payment_button:loaded', enableProductButtons);
    const buyNowObserver = new MutationObserver(enableProductButtons);
    if (buyNowWrapper) buyNowObserver.observe(buyNowWrapper, { childList: true, subtree: true });
    setTimeout(enableProductButtons, 1000);
    setTimeout(enableProductButtons, 3000);
  }

  // ─── Delivery Pincode Checker ────────────────────────────────────────
  document.querySelectorAll('[data-pincode-check-btn]').forEach(function(btn) {
    var inputId   = btn.dataset.inputId;
    var resultId  = btn.dataset.resultId;
    var successMsg = btn.dataset.successMsg;
    var errorMsg   = btn.dataset.errorMsg;
    var invalidMsg = btn.dataset.invalidMsg;

    var input  = document.getElementById(inputId);
    var result = document.getElementById(resultId);

    if (!input || !result) return;

    // Read serviceable pincodes from the data attribute (rendered from block settings)
    var serviceableAttr = btn.closest('[data-pincode-block]').dataset.serviceablePincodes;
    var serviceablePincodes = [];
    if (serviceableAttr && serviceableAttr.trim() !== '') {
      serviceablePincodes = serviceableAttr.split(/[\n,]+/).map(function(p){ return p.trim(); }).filter(Boolean);
    }

    function showResult(msg, type) {
      result.textContent = msg;
      result.className = 'delivery-pincode-block__result is-' + type;
    }

    function doCheck() {
      var pincode = input.value.replace(/\D/g, '').trim();
      if (!pincode || pincode.length !== 6) {
        showResult(invalidMsg || 'Please enter a valid 6-digit pincode', 'error');
        return;
      }
      // If no whitelist, all pincodes are deliverable
      if (serviceablePincodes.length === 0) {
        showResult(successMsg, 'success');
      } else if (serviceablePincodes.indexOf(pincode) !== -1) {
        showResult(successMsg, 'success');
      } else {
        showResult(errorMsg, 'error');
      }
    }

    btn.addEventListener('click', doCheck);
    input.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') doCheck();
    });
    // Only allow numeric input
    input.addEventListener('input', function() {
      this.value = this.value.replace(/\D/g, '').slice(0, 6);
      result.textContent = '';
      result.className = 'delivery-pincode-block__result';
    });
  });
});
</script>

