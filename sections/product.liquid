        data-hide-backorder="{{ settings.hide_backorder_notice }}"
        data-show-progress="{{ settings.show_inventory_progress }}"
        data-progress-max="{{ settings.inventory_progress_max }}"
        {{ block.shopify_attributes }}
      >
        <div class="inventory-text"></div>

        {% if settings.show_inventory_progress and v.inventory_quantity > 0 %}
    <div class="inventory-progress">
      <span class="inventory-progress-bar"></span>
    </div>
  {% endif %}

      </div>
    {% endif %}
            {% when 'description' %}
              {%- assign description_check = product.description | strip_html | strip -%}
              {% if description_check != blank or product.description contains '<img' or product.description contains '<iframe' %}
                {% assign is_accordion = block.settings.as_accordion %}
                {% if block.settings.as_accordion == nil %}
                  {% assign is_accordion = true %}
                {% endif %}

                {% if is_accordion %}
                  {%- assign accordion_title = block.settings.heading | default: 'Description' -%}
                  <div class="product-collapsible-tab description-tab" {{ block.shopify_attributes }}>
                    <details class="smooth-details">
                      <summary class="tab-header" aria-label="{{ accordion_title | escape }}">
                        <span>{{ accordion_title }}</span>
                        <svg width="12" height="12" viewBox="0 0 10 10" fill="none">
                          <path d="M1 3.5L5 7.5L9 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </summary>
                      <div class="smooth-collapsible">
                        <div class="tab-content smooth-collapsible-inner">
                          <div class="tab-content-inner">
                            {{ product.description }}
                          </div>
                        </div>
                      </div>
                    </details>
                  </div>
                {% else %}
                  <div class="product-description-direct" {{ block.shopify_attributes }}>
                    {% if block.settings.heading != blank %}
                      <h3 class="product-description-title">{{ block.settings.heading }}</h3>
                    {% endif %}
                    <div class="product-description-content">
                      {{ product.description }}
                    </div>
                  </div>
                {% endif %}
              {% endif %}
                {% when 'variants' %}
              <div class="product-variants-wrapper" {{ block.shopify_attributes }}>
                {% unless product.has_only_default_variant %}
                  {% for option in product.options_with_values %}
                    {% liquid
                      assign opt_name_downcase = option.name | downcase
                      assign is_purity = false
                      assign is_colour = false

                      if opt_name_downcase contains 'purity' or opt_name_downcase contains 'karat' or opt_name_downcase contains 'kt'
                        assign is_purity = true
                      elsif opt_name_downcase contains 'color' or opt_name_downcase contains 'colour'
                        assign is_colour = true
                      endif

                      # Determine step title
                      if opt_name_downcase contains 'choose'
                        assign step_title = option.name
                      elsif is_purity
                        if opt_name_downcase contains 'gold'
                          assign step_title = 'Choose ' | append: option.name | downcase
                        else
                          assign step_title = 'Choose gold purity'
                        endif
                      elsif is_colour
                        if opt_name_downcase contains 'gold'
                          assign step_title = 'Choose ' | append: option.name | downcase
                        else
                          assign step_title = 'Choose gold colour'
                        endif
                      elsif opt_name_downcase contains 'length' or opt_name_downcase contains 'size'
                        assign step_title = 'Choose ' | append: option.name | downcase
                      else
                        assign step_title = 'Choose ' | append: option.name | downcase
                      endif
                    %}

                    <div 
                      class="variant-group" 
                      data-option-index="{{ forloop.index0 }}"
                      data-option-name="{{ option.name | escape }}"
                      data-option-type="{% if is_purity %}purity{% elsif is_colour %}colour{% else %}standard{% endif %}"
                    >
                      <div class="variant-step-header">
                        <span class="variant-step-badge">{{ forloop.index }}</span>
                        <h3 class="variant-step-title">{{ step_title }}</h3>
                      </div>

                      <div class="variant-options-grid">
                        {% for value in option.values %}
                          {% liquid
                            assign is_val_available = false
                            for v in product.variants
                              if v.options contains value and v.available
                                assign is_val_available = true
                                break
                              endif
                            endfor
                          %}

                          <label class="variant-option-label">
                            <input
                              type="radio"
                              name="options[{{ option.name | escape }}]"
                              value="{{ value | escape }}"
                              class="variant-option-input"
                              {% if option.selected_value == value %}checked{% endif %}
                            >

                            {% if is_purity %}
                              <div class="variant-card variant-card--purity{% unless is_val_available or option.selected_value == value %} is-pending{% endunless %}">
                                <div class="variant-card__val">{{ value }}</div>
                                <div 
                                  class="variant-card__status {% if is_val_available or option.selected_value == value %}status--available{% else %}status--pending{% endif %}"
                                  data-available-text="{{ block.settings.available_badge_text | default: 'Available' }}"
                                  data-pending-text="{{ block.settings.pending_badge_text | default: 'Pending' }}"
                                >
                                  {% if is_val_available or option.selected_value == value %}
                                    {{ block.settings.available_badge_text | default: 'Available' }}
                                  {% else %}
                                    {{ block.settings.pending_badge_text | default: 'Pending' }}
                                  {% endif %}
                                </div>
                              </div>

                            {% elsif is_colour %}
                              {% liquid
                                assign v_lower = value | downcase
                                assign ring_color = '#C69A3D'
                                assign dot_color = '#D4AF37'
                                
                                if v_lower contains 'rose'
                                  assign ring_color = '#B76E79'
                                  assign dot_color = '#C88A83'
                                elsif v_lower contains 'white' or v_lower contains 'silver'
                                  assign ring_color = '#CCCCCC'
                                  assign dot_color = '#C0C0C0'
                                elsif v_lower contains 'yellow' or v_lower contains 'gold'
                                  assign ring_color = '#C69A3D'
                                  assign dot_color = '#D4AF37'
                                elsif v_lower contains 'platinum'
                                  assign ring_color = '#B0B0B0'
                                  assign dot_color = '#D8D8D8'
                                elsif v_lower contains 'black'
                                  assign ring_color = '#333333'
                                  assign dot_color = '#111111'
                                endif
                              %}
                              <div class="variant-card variant-card--colour">
                                <span class="colour-radio-ring" style="--swatch-ring: {{ ring_color }};">
                                  <span class="colour-radio-dot" style="--swatch-dot: {{ dot_color }};"></span>
                                </span>
                                <span class="colour-card__name">{{ value }}</span>
                              </div>

                            {% else %}
                              <div class="variant-card variant-card--standard">
                                <span class="standard-card__val">{{ value }}</span>
                              </div>
                            {% endif %}
                          </label>
                        {% endfor %}
                      </div>
                    </div>
                  {% endfor %}

                  {% liquid
                    assign template_str = block.settings.selected_text_template | default: 'Selected: [purity] [color] Gold · Bracelet length [length]'
                    
                    assign initial_purity = ''
                    assign initial_color = ''
                    assign initial_length = ''

                    for opt in product.options_with_values
                      assign opt_name_l = opt.name | downcase
                      if opt_name_l contains 'purity' or opt_name_l contains 'karat' or opt_name_l contains 'kt'
                        assign initial_purity = opt.selected_value
                      elsif opt_name_l contains 'color' or opt_name_l contains 'colour'
                        assign initial_color = opt.selected_value
                      elsif opt_name_l contains 'length' or opt_name_l contains 'size'
                        assign initial_length = opt.selected_value
                      endif
                    endfor

                    if initial_purity == blank and product.options_with_values.size > 0
                      assign initial_purity = product.options_with_values[0].selected_value
                    endif
                    if initial_color == blank and product.options_with_values.size > 1
                      assign initial_color = product.options_with_values[1].selected_value
                    endif
                    if initial_length == blank and product.options_with_values.size > 2
                      assign initial_length = product.options_with_values[2].selected_value
                    endif

                    assign initial_rendered = template_str | replace: '[purity]', initial_purity | replace: '{purity}', initial_purity
                    assign initial_rendered = initial_rendered | replace: '[color]', initial_color | replace: '[colour]', initial_color | replace: '{color}', initial_color | replace: '{colour}', initial_color
                    assign initial_rendered = initial_rendered | replace: '[length]', initial_length | replace: '[size]', initial_length | replace: '{length}', initial_length | replace: '{size}', initial_length

                    for opt in product.options_with_values
                      assign opt_placeholder = '[option' | append: forloop.index | append: ']'
                      assign opt_placeholder_brace = '{option' | append: forloop.index | append: '}'
                      assign initial_rendered = initial_rendered | replace: opt_placeholder, opt.selected_value | replace: opt_placeholder_brace, opt.selected_value
                    endfor

                    assign prefix_text = 'Selected:'
                    assign dynamic_text = initial_rendered

                    if initial_rendered contains 'Selected:'
                      assign parts = initial_rendered | split: 'Selected:'
                      assign prefix_text = 'Selected:'
                      assign dynamic_text = parts[1] | strip
                    endif
                  %}

                  <div 
                    class="variant-selected-summary-box" 
                    data-variant-summary 
                    data-template="{{ template_str | escape }}"
                  >
                    <span class="summary-prefix">{{ prefix_text }}</span>
                    <span class="summary-dynamic-text">{{ dynamic_text }}</span>
                  </div>
                {% endunless %}
              </div>


            {% when 'quantity' %}
              <div class="qty-wrapper" {{ block.shopify_attributes }}>
                {% render 'quantity-input', 
                    value: 1, 
                    min: 1,
                    data_attributes: 'data-quantity-selector-input',
