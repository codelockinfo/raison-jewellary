    {% endfor %}
  </div>
  <div class="product-gallery thumbnail-layout-{{ section.settings.thumbnail_layout }}">
      {% if section.settings.show_thumbnails and section.settings.thumbnail_layout == 'left' %}
        <div class="thumbnails">
          {% for media in product.media %}
            {% if media.media_type == 'image' %}
              <img src="{{ media | image_url: width: 150 }}"
                class="thumb {% if forloop.index == 1 %}active{% endif %}"
                data-media-id="{{ media.id }}"
                data-index="{{ forloop.index0 }}"
                alt="{{ media.alt | default: product.title | escape }}"
                width="150"
                height="{{ 150 | divided_by: media.aspect_ratio | round }}"
              >
            {% elsif media.media_type == 'video' or media.media_type == 'external_video' %}
              <img
                src="{{ media.preview_image | image_url: width: 150 }}"
                class="thumb video-thumb {% if forloop.index == 1 %}active{% endif %}"
                data-media-id="{{ media.id }}"
                data-index="{{ forloop.index0 }}"
                alt="{{ media.preview_image.alt | default: product.title | escape }}"
                width="150"
                height="{{ 150 | divided_by: media.preview_image.aspect_ratio | round }}"
              >
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      <div class="swiper product-media-slider">
        <!-- Badges for Product Gallery -->
        <div class="product-page-badges-container">
           {%- assign current_v = product.selected_or_first_available_variant -%}
           <span class="product-card__badge product-card__badge--sold-out" style="display: {% if current_v.available %}none{% else %}inline-block{% endif %}; background-color: {{ settings.badge_sold_out_background_color | default: '#000000' }}; color: {{ settings.badge_sold_out_text_color | default: '#FEFEFE' }}; border-radius: {{ settings.badge_corner_radius | default: 4 }}px;">
             {{ settings.badge_sold_out_text | default: 'Sold Out' }}
           </span>
           <span class="product-card__badge product-card__badge--sale" style="display: {% if current_v.compare_at_price > current_v.price %}inline-block{% else %}none{% endif %}; background-color: {{ settings.badge_color | default: settings.badge_sale_background_color | default: '#ff0000' }}; color: {{ settings.badge_text_color | default: settings.badge_sale_text_color | default: '#FEFEFE' }}; border-radius: {{ settings.badge_corner_radius | default: 4 }}px;">
             {% if current_v.compare_at_price > current_v.price %}
               SAVE {{ current_v.compare_at_price | minus: current_v.price | times: 100 | divided_by: current_v.compare_at_price | round }}%
             {% else %}
               {% if settings.badge_sale_text != blank %}{{ settings.badge_sale_text }}{% else %}Sale{% endif %}
             {% endif %}
           </span>
        </div>
        <div class="swiper-wrapper">
          {% for media in product.media %}
            <div class="swiper-slide" data-media-id="{{ media.id }}">
              {% if media.media_type == 'image' %}
                <img
                  src="{{ media | image_url: width: 900 }}"
                  class="product-item-img"
                  alt="{{ media.alt | default: product.title }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  {% if forloop.first %}fetchpriority="high"{% endif %}
                  width="{{ media.width }}"
                  height="{{ media.height }}"
                >
              {% elsif media.media_type == 'video' %}
                  {{ media | video_tag: autoplay: false, loop: true, muted: true, controls: true, playsinline: true, class: 'product-item-video' }}
              {% elsif media.media_type == 'external_video' %}
                <div class="product-item-video">
                  {{ media | external_video_tag }}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
        <!-- Add Navigation -->
        {% if section.settings.show_arrows %}
          <div class="swiper-button-prev">{% render 'icon-slider-nav', direction: 'prev' %}</div>
          <div class="swiper-button-next">{% render 'icon-slider-nav', direction: 'next' %}</div>
        {% endif %}

        {% if section.settings.enable_zoom %}
          <button class="zoom-button" aria-label="Zoom Image">
            <span>Zoom in</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              <line x1="11" y1="8" x2="11" y2="14"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
          </button>
        {% endif %}
      </div>

      {% if section.settings.show_thumbnails and section.settings.thumbnail_layout == 'bottom' %}
        <div class="thumbnails">
          {% for media in product.media %}
            {% if media.media_type == 'image' %}
              <img
                src="{{ media | image_url: width: 150 }}"
                class="thumb {% if forloop.index == 1 %}active{% endif %}"
                data-media-id="{{ media.id }}"
                data-index="{{ forloop.index0 }}"
                alt="{{ media.alt | default: product.title | escape }}"
                width="150"
                height="{{ 150 | divided_by: media.aspect_ratio | round }}"
                loading="lazy"
              >
            {% elsif media.media_type == 'video' or media.media_type == 'external_video' %}
              <img
                src="{{ media.preview_image | image_url: width: 150 }}"
                class="thumb video-thumb {% if forloop.index == 1 %}active{% endif %}"
                data-media-id="{{ media.id }}"
                data-index="{{ forloop.index0 }}"
                alt="{{ media.preview_image.alt | default: product.title | escape }}"
                width="150"
                height="{{ 150 | divided_by: media.preview_image.aspect_ratio | round }}"
                loading="lazy"
              >
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
    <div class="product-details-info">
      {% form 'product', product, id: "product-form" %}
        <input
          type="hidden"
          name="id"
          value="{{ product.selected_or_first_available_variant.id }}"
    data-variant-input
        >


        <div class="product-details">
          {% for block in section.blocks %}
         <div
      class="main-product__block main-product__block-{{ block.type }}"
      {{ block.shopify_attributes }}
    >
              {% case block.type %}

                {% when 'title' %}
            <div class="product-title-row" {{ block.shopify_attributes }}>
              <h1 class="product-title">
                {{ product.title }}
              </h1>

            {% for wblock in section.blocks %}
              {% if wblock.type == 'wishlist' and wblock.settings.show_next_to_title %}
                <div class="wishlist-next-title">
                  {% render 'wishlist-button', product: product %}
                </div>
              {% endif %}
            {% endfor %}
            </div>
            {% when 'rating' %}
  {% liquid
    assign rating_obj = product.metafields.custom.product_rating.value
    assign rating_count = product.metafields.custom.product_rating_count.value | default: 0
  %}

  {% if rating_obj != blank %}
    {% liquid
      assign rating_value = rating_obj.rating | default: rating_obj
      assign rating_max = rating_obj.scale_max | default: 5
      assign rating_percent = rating_value | times: 100 | divided_by: rating_max
    %}

    <div class="product-rating" {{ block.shopify_attributes }}>
      <div
        class="product-rating__stars"
        aria-label="{{ rating_value }} out of {{ rating_max }} stars"
      >
        <span class="product-rating__stars-empty">★★★★★</span>
        <span
          class="product-rating__stars-filled"
          style="--rating-percent: {{ rating_percent }}%;"
        >
          ★★★★★
        </span>
      </div>

      <span class="product-rating__value">
        {{ rating_value | round: 1 }}
      </span>
    </div>

  {% elsif block.settings.show_empty_rating %}
    <div class="product-rating product-rating--empty" {{ block.shopify_attributes }}>
      No reviews yet
    </div>
  {% endif %}

             {%- when 'price' -%}
          <div class="product-block-group--price">
            {% render 'product-prices',
              use_variant: true,
              product: product,
              show_sale_badge: block.settings.show_saving,
              price_text_size: 'm:text-xl md:m:text-2xl',
              sale_badge_type: block.settings.sale_badge_type
            %}
          </div>

         {% when 'inventory' %}
    {% if settings.enable_inventory_message %}
      {% assign v = product.selected_or_first_available_variant %}

      <div
        class="inventory-notice"
        data-qty="{{ v.inventory_quantity }}"
        data-policy="{{ v.inventory_policy }}"
        data-threshold="{{ settings.low_inventory_threshold }}"
        data-show-count="{{ settings.show_inventory_count }}"
        data-hide-backorder="{{ settings.hide_backorder_notice }}"
        data-show-progress="{{ settings.show_inventory_progress }}"
        data-progress-max="{{ settings.inventory_progress_max }}"
        {{ block.shopify_attributes }}
      >
        <div class="inventory-text"></div>

        {% if settings.show_inventory_progress and v.inventory_quantity > 0 %}
    <div class="inventory-progress">
      <span class="inventory-progress-bar"></span>
    </div>
  {% endif %}

      </div>
    {% endif %}
            {% when 'description' %}
              {%- assign description_check = product.description | strip_html | strip -%}
              {% if description_check != blank or product.description contains '<img' or product.description contains '<iframe' %}
                <div class="product-collapsible-tab description-tab" {{ block.shopify_attributes }}>
                  <details class="smooth-details">
                    <summary class="tab-header" aria-label="Description">
                      <span>Description</span>
                      <svg width="12" height="12" viewBox="0 0 10 10" fill="none">
                        <path d="M1 3.5L5 7.5L9 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </summary>
                    <div class="smooth-collapsible">
                      <div class="tab-content smooth-collapsible-inner">
                        <div class="tab-content-inner">
                          {{ product.description }}
                        </div>
                      </div>
                    </div>
                  </details>
                </div>
              {% endif %}

                {% when 'variants' %}
              <div {{ block.shopify_attributes }}>
                {% unless product.has_only_default_variant %}
                  {% for option in product.options_with_values %}
                  <div class="variant-group"  data-option-index="{{ forloop.index0 }}">
                    <p class="variant-label">{{ option.name }} : <span class="variant-selected-value">{{ option.selected_value }}</span></p>

                    {% assign option_name_downcase = option.name | downcase %}

<div class="swatches {% if option_name_downcase contains 'color' or option_name_downcase contains 'colour' %}color-swatches{% else %}text-swatches{% endif %}">
                      {% for value in option.values %}
                        <label class="swatch">
                          <input
                            type="radio"
                            name="options[{{ option.name }}]"
                            value="{{ value }}"
                            {% if option.selected_value == value %}checked{% endif %}
                          >
                          {% if option_name_downcase contains 'color' or option_name_downcase contains 'colour' %}
                            {% liquid
                              assign swatch_handle = value | handle
                              assign swatch_file = swatch_handle | append: '.png' 
                              assign swatch_color = nil
                              assign meta_image_url = nil

                              # 1. Try Shopify Native Swatches (Highest Priority)
                              if value.swatch != blank
                                if value.swatch.color != blank
                                  assign swatch_color = value.swatch.color
                                endif
                                if value.swatch.image != blank
                                  assign meta_image_url = value.swatch.image | image_url: width: 100
                                endif
                              endif

                              # 2. Try Theme Settings Mapping (if not found above)
                              if swatch_color == nil
                                assign raw_mappings = settings.custom_color_mapping | newline_to_br | replace: '<br />', '##' | replace: '<br>', '##' | split: '##'
                                for row in raw_mappings
                                  if row contains ':'
                                    assign parts = row | split: ":"
                                    assign m_name = parts[0] | strip | downcase
                                    assign m_color = parts[1] | strip | split: ' ' | first
                                    if m_name == value.downcase or m_name == swatch_handle
                                      assign swatch_color = m_color
                                      break
                                    endif
                                  endif
                                endfor
                              endif

                              # 3. Deep Metaobject search (if not found above)
                              if swatch_color == nil
                                assign t1 = shop.metaobjects.color[swatch_handle]
                                assign t2 = shop.metaobjects.swatch[swatch_handle]
                                assign t3 = shop.metaobjects['shopify--color-swatch'][swatch_handle]
                                assign meta_entry = t1 | default: t2 | default: t3
                                
                                if meta_entry != blank
                                  assign meta_color_val = meta_entry.color | default: meta_entry.hex | default: meta_entry.hex_code | default: meta_entry.swatch_color
                                  assign meta_img_obj = meta_entry.image | default: meta_entry.swatch_image | default: meta_entry.file
                                  if meta_color_val != blank
                                    assign swatch_color = meta_color_val
                                  endif
                                  if meta_img_obj != blank
                                    assign meta_image_url = meta_img_obj | image_url: width: 100
                                  endif
                                endif
                              endif

                              # Fallback for simple names
                              if swatch_color == nil
                                unless swatch_handle contains '-'
                                  assign swatch_color = swatch_handle
                                endunless
                              endif

                              # Final Image resolution (Assets or Files)
                              assign final_image_url = nil
                              if meta_image_url != blank
                                assign final_image_url = meta_image_url
                              else
                                # Check if file exists in Files section via images object
                                if images[swatch_file] != blank
                                  assign final_image_url = images[swatch_file] | image_url: width: 100
                                endif
                              endif
                            %}
                            <span 
                              class="color-circle swatch-{{ swatch_handle }}" 
                              style="
                                {% if swatch_color %}background-color: {{ swatch_color | replace: ' ', '' }};{% endif %}
                                {% if final_image_url %}
                                  background-image: url({{ final_image_url }});
                                {% endif %}
                                background-size: cover;
                              "
                              title="{{ value }}"
                            ></span>
                          {% else %}
                            <span class="text-pill">{{ value }}</span>
                          {% endif %}
                        </label>
                      {% endfor %}
                    </div>
                    </div>
                  {% endfor %}
                {% endunless %}
              </div>

                {% when 'quantity' %}
              <div class="qty-wrapper">
                {% render 'quantity-input', 
                    value: 1, 
                    min: 1,
                    data_attributes: 'data-quantity-selector-input',
                    minus_attributes: 'data-quantity-decrease aria-label="Decrease quantity"',
                    plus_attributes: 'data-quantity-increase aria-label="Increase quantity"'
              %}
     {% render 'add-to-cart-button',
    product: product,
    variant: product.selected_or_first_available_variant,
    class: 'primary-btn',
    text: 'Add to Cart'
  %}

              </div>

