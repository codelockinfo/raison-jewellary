{%- style -%}
  #banner-with-slider-{{ section.id }} {
    /* Desktop Sizing (Taking into account the slider is only ~60-70% of width) */
    {%- assign d_cols = section.settings.slides_per_view_desktop -%}
    {%- if d_cols >= 5 -%}
      --btn-size: 32px; --icon-size: 14px; --btn-gap: 5px;
    {%- elsif d_cols >= 4 -%}
      --btn-size: 42px; --icon-size: 16px; --btn-gap: 6px;
    {%- elsif d_cols >= 3 -%}
      --btn-size: 40px; --icon-size: 18px; --btn-gap: 10px;
    {%- else -%}
      --btn-size: 52px; --icon-size: 20px; --btn-gap: 15px;
    {%- endif -%}
  }

  @media screen and (max-width: 1280px) {
    #banner-with-slider-{{ section.id }} {
      /* Tablet Sizing */
      {%- assign t_cols = section.settings.slides_per_view_tablet -%}
      {%- if t_cols >= 4 -%}
        --btn-size: 28px; --icon-size: 12px; --btn-gap: 5px;
      {%- elsif t_cols >= 3 -%}
        --btn-size: 32px; --icon-size: 14px; --btn-gap: 6px;
      {%- else -%}
        --btn-size: 38px; --icon-size: 16px; --btn-gap: 8px;
      {%- endif -%}
    }
  }

  @media screen and (max-width: 767px) {
    #banner-with-slider-{{ section.id }} {
      /* Mobile Sizing */
      {%- assign m_cols = section.settings.slides_per_view_mobile | floor -%}
      {%- if m_cols >= 2 -%}
        --btn-size: 28px; --icon-size: 14px; --btn-gap: 4px;
      {%- else -%}
        --btn-size: 36px; --icon-size: 16px; --btn-gap: 8px;
      {%- endif -%}
    }
  }

  #banner-with-slider-{{ section.id }} .product-hover-actions {
    gap: var(--btn-gap) !important;
  }
 

  /* Specific fix for horizontal style overlapping edges */
  #banner-with-slider-{{ section.id }} .product-card-horizontal .product-hover-actions {
    max-width: 95%;
  }
  #banner-with-slider-{{ section.id }} {
    padding: {{ section.settings.section_padding_desktop }};
  }

  @media (max-width: 768px) {
    #banner-with-slider-{{ section.id }} {
      padding: {{ section.settings.section_padding_mobile }};
    }
  }

  .collection-slider-header.mobile-only,
  .mobile-only {
    display: none !important;
  }

  @media screen and (max-width: 1024px) {
    .collection-slider-header.mobile-only,
    .mobile-only {
      display: flex !important;
      margin-bottom: 20px;
    }
    .collection-slider-header.mobile-only.skeleton-title,
    .mobile-only.skeleton-title {
       display: block;
    }
    .collection-slider-box-new .collection-slider-header,
    .desktop-only {
      display: none !important;
    }
  }
{%- endstyle -%}

{% liquid
  case section.settings.heading_tag
    when 'h1'
      assign h_px = settings.h1_font_size | default: 42
    when 'h2'
      assign h_px = settings.h2_font_size | default: 38
    when 'h3'
      assign h_px = settings.type_header_base_size | default: 32
    when 'h4'
      assign h_px = settings.h4_font_size | default: 28
    when 'h5'
      assign h_px = settings.h5_font_size | default: 24
    when 'h6'
      assign h_px = settings.h6_font_size | default: 20
    else
      assign h_px = settings.h2_font_size | default: 38
  endcase
%}

<div class="newsec custom-category-section skeleton-container color-{{ section.settings.color_scheme }}" id="banner-with-slider-{{ section.id }}">
  <div class="skeleton-visible">
    <div class="collection-with-slider-main-new" style="background: #fdfdfd; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
      {% assign collection_link = section.settings.colurl %}
      {% if section.settings.jewellery_type != 'all' and section.settings.colurl contains '/collections/' %}
        {% assign collection_link = section.settings.colurl | append: '?filter.p.m.custom.jewellery_type=' | append: section.settings.jewellery_type %}
      {% endif %}
      <div class="width-container container_width">
        <div class="skeleton-box skeleton-shimmer skeleton-title mobile-only" style="height: 40px; width: 300px; margin-bottom: 20px;"></div>
        <div class="collection-img-main-box-new {% if section.settings.image_position == 'right' %}image-position-right{% endif %}">
          <div class="collection-img-box-new">
            <div class="skeleton-box skeleton-shimmer" style="width: 100%; height: 500px; border-radius: 10px;"></div>
          </div>
          <div class="collection-slider-box-new">
            <div class="skeleton-box skeleton-shimmer skeleton-title desktop-only" style="height: 40px; width: 300px; margin-bottom: 20px;"></div>
             <div style="display: flex; gap: 20px;">
               {% for i in (1..3) %}
                 <div style="flex: 1;">
                   <div class="skeleton-box skeleton-shimmer" style="width: 100%; aspect-ratio: 1/1; border-radius: 8px; margin-bottom: 10px;"></div>
                   <div class="skeleton-box skeleton-shimmer skeleton-text" style="width: 80%;"></div>
                   <div class="skeleton-box skeleton-shimmer skeleton-text.short"></div>
                 </div>
               {% endfor %}
             </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="width-container container_width">
      <div class="collection-slider-header mobile-only" style="--heading-size: {{ h_px }}px;">
        {% if section.settings.title != blank %}
          <div style="flex: 1; display: flex; justify-content: {% if section.settings.heading_alignment == 'right' %}flex-end{% elsif section.settings.heading_alignment == 'center' %}center{% else %}flex-start{% endif %};">
            {% render 'heading-style-banner', 
              heading: section.settings.title,
              heading_tag: section.settings.heading_tag,
              heading_style: section.settings.heading_style,
              heading_alignment: section.settings.heading_alignment,
              wrapper_class: 'collection-slider'
            %}
          </div>
        {% endif %}
        {% if section.settings.button_label != blank and section.settings.colurl != blank %}
          <a href="{{ collection_link }}" class="collection-slider-button">{{ section.settings.button_label }}</a>
        {% endif %}
      </div>
      <div class="collection-img-main-box-new {% if section.settings.image_position == 'right' %}image-position-right{% endif %} {% unless section.settings.show_product_slider %}no-slider{% endunless %}">
        <div class="collection-img-box-new">
          {% if section.settings.responsive_img != blank %}
            <div class="collection-main-img-new">
              <a href="{{ collection_link }}">
                {% assign fetch_priority = 'low' %}
                {% if section.settings.lazy_load == 'eager' %}
                  {% assign fetch_priority = 'high' %}
                {% endif %}
                <img src="{{ section.settings.responsive_img | image_url: width: 2000 }}" alt="{{ section.settings.responsive_img.alt | default: 'Collection image' }}" class="col-img" loading="{{ section.settings.lazy_load | default: 'lazy' }}" fetchpriority="{{ fetch_priority }}" width="{{ section.settings.responsive_img.width }}" height="{{ section.settings.responsive_img.height }}">
              </a>
            </div>
          {% else %}
            <div class="collection-main-img-new">
              {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg col-img' }}
            </div>
          {% endif %}
        </div>
        <div class="collection-slider-box-new">
          <div class="collection-slider-header" style="--heading-size: {{ h_px }}px;">
            {% if section.settings.title != blank %}
              <div style="flex: 1; display: flex; justify-content: {% if section.settings.heading_alignment == 'right' %}flex-end{% elsif section.settings.heading_alignment == 'center' %}center{% else %}flex-start{% endif %};">
                {% render 'heading-style-banner', 
                  heading: section.settings.title,
                  heading_tag: section.settings.heading_tag,
                  heading_style: section.settings.heading_style,
                  heading_alignment: section.settings.heading_alignment,
                  wrapper_class: 'collection-slider'
                %}
              </div>
            {% endif %}
            {% if section.settings.button_label != blank and section.settings.colurl != blank %}
              <a href="{{ collection_link }}" class="collection-slider-button">{{ section.settings.button_label }}</a>
            {% endif %}
          </div>
          <div class="swiper collectionSwiper-custome arrow-style-{{ section.settings.navigation_arrow_style | default: 'circle' }} {% unless section.settings.show_navigation_arrows_desktop %}hide-arrows-desktop{% endunless %} {% unless section.settings.show_navigation_arrows_mobile %}hide-arrows-mobile{% endunless %}">
            <div class="swiper-button-prev collection-swiper-button-prev">
              {% render 'icon-slider-nav', direction: 'prev' %}
            </div>
            <div class="swiper-wrapper">
              {% if section.settings.collectionproduct != blank and section.settings.collectionproduct.products.size > 0 %}
                {% assign jewellery_type = section.settings.jewellery_type %}
                {% for product in section.settings.collectionproduct.products %}
                  {% assign product_type = product.metafields.custom.jewellery_type.value %}

                  {% if jewellery_type == 'all' or product_type == jewellery_type %}
                    <div class="swiper-slide">
                      {% liquid
                        assign card_style = section.settings.product_card_style | default: 'horizontal'
                        if card_style == 'horizontal'
                          render 'product-card-horizontal', product: product, settings: section.settings
                        elsif card_style == 'vertical'
                          render 'product-card-vertical', product: product, settings: section.settings
                        else
                          render 'product-card-static', product: product, settings: section.settings
                        endif
                      %}
                    </div>
                  {% endif %}
                {% endfor %}
              {% else %}
                {% for i in (1..6) %}
                  <div class="swiper-slide">
                    {% liquid
                      assign card_style = section.settings.product_card_style | default: 'horizontal'
                      if card_style == 'horizontal'
                        render 'product-card-horizontal', placeholder_index: i, settings: section.settings
                      elsif card_style == 'vertical'
                        render 'product-card-vertical', placeholder_index: i, settings: section.settings
                      else
                        render 'product-card-static', placeholder_index: i, settings: section.settings
                      endif
                    %}
                  </div>
                {% endfor %}
              {% endif %}
            </div>
            <div class="swiper-button-next collection-swiper-button-next">
              {% render 'icon-slider-nav', direction: 'next' %}
            </div>
          </div>
        </div>
      </div>
  </div>
</div>
