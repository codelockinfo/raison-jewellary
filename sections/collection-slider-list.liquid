  {% endstyle %}


  <section
    id="{{ section_id }}"
    class="{{ section_class }} color-{{ section.settings.color_scheme }}"
    style="
    --section-padding-desktop: {{ section.settings.padding_desktop }};
    --section-padding-mobile: {{ section.settings.padding_mobile }};
    ">
  <div class="collection-slider-list__container container_width">
    <!-- SKELETON LOADER -->
    <div class="skeleton-visible">
       {% render 'skeleton-loader', type: 'collection-slider-list', count: 4 %}
    </div>

    <div class="skeleton-container">
      {% liquid
        assign desktop_layout = section.settings.layout | default: 'slider'
        assign mobile_layout = section.settings.layout_mobile | default: desktop_layout
      %}
      <div class="card-slider-wrapper card-slider-wrapper--desktop-{{ desktop_layout }} card-slider-wrapper--mobile-{{ mobile_layout }}">
        {% if section.settings.heading != blank or section.settings.subheading != blank %}
          <div class="collection-slider-list__heading-wrapper">
            {% if section.settings.heading != blank %}
                {% render 'heading-style-banner',
                  heading: section.settings.heading,
                  heading_tag: section.settings.heading_tag,
                  heading_style: section.settings.heading_style,
                  heading_alignment: section.settings.heading_alignment,
                  wrapper_class: 'collection-slider-list'
                %}
              {% endif %}
            {% if section.settings.subheading != blank %}
              <p class="collection-slider-list__subheading">{{ section.settings.subheading }}</p>
            {% endif %}
          </div>
        {% endif %}

        <div class="swiper cardSwiper cardSwiper--arrow-{{ section.settings.arrow_style | default: 'circle' }} cardSwiper--arrow-desktop-{{ section.settings.arrow_visibility | default: 'hover' }} cardSwiper--arrow-mobile-{{ section.settings.arrow_visibility_mobile | default: 'hide' }}" data-slides-per-view="{{ section.settings.slides_per_view | default: 3 }}" data-space-between="{{ section.settings.space_between | default: 30 }}" data-pagination-style="{{ section.settings.pagination_style | default: 'dots' }}">
          <div class="swiper-wrapper">

            {% for block in section.blocks %}
              {% liquid
                assign collection_name = 'Collection'
                assign collection_description = 'Collcetion Description'
                assign show_image = false
                
                if block.settings.url != blank and block.settings.url contains '/collections/'
                  assign url_parts = block.settings.url | split: '/collections/'
                  if url_parts.size > 1
                    assign collection_handle = url_parts[1] | split: '/' | first | split: '?' | first
                    assign collection_object = collections[collection_handle]
                    if collection_object != blank
                      assign collection_name = collection_object.title
                      assign collection_description = collection_object.description | strip_html
                    endif
                  endif
                endif
                
                if block.settings.title != blank
                  assign collection_name = block.settings.title
                endif
                
                if block.settings.subtitle != blank
                  assign collection_description = block.settings.subtitle
                endif
                
                if block.settings.image != blank
                  assign show_image = true
                elsif collection_object != blank and collection_object.featured_image != blank
                  assign show_image = true
                endif
              %}
              <div class="swiper-slide">
                <a href="{% if block.settings.url != blank %}{{ block.settings.url }}{% else %}#{% endif %}" class="card" {{ block.shopify_attributes }}>
                  {% if show_image %}
                    {% assign loading_strategy = section.settings.lazy_load | default: 'lazy' %}
                    {% assign fetch_priority = 'low' %}
                    {% if loading_strategy == 'eager' %}
                      {% assign fetch_priority = 'high' %}
                    {% endif %}
                    {%- liquid
                      assign current_image = block.settings.image | default: collection_object.featured_image
                      assign aspect_ratio = current_image.aspect_ratio | default: 1
                    -%}
                    <img src="{{ current_image | image_url: width: 800 }}" class="card-img" style="object-fit: cover;" loading="{{ loading_strategy }}" fetchpriority="{{ fetch_priority }}" alt="{{ collection_name | escape }}" width="800" height="{{ 800 | divided_by: aspect_ratio | round }}">
                  {% else %}
                    <div class="card-img" style="background-color: #ddd;">
                      {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
                    </div>
                  {% endif %}

                  {% if section.settings.content_position == 'on_card' %}
                    <div class="card-content">
                      <div class="card-content__title">{{ collection_name }}</div>
                      {% if collection_description != blank %}
                        <p>{{ collection_description }}</p>
                      {% endif %}
                    </div>
                  {% endif %}
                </a>
                {% if section.settings.content_position == 'below_card' %}
                  <div class="card-content-below">
                    <div>{{ collection_name }}</div>
                    {% if collection_description != blank %}
                      <p>{{ collection_description }}</p>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            {% endfor %}
          </div>

              <div class="swiper-button-next">{% render 'icon-slider-nav', direction: 'next' %}</div>
              <div class="swiper-button-prev">{% render 'icon-slider-nav', direction: 'prev' %}</div>

            {% if section.settings.pagination_visibility != 'hide' %}
              <div class="swiper-pagination cardSwiper--pagination-{{ section.settings.pagination_style | default: 'dots' }}"></div>
            {% endif %}
        </div>
      </div>
    </div>
  </div>
  </section>
  {% javascript %}
    (function() {
      function initializeSwiper(container) {
        if (!container || container.classList.contains('swiper-initialized')) return;
        
        if (typeof Swiper === 'undefined') {
          const checkSwiper = setInterval(() => {
            if (typeof Swiper !== 'undefined') {
              clearInterval(checkSwiper);
              initializeSwiper(container);
            }
          }, 100);
          return;
        }

        // Destroy existing instance if it exists
        if (container.swiper) {
          container.swiper.destroy(true, true);
        }

        try {
          const paginationEl = container.querySelector('.swiper-pagination');
          let paginationConfig = false;
          
          if (paginationEl) {
            const paginationStyle = container.dataset.paginationStyle || 'dots';
            paginationConfig = {
              el: paginationEl,
              clickable: true,
            };
            
            if (paginationStyle === 'progressbar') {
              paginationConfig.type = 'progressbar';
            } else if (paginationStyle === 'fraction') {
              paginationConfig.type = 'fraction';
            } else {
              paginationConfig.type = 'bullets';
            }
          }

          const swiperConfig = {
            slidesPerView: 'auto',
            spaceBetween: 20,
            navigation: {
              nextEl: container.querySelector('.swiper-button-next'),
              prevEl: container.querySelector('.swiper-button-prev'),
            },
            observer: true,
            observeParents: true
          };

          if (paginationConfig) {
            swiperConfig.pagination = paginationConfig;
          }

          new Swiper(container, swiperConfig);
        } catch (error) {
        }
      }

      function initAllSwipers() {
        document.querySelectorAll('.cardSwiper').forEach(el => {
          initializeSwiper(el);
        });
      }

      // Initial load
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAllSwipers);
      } else {
        initAllSwipers();
      }

      // Re-initialize when theme editor updates
      document.addEventListener('shopify:section:load', function(event) {
        const section = document.getElementById(event.detail.sectionId);
        if (section) {
          const swiper = section.querySelector('.cardSwiper');
          if (swiper) initializeSwiper(swiper);
        }
      });
      
      document.addEventListener('shopify:section:select', function(event) {
        const section = document.getElementById(event.detail.sectionId);
        if (section) {
          const swiper = section.querySelector('.cardSwiper');
          if (swiper && !swiper.swiper) initializeSwiper(swiper);
        }
      });
    })();
  {% endjavascript %}

