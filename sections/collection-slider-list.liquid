  {% liquid
    assign section_id = section.settings.custom_id | default: section.id
    assign section_class = 'collection-slider-list collection-slider-list--' | append: section.settings.layout
  %}
  {% style %}
  #{{ section_id }}, #{{ section_id }} * {
    box-sizing:border-box;
  }

  #{{ section_id }} .card-slider-wrapper{
    padding: var(--section-padding-desktop, 60px);
  }
  #{{ section_id }} .card-content__title{
    display: none;
    line-height: 1.2;
    margin-bottom: 10px;
  }
{% comment %} Removed mobile padding override in favor of unified settings {% endcomment %}

    #{{ section_id }} .collection-slider-list__container {
      width: 100%;
      margin-left: auto;
      margin-right: auto;
    }

{% comment %} Removed old max-width classes in favor of dynamic styles {% endcomment %}

  #{{ section_id }} .card-slider-wrapper .cardSwiper{
    overflow: hidden;
  }

  #{{ section_id }} .card-slider-wrapper .swiper-wrapper{
    align-items: stretch;
  }

  #{{ section_id }} .card-slider-wrapper .swiper-slide{
    width: auto !important;
  }

  #{{ section_id }} .collection-slider-list__heading-wrapper{
    text-align: {{ section.settings.heading_alignment }};
  }
  #{{ section_id }} .card-slider-wrapper .collection-slider-list__subheading {
    color: var(--color-subtext);
    margin: 5px 0 0;
    padding: 0 40px;
  }

    #{{ section_id }} .card-slider-wrapper .card{
      position:relative;
      width:380px; 
      height:700px;
      border-radius: var(--block-radius, 20px);
      overflow:hidden;
      cursor:pointer;
      transition:width 0.5s ease;
      will-change: width;
      text-decoration: none;
      color: inherit;
      display: block;
    }
@media (min-width: 769px) {
  #{{ section_id }} .card-slider-wrapper .cardSwiper {
    overflow: hidden;
    padding-inline-end: 0;
  }

  #{{ section_id }} .card-slider-wrapper .swiper-slide {
    transition: transform 0.45s ease;
  }

  #{{ section_id }} .card-slider-wrapper .swiper-slide:hover {
    z-index: 10;
  }

  #{{ section_id }} .card-slider-wrapper .swiper-slide:hover .card {
    width: 480px;
  }

  /* Prevent flickering on the last item by extending the hover area */
  #{{ section_id }} .card-slider-wrapper .swiper-slide {
    position: relative;
  }
  
  #{{ section_id }} .card-slider-wrapper .swiper-slide::after {
    content: '';
    position: absolute;
    top: 0;
    right: -40px; /* Bridge the gap between slides to prevent dead zones */
    bottom: 0;
    width: 40px;
    z-index: 5;
    background: transparent;
  }

  /* Larger buffer for the last slide to handle end-of-row layout shifts */
  #{{ section_id }} .card-slider-wrapper .swiper-slide:last-child::after {
    right: -100px;
    width: 100px;
  }

  /* Use :has() to ensure we only shrink siblings when a slide is actually hovered, prevents vibration when hovering gaps */
  #{{ section_id }} .card-slider-wrapper .swiper-wrapper:has(.swiper-slide:hover) .swiper-slide:not(:hover) .card {
    width: 355px;
    opacity: 0.85;
  }
}


  #{{ section_id }} .card-slider-wrapper .card-img{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
    transition: none !important;
    transform: translate3d(0,0,0);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  @media (min-width: 769px) {
    #{{ section_id }} .card-slider-wrapper .card-img {
       width: auto;
       min-width: 480px; /* Force image to cover expanded width */
       position: absolute;
       left: 50%;
       transform: translateX(-50%) translate3d(0,0,0) !important;
    }
    
    #{{ section_id }} .card:hover .card-img {
       transform: translateX(-50%) translate3d(0,0,0) !important;
    }
  }

  #{{ section_id }} .card-slider-wrapper .card-content{
    position:absolute;
    bottom:10px;
    left:24px;
    right:24px;
    text-align: {{ section.settings.content_alignment }};
  }

  #{{ section_id }} .card-slider-wrapper .card-content h3{
    margin:0 0 8px;
    color: var(--color-text);
  }

  #{{ section_id }} .card-slider-wrapper .card-content p{
    margin:0;
    opacity:0.9;
    color: var(--color-text);
    line-height: 20px;
  }

  #{{ section_id }} .card-slider-wrapper .card-content-below {
    padding: 20px 0 0;
    text-align: {{ section.settings.content_alignment }};
    overflow: visible;
    max-width: 380px; 
    width: 100%;
  }

  #{{ section_id }} .card-slider-wrapper .card-content-below h3 {
    margin: 0 0 8px;
  }

  #{{ section_id }} .card-slider-wrapper .card-content-below div{
    font-weight: bold;
  }

  #{{ section_id }} .card-slider-wrapper .card-content-below p {
  white-space: normal;
  overflow-wrap: anywhere;
  word-break: normal;
  line-height: 1.5;
  }

    #{{ section_id }} .cardSwiper {
      width: 100%;
      padding-bottom: 0px;
      margin: 18px 0 0;
    }

    #{{ section_id }} .cardSwiper .swiper-wrapper {
      margin: 0;
    }

    #{{ section_id }} .cardSwiper .swiper-slide {
      height: auto;
    }

    #{{ section_id }} .cardSwiper .swiper-slide .featured-collections__card {
      width: 100%;
      display: block;
    }

    #{{ section_id }} .cardSwiper .swiper-button-next,
    #{{ section_id }} .cardSwiper .swiper-button-prev {
      background-color: var(--color-arrow-bg);
      border: 1px solid var(--color-arrow-bg);
      color: var(--color-arrow);
      width: 44px;
      height: 44px;
      border-radius: var(--button-border-radius, 50%);
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #{{ section_id }} .cardSwiper--arrow-desktop-hover .swiper-button-next,
    #{{ section_id }} .cardSwiper--arrow-desktop-hover .swiper-button-prev {
      opacity: 0 !important;
      pointer-events: none;
    }

    #{{ section_id }} .cardSwiper--arrow-desktop-always .swiper-button-next:not(.swiper-button-disabled),
    #{{ section_id }} .cardSwiper--arrow-desktop-always .swiper-button-prev:not(.swiper-button-disabled) {
      opacity: 1 !important;
      pointer-events: auto;
    }

    #{{ section_id }} .cardSwiper--arrow-circle .swiper-button-next,
    #{{ section_id }} .cardSwiper--arrow-circle .swiper-button-prev {
      border-radius: 50%;
    }

    #{{ section_id }} .cardSwiper--arrow-rounded-square .swiper-button-next,
    #{{ section_id }} .cardSwiper--arrow-rounded-square .swiper-button-prev {
      border-radius: 33%;
    }

    #{{ section_id }} .cardSwiper--arrow-square .swiper-button-next,
    #{{ section_id }} .cardSwiper--arrow-square .swiper-button-prev {
      border-radius: 0;
    }
    #{{ section_id }} .cardSwiper--arrow-desktop-hover:hover .swiper-button-next:not(.swiper-button-disabled),
    #{{ section_id }} .cardSwiper--arrow-desktop-hover:hover .swiper-button-prev:not(.swiper-button-disabled) {
      opacity: 1 !important;
      pointer-events: auto;
    }

    #{{ section_id }} .cardSwiper .swiper-button-disabled {
      opacity: 0.4 !important;
      pointer-events: none !important;
      cursor: not-allowed;
    }

    #{{ section_id }} .cardSwiper .swiper-button-next:hover,
    #{{ section_id }} .cardSwiper .swiper-button-prev:hover {
      background-color: var(--color-arrow-hover-bg);
      color: var(--color-arrow-hover);
      border-color: var(--color-arrow-hover-bg);
    }

    #{{ section_id }} .cardSwiper .swiper-button-next::after,
    #{{ section_id }} .cardSwiper .swiper-button-prev::after {
      font-size: 16px !important;
      font-weight: bold;
    }

    #{{ section_id }} .cardSwiper--arrow-desktop-none .swiper-button-next,
    #{{ section_id }} .cardSwiper--arrow-desktop-none .swiper-button-prev {
      display: none !important;
    }

  @media (min-width: 769px) {

      /* Desktop: none */
      #{{ section_id }} .cardSwiper--arrow-desktop-none .swiper-button-next,
      #{{ section_id }} .cardSwiper--arrow-desktop-none .swiper-button-prev {
          display: none !important;
      }

      /* Desktop: always */
      #{{ section_id }} .cardSwiper--arrow-desktop-always .swiper-button-next:not(.swiper-button-disabled),
      #{{ section_id }} .cardSwiper--arrow-desktop-always .swiper-button-prev:not(.swiper-button-disabled) {
          opacity: 1 !important;
          pointer-events: auto;
      }

      /* Desktop: hover */
      #{{ section_id }} .cardSwiper--arrow-desktop-hover .swiper-button-next,
      #{{ section_id }} .cardSwiper--arrow-desktop-hover .swiper-button-prev {
          opacity: 0;
          pointer-events: none;
      }

      #{{ section_id }} .cardSwiper--arrow-desktop-hover:hover .swiper-button-next:not(.swiper-button-disabled),
      #{{ section_id }} .cardSwiper--arrow-desktop-hover:hover .swiper-button-prev:not(.swiper-button-disabled) {
          opacity: 1;
          pointer-events: auto;
      }
  }

  /* FIX: Hover mode should show enabled + disabled arrows on hover */

/* Hide all arrows normally in desktop hover mode */
@media (min-width: 769px) {
  #{{ section_id }} .cardSwiper--arrow-desktop-hover .swiper-button-next,
  #{{ section_id }} .cardSwiper--arrow-desktop-hover .swiper-button-prev {
    opacity: 0 !important;
    pointer-events: none !important;
  }

  /* Show all arrows on slider hover */
  #{{ section_id }} .cardSwiper--arrow-desktop-hover:hover .swiper-button-next,
  #{{ section_id }} .cardSwiper--arrow-desktop-hover:hover .swiper-button-prev {
    opacity: 1 !important;
    pointer-events: auto !important;
  }

  /* Disabled arrow should also show on hover, but faded and not clickable */
