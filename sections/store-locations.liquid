{% liquid
  assign section_id = section.settings.custom_id | default: section.id
  assign section_class = 'store-locations-section'
  assign layout_class = 'layout-' | append: section.settings.content_image_position | default: 'layout-image-left'
%}

<section
  id="{{ section_id }}"
  class="{{ section_class }} {{ layout_class }} color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
>
  <div class="store-locations-section__container container_width">
    <!-- SKELETON LOADER -->
    <div class="skeleton-visible">
       {% render 'skeleton-loader', type: 'store-locations' %}
    </div>

    <div class="skeleton-container">

      {% if section.settings.heading != blank or section.settings.sub_heading != blank %}
        <div class="store-locations-section__heading-wrapper">
          {% render 'heading-style-banner',
            heading: section.settings.heading,
            heading_tag: section.settings.heading_tag,
            heading_style: section.settings.heading_style,
            heading_alignment: section.settings.heading_alignment,
            wrapper_class: 'store-locations-section'
          %}
          {% if section.settings.sub_heading != blank %}
            <p class="store-locations-section__sub-heading text-align-{{ section.settings.sub_heading_alignment | default: 'left' }}">
              {{ section.settings.sub_heading }}
            </p>
          {% endif %}
        </div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="store-locations-section__wrapper">
          <!-- Location Selector - Outside content blocks, positioned above right content -->
          <div class="store-locations-section__selector-wrapper">
            <div class="store-locations-section__selector">
              {% for block in section.blocks %}
                <button
                  type="button"
                  class="store-locations-section__location-btn {% if forloop.first %}active{% endif %}"
                  data-location-id="{{ block.id }}"
                  data-block-index="{{ forloop.index0 }}"
                  aria-label="Select {{ block.settings.location_name }}"
                >
                  {{ block.settings.location_name | upcase }}
                </button>
              {% endfor %}
            </div>
          </div>

          <!-- Store Details Content -->
          <div class="store-locations-section__content-wrapper">
            {% for block in section.blocks %}
              <div
                class="store-locations-section__store-content {% if forloop.first %}active{% endif %}"
                data-location-content="{{ block.id }}"
              >
                <div class="store-locations-section__image">
                  {% if block.settings.store_image %}
                    {% assign loading_strategy = section.settings.lazy_load | default: 'lazy' %}
                    {% assign fetch_priority = 'low' %}
                    {% if loading_strategy == 'eager' %}
                      {% assign fetch_priority = 'high' %}
                    {% endif %}
                    {{
                      block.settings.store_image
                      | image_url: width: 1200
                      | image_tag:
                        loading: loading_strategy,
                        fetchpriority: fetch_priority,
                        alt: block.settings.store_name,
                        widths: '375, 550, 750, 1100, 1500'
                    }}
                  {% else %}
                    <div class="store-locations-section__image-placeholder">
                      {{ 'image' | placeholder_svg_tag: 'placeholder' }}
                    </div>
                  {% endif %}
                </div>

                <div class="store-locations-section__details-wrapper">
                  <div class="store-locations-section__details content-position-{{ section.settings.content_position | default: 'left' }}">
                    {% if block.settings.store_name != blank %}
                      <h3 class="store-locations-section__store-name">
                        {{ block.settings.store_name | upcase }}
                      </h3>
                    {% endif %}

                    {% if block.settings.address != blank %}
                      <div class="store-locations-section__address">
                        {{ block.settings.address }}
                      </div>
                    {% endif %}

                    {% if block.settings.phone != blank %}
                      <div class="store-locations-section__phone">
                        {{ block.settings.phone }}
                      </div>
                    {% endif %}

                    {% if block.settings.hours != blank %}
                      <div class="store-locations-section__hours">
                        {{ block.settings.hours }}
                      </div>
                    {% endif %}

                    {% if block.settings.direction_url != blank %}
                      <a
                        href="{{ block.settings.direction_url }}"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="store-locations-section__direction-btn"
                      >
                        GET DIRECTION
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="https://www.w3.org/2000/svg">
                          <path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </a>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</section>
{% style %}
  #{{ section_id }} {
    {% liquid
      case section.settings.heading_tag
        when 'h1'
          assign h_px = settings.h1_font_size | default: 42
        when 'h2'
          assign h_px = settings.h2_font_size | default: 38
        when 'h3'
          assign h_px = settings.type_header_base_size | default: 32
        when 'h4'
          assign h_px = settings.h4_font_size | default: 28
        when 'h5'
          assign h_px = settings.h5_font_size | default: 24
        when 'h6'
          assign h_px = settings.h6_font_size | default: 20
        else
          assign h_px = settings.h2_font_size | default: 38
      endcase
    %}
    --heading-font-size-desktop: {{ h_px }}px;
    --section-padding: {{ section.settings.padding_desktop }};
  }
  @media (max-width: 768px) {
    #{{ section_id }} {
      --section-padding: {{ section.settings.padding_mobile }};
    }
  }
{% endstyle %}

