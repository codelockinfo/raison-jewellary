<section class="image-text-section section-{{ section.id }} image-{{ section.settings.image_position }} color-{{ section.settings.color_scheme }} skeleton-container"
  style="
    --section-padding-desktop: {{ section.settings.section_padding_desktop }};
    --section-padding-mobile: {{ section.settings.section_padding_mobile }};
  ">
  <div class="skeleton-visible">
    <div class="container_width" style="padding: var(--section-padding-desktop);">
      <div style="display: flex; gap: 40px; align-items: center; flex-direction: {% if section.settings.image_position == 'right' %}row-reverse{% else %}row{% endif %};">
        <div class="skeleton-box skeleton-shimmer" style="flex: 1; aspect-ratio: 1/1; border-radius: 20px;"></div>
        <div style="flex: 1;">
          <div class="skeleton-box skeleton-shimmer skeleton-title" style="height: 48px; width: 80%; margin-bottom: 20px;"></div>
          <div class="skeleton-box skeleton-shimmer skeleton-text long"></div>
          <div class="skeleton-box skeleton-shimmer skeleton-text medium"></div>
          <div class="skeleton-box skeleton-shimmer skeleton-button" style="margin-top: 30px;"></div>
        </div>
      </div>
    </div>
  </div>
    <div class="container_width">
      {% assign has_content = false %}
      {% if section.settings.heading != blank or section.settings.subheading != blank or section.settings.button_text != blank %}
        {% assign has_content = true %}
      {% endif %}

      <div class="image-text-wrapper align-stretch media-width--{{ section.settings.media_width }} {% unless has_content %}media-only{% endunless %}">

        <div class="media-container height-{{ section.settings.media_height }}">
          {% if section.settings.media_type == 'image' %}
            {% if section.settings.image != blank %}
              {% assign loading_strategy = section.settings.lazy_load | default: 'lazy' %}
              {% assign fetch_priority = 'auto' %}
              {% if loading_strategy == 'eager' %}
                {% assign fetch_priority = 'high' %}
              {% endif %}
              {% render 'image',
                image: section.settings.image,
                loading: loading_strategy,
                fetchpriority: fetch_priority,
                sizes: '(min-width: 990px) 50vw, 100vw',
                class: 'image-with-text__image'
              %}
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          {% else %}
            {% if section.settings.video != blank %}
              {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
            {% elsif section.settings.external_video_url != blank %}
              {% if section.settings.external_video_url.type == 'youtube' %}
                 <iframe src="https://www.youtube.com/embed/{{ section.settings.external_video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ section.settings.external_video_url.id }}" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
              {% else %}
                 <iframe src="https://player.vimeo.com/video/{{ section.settings.external_video_url.id }}?autoplay=1&muted=1&loop=1" frameborder="0" allow="autoplay; fullscreen" allowfullscreen></iframe>
              {% endif %}
            {% else %}
              <div class="video-placeholder">
                {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}

                <!-- ▶ PLAY ICON -->
                <div class="video-play-icon">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <polygon points="5,3 19,12 5,21"></polygon>
                  </svg>
                </div>
              </div>
            {% endif %}

          {% endif %}
        </div>

        {% if has_content %}
          <div class="content-container vertical-{{ section.settings.vertical_align }} horizontal-{{ section.settings.horizontal_align }}">
            {% if section.settings.heading != blank %}
              <div class="common-heading">
                {% render 'heading-style-banner',
                  heading: section.settings.heading,
                  heading_tag: section.settings.heading_tag,
                  heading_style: section.settings.heading_style,
                  heading_alignment: section.settings.heading_alignment,
                  wrapper_class: 'image-text-section'
                %}
              </div>
            {% endif %}

            {% if section.settings.subheading != blank %}
              <p class="common-subheading">{{ section.settings.subheading }}</p>
            {% endif %}

            {% if section.settings.button_text != blank %}
              <a href="{{ section.settings.button_url }}" class="common-btn">
                {{ section.settings.button_text }}
              </a>
            {% endif %}
          </div>
        {% endif %}

      </div>
    </div>
</section>


{% schema %}
{
  "name": "Image with Text",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media Type",
      "default": "image",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ]
    },
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "lazy_load",
      "label": "Image Loading",
      "options": [
        { "value": "lazy", "label": "Lazy" },
        { "value": "eager", "label": "Eager" }
      ],
      "default": "lazy"
    },
    {
      "type": "header",
      "content": "Video Settings"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Select Video"
    },
    {
      "type": "video_url",
      "id": "external_video_url",
      "label": "External Video URL",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "media_height",
      "label": "Media Height",
      "default": "adapt",
      "options": [
        { "value": "adapt", "label": "Adapt to Content" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ]
    },
    {
      "type": "select",
      "id": "media_width",
      "label": "Media Width",
      "default": "medium",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ]
    },
    {
      "type": "select",
      "id": "vertical_align",
      "label": "Content Vertical Alignment",
      "default": "middle",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "select",
      "id": "horizontal_align",
      "label": "Content Horizontal Alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Image With Text"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading Tag",
      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ]
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Your subheading text goes here.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL",
      "default": "/collections/all"
    },
    { "type": "header", "content": "Section Spacing" },
    { "type": "text", "id": "section_padding_desktop", "label": "Section Padding (Desktop)", "default": "60px 20px 60px 20px" },
    { "type": "text", "id": "section_padding_mobile", "label": "Section Padding (Mobile)", "default": "20px 20px 20px 20px" },

  ],
  "presets": [
    {
      "name": "Image with Text"
    }
  ]
}
{% endschema %}
