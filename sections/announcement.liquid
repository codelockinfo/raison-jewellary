{%- if section.settings.show_announcement != false -%}
  <div class="announcement" id="AnnouncementBar-{{ section.id }}">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
      {%- endfor -%}
    {%- else -%}
      <span>Secure, trackable shipping</span>
      <span>Gold &amp; diamond specifications disclosed</span>
      <span>Easy returns on eligible products</span>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "class": "announcement-bar-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement Bar",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#290018"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f7eada"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Secure, trackable shipping"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "Secure, trackable shipping"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Gold & diamond specifications disclosed"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Easy returns on eligible products"
          }
        }
      ]
    }
  ]
}
{% endschema %}
