{% liquid
  assign loading_strategy = section.settings.lazy_load | default: 'lazy'
  assign fetch_priority = 'auto'
  if loading_strategy == 'eager'
    assign fetch_priority = 'high'
  endif
%}

<section id="collection-grid-{{ section.id }}" class="custom-image-overlay-grid section-{{ section.id }} color-{{ section.settings.color_scheme }} skeleton-container" style="
  --section-padding: {{ section.settings.desktop_padding }};
  --section-padding-mobile: {{ section.settings.mobile_padding }};
">
  <div class="skeleton-visible">
    <div class="container_width">
       <div class="grid-container count-{{ section.blocks.size }}" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;">
          {% for i in (1..3) %}
            <div class="skeleton-box skeleton-shimmer" style="width: 100%; aspect-ratio: 1/1; border-radius: 12px; height: 400px;"></div>
          {% endfor %}
       </div>
    </div>
  </div>
  <div class="container_width">
    <div class="grid-container count-{{ section.blocks.size }}">

      {% if section.blocks.size == 5 %}
        <!-- For 5 images -->
        <div class="big-image">
          {% assign first_block = section.blocks.first %}
          <div class="image-wrapper">
            {% if first_block.settings.image %}
              {% render 'image',
                image: first_block.settings.image,
                loading: loading_strategy,
                fetchpriority: fetch_priority,
                sizes: '100vw'
              %}
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}

            <div class="section-overlay content-align-{{ section.settings.content_align }} content-valign-{{ section.settings.content_position }}">
              {% if first_block.settings.heading != blank %}
              {% render 'heading-style-banner',
                heading: first_block.settings.heading,
                heading_tag: section.settings.heading_tag,
                heading_style: section.settings.heading_style,
                heading_alignment: section.settings.heading_alignment,
                wrapper_class: 'collection-grid-section'
              %}
              {% endif %}
              {% if first_block.settings.text != blank %}
                <p>{{ first_block.settings.text }}</p>
              {% endif %}
                {% assign button_link = block.settings.button_url %}

                {% if section.settings.jewellery_type != 'all'
                  and block.settings.button_url contains '/collections/' %}
                  {% assign button_link = block.settings.button_url
                    | append: '?filter.p.m.custom.jewellery_type='
                    | append: section.settings.jewellery_type %}
                {% endif %}

                <a href="{{ button_link }}" class="btn">
                  {{ first_block.settings.button_text }}
                </a>
            </div>
          </div>
        </div>

        <div class="small-grid">
          {% for block in section.blocks offset:1 %}
            <div class="small-image image-wrapper">
              {% if block.settings.image %}
                {% render 'image',
                  image: block.settings.image,
                  loading: loading_strategy,
                  fetchpriority: fetch_priority,
                  sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw'
                %}
              {% else %}
                {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}

              <div class="section-overlay content-align-{{ section.settings.content_align }} content-valign-{{ section.settings.content_position }}">
                {% if block.settings.heading != blank %}
                  {% render 'heading-style-banner',
                  heading: block.settings.heading,
                  heading_tag: section.settings.heading_tag,
                  heading_style: section.settings.heading_style,
                  heading_alignment: section.settings.heading_alignment,
                  wrapper_class: 'collection-grid-section'
                %}
                {% endif %}
                {% if block.settings.text != blank %}
                  <p>{{ block.settings.text }}</p>
                {% endif %}
                  {% assign button_link = block.settings.button_url %}

                  {% if section.settings.jewellery_type != 'all'
                    and block.settings.button_url contains '/collections/' %}
                    {% assign button_link = block.settings.button_url
                      | append: '?filter.p.m.custom.jewellery_type='
                      | append: section.settings.jewellery_type %}
                  {% endif %}

                  <a href="{{ button_link }}" class="btn">
                    {{ block.settings.button_text }}
                  </a>
              </div>
            </div>
          {% endfor %}
        </div>

      {% elsif section.blocks.size == 6 %}
        <!-- For 6 images custom layout -->
        {% for block in section.blocks %}
          <div class="grid-item image-wrapper">
            {% if block.settings.image %}
              {% render 'image',
                image: block.settings.image,
                loading: loading_strategy,
                fetchpriority: fetch_priority,
                sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw'
              %}
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}

            <div class="section-overlay content-align-{{ section.settings.content_align }} content-valign-{{ section.settings.content_position }}">
              {% if block.settings.heading != blank %}
                {% render 'heading-style-banner',
                  heading: block.settings.heading,
                  heading_tag: section.settings.heading_tag,
                  heading_style: section.settings.heading_style,
                  heading_alignment: section.settings.heading_alignment,
                  wrapper_class: 'collection-grid-section'
                %}
              {% endif %}
              {% if block.settings.text != blank %}
                <p>{{ block.settings.text }}</p>
              {% endif %}
                {% assign button_link = block.settings.button_url %}

                {% if section.settings.jewellery_type != 'all'
                  and block.settings.button_url contains '/collections/' %}
                  {% assign button_link = block.settings.button_url
                    | append: '?filter.p.m.custom.jewellery_type='
                    | append: section.settings.jewellery_type %}
                {% endif %}

                <a href="{{ button_link }}" class="btn">
                  {{ block.settings.button_text }}
                </a>
            </div>
          </div>
        {% endfor %}

      {% else %}
        <!-- 2,3,4 images -->
        {% for block in section.blocks %}
          <div class="grid-item image-wrapper">
            {% if block.settings.image %}
              {% render 'image',
                image: block.settings.image,
                loading: loading_strategy,
                fetchpriority: fetch_priority,
                sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw'
              %}
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}

            <div class="section-overlay content-align-{{ section.settings.content_align }} content-valign-{{ section.settings.content_position }}">
              {% if block.settings.heading != blank %}
                {% render 'heading-style-banner',
                  heading: block.settings.heading,
                  heading_tag: section.settings.heading_tag,
                  heading_style: section.settings.heading_style,
                  heading_alignment: section.settings.heading_alignment,
                  wrapper_class: 'collection-grid-section'
                %}
              {% endif %}
              {% if block.settings.text != blank %}
                <p>{{ block.settings.text }}</p>
              {% endif %}
                {% assign button_link = block.settings.button_url %}

                {% if section.settings.jewellery_type != 'all'
                  and block.settings.button_url contains '/collections/' %}
                  {% assign button_link = block.settings.button_url
                    | append: '?filter.p.m.custom.jewellery_type='
                    | append: section.settings.jewellery_type %}
                {% endif %}

                <a href="{{ button_link }}" class="btn">
                  {{ block.settings.button_text }}
                </a>
            </div>
          </div>
        {% endfor %}
      {% endif %}

    </div>
  </div>
</section>
{% schema %}
{
  "name": "grid collection",
  "max_blocks": 6,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "lazy_load",
      "label": "Image Loading",
      "options": [
        { "value": "lazy", "label": "Lazy" },
        { "value": "eager", "label": "Eager" }
      ],
      "default": "lazy"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading Level (Size)",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Heading Style",
      "options": [
        { "value": "simple", "label": "design 1" },
        { "value": "line-top", "label": "design 2" },
        { "value": "underline", "label": "design 3" },
        { "value": "lines", "label": "design 4" },
        { "value": "diamond", "label": "design 5" },
        { "value": "ornament", "label": "design 6" },
        { "value": "x", "label": "design 7" }
      ],
      "default": "simple"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Vertical Position",
      "default": "middle",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Horizontal Alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "text",
      "id": "desktop_padding",
      "label": "Desktop Padding (e.g. 40px 20px 40px 20px)",
      "default": "40px 0px 40px 0px"
    },
    {
      "type": "text",
      "id": "mobile_padding",
      "label": "Mobile Padding (e.g. 20px 10px 20px 10px)",
      "default": "20px 0px 20px 0px"
    },
    {
      "type": "select",
      "id": "jewellery_type",
      "label": "Jewellery Type",
      "options": [
        {
          "value": "all",
          "label": "All"
        },
        {
          "value": "Silver",
          "label": "Silver"
        },
        {
          "value": "Gold",
          "label": "Gold"
        }
      ],
      "default": "all"
    }
  ],
  "blocks": [
    {
      "type": "image_content",
      "name": "Image with Content",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Heading Text"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Some description text goes here."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL",
          "default": "/collections/all"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "grid collection",
       "category": "Collection",
      "blocks": [
        {
          "type": "image_content"
        },
        {
          "type": "image_content"
        },
        {
          "type": "image_content"
        },
        {
          "type": "image_content"
        },
        {
          "type": "image_content"
        },
        {
          "type": "image_content"
        }
      ]
    }
  ]
}
{% endschema %}
