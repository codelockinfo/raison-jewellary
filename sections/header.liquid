<div class="site-top-shell{% if section.settings.enable_sticky_header %} is-sticky{% endif %}" id="SiteTopShell-{{ section.id }}">
  <header class="header">
    <button class="mobile-menu" aria-label="Open menu" aria-expanded="false" data-mobile-nav-toggle>
      <svg class="hamburger-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
      <svg class="close-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
    
    <a href="{{ routes.root_url }}" class="brand" aria-label="{{ shop.name }} home">
      {%- if section.settings.logo != blank -%}
        <img 
          src="{{ section.settings.logo | image_url: width: 300 }}" 
          alt="{{ section.settings.logo.alt | default: shop.name }}"
          width="132"
          height="45"
          loading="eager"
        >
      {%- else -%}
        <img 
          src="https://riseon-jewels.r-katariya56.chatgpt.site/riseon-logo-trimmed.png" 
          alt="Riseon Jewels"
          width="132"
          height="45"
          loading="eager"
        >
      {%- endif -%}
      <span class="brand-tm" aria-label="Trademark">TM</span>
    </a>

    <button type="button" class="searchbar" data-search-modal-trigger aria-label="Search">
      <span>⌕</span> {{ section.settings.search_placeholder | default: 'Search lightweight rings, earrings, pendants…' }}
    </button>

    <div class="header-actions">
      <a href="{{ section.settings.partner_link | default: '/pages/brand-partner-programme' }}" aria-label="Partner">
        <span>◉</span><small>Partner</small>
      </a>
      <a href="{{ routes.account_login_url }}" aria-label="Account">
        <span>♙</span><small>Account</small>
      </a>
      <button type="button" aria-label="Wishlist" onclick="window.location.href='/pages/wishlist'">
        <span>♡</span><b class="js-wishlist-count">0</b><small>Wishlist</small>
      </button>
      <button type="button" class="cart-btn" aria-label="Open cart" data-cart-drawer-open>
        <span>♧</span><b class="js-cart-count">{{ cart.item_count }}</b><small>Cart</small>
      </button>
    </div>
  </header>

  <nav class="nav" id="MainNavigation" aria-label="Main navigation">
    {%- if section.settings.menu.links.size > 0 -%}
      {%- for link in section.settings.menu.links -%}
        {%- if link.links != blank -%}
          <div class="nav-item has-dropdown">
            <a href="{{ link.url }}" class="nav-link{% if link.active %} active{% endif %}" aria-haspopup="true" aria-expanded="false">
              <span>{{ link.title }}</span>
              <svg class="dropdown-chevron" width="9" height="6" viewBox="0 0 9 6" fill="none" aria-hidden="true">
                <path d="M1 1.5L4.5 5L8 1.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <div class="nav-dropdown" role="menu" aria-label="{{ link.title | escape }}">
              <ul class="nav-dropdown-list">
                {%- for child_link in link.links -%}
                  <li class="nav-dropdown-item{% if child_link.links != blank %} has-sub-dropdown{% endif %}">
                    <a href="{{ child_link.url }}" class="nav-dropdown-link{% if child_link.active %} active{% endif %}" role="menuitem">
                      <span>{{ child_link.title }}</span>
                      {%- if child_link.links != blank -%}
                        <svg class="sub-chevron" width="6" height="9" viewBox="0 0 6 9" fill="none" aria-hidden="true">
                          <path d="M1.5 1L5 4.5L1.5 8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      {%- endif -%}
                    </a>
                    {%- if child_link.links != blank -%}
                      <div class="nav-sub-dropdown">
                        <ul class="nav-dropdown-list">
                          {%- for grandchild_link in child_link.links -%}
                            <li class="nav-dropdown-item">
                              <a href="{{ grandchild_link.url }}" class="nav-dropdown-link{% if grandchild_link.active %} active{% endif %}" role="menuitem">
                                <span>{{ grandchild_link.title }}</span>
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </div>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          </div>
        {%- else -%}
          <div class="nav-item">
            <a href="{{ link.url }}" class="nav-link{% if link.active %} active{% endif %}">
              <span>{{ link.title }}</span>
            </a>
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      <div class="nav-item"><a href="/collections/ring" class="nav-link"><span>Rings</span></a></div>
      <div class="nav-item"><a href="/collections/earring" class="nav-link"><span>Earrings</span></a></div>
      <div class="nav-item"><a href="/collections/pendant-for-her" class="nav-link"><span>Pendants</span></a></div>
      <div class="nav-item"><a href="/collections/bracelate-for-her" class="nav-link"><span>Bracelets &amp; Bangles</span></a></div>
      <div class="nav-item"><a href="/collections/nose-pin" class="nav-link"><span>Nose Pins</span></a></div>
      <div class="nav-item"><a href="/collections/mangalsutra-pendant" class="nav-link"><span>Mangalsutra</span></a></div>
      <div class="nav-item"><a href="/pages/about-us" class="nav-link"><span>THE BRAND</span></a></div>
      <div class="nav-item"><a href="/blogs/news" class="nav-link"><span>Blog</span></a></div>
    {%- endif -%}
  </nav>
</div>

<!-- Mobile Drawer Overlay -->
<div class="mobile-drawer-overlay" id="MobileDrawerOverlay" data-mobile-drawer-overlay></div>

<!-- Search Overlay Modal -->
<div class="search-overlay" id="RiseonSearchOverlay" role="dialog" aria-modal="true" aria-label="Search modal">
  <div class="search-dialog">
    <button type="button" class="search-close" aria-label="Close search" data-search-modal-close>&times;</button>
    <label for="RiseonSearchInput">Search our fine jewellery</label>
    <form action="{{ routes.search_url }}" method="get" role="search">
      <input 
        id="RiseonSearchInput" 
        type="search" 
        name="q" 
        placeholder="Type rings, earrings, pendants, gold..." 
        autocomplete="off"
        value="{{ search.terms | escape }}"
      >
    </form>
    <p>Press Enter to view all matching results</p>
  </div>
</div>


<div class="mobile-drawer-overlay" id="MobileDrawerOverlay"></div>

<script>
  (function() {
    function initHeader() {
      const mobileToggle = document.querySelector('[data-mobile-nav-toggle]');
      const nav = document.getElementById('MainNavigation');
      const drawerOverlay = document.getElementById('MobileDrawerOverlay');
      const searchTriggers = document.querySelectorAll('[data-search-modal-trigger]');
      const searchOverlay = document.getElementById('RiseonSearchOverlay');
      const searchClose = document.querySelector('[data-search-modal-close]');
      const searchInput = document.getElementById('RiseonSearchInput');

      /* ── Mobile Drawer Open / Close ─────────────────────────── */
      function openDrawer() {
        if (!nav || !mobileToggle) return;
        nav.classList.add('open');
        if (drawerOverlay) drawerOverlay.classList.add('open');
        mobileToggle.classList.add('is-active');
        mobileToggle.setAttribute('aria-expanded', 'true');
        mobileToggle.setAttribute('aria-label', 'Close menu');
        document.body.style.overflow = 'hidden';
      }

      function closeDrawer() {
        if (!nav || !mobileToggle) return;
        nav.classList.remove('open');
        if (drawerOverlay) drawerOverlay.classList.remove('open');
        mobileToggle.classList.remove('is-active');
        mobileToggle.setAttribute('aria-expanded', 'false');
        mobileToggle.setAttribute('aria-label', 'Open menu');
        document.body.style.overflow = '';
      }

      function toggleDrawer() {
        if (nav && nav.classList.contains('open')) {
          closeDrawer();
        } else {
          openDrawer();
        }
      }

      if (mobileToggle) {
        mobileToggle.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          toggleDrawer();
        });
      }

      /* Overlay click closes drawer */
      if (drawerOverlay) {
        drawerOverlay.addEventListener('click', closeDrawer);
      }

      /* Auto-close drawer when resized past mobile breakpoint */
      window.addEventListener('resize', function() {
        if (window.innerWidth > 1100) {
          closeDrawer();
        }
      });

      /* ── Mobile Accordion for dropdown nav items ───────────── */
      if (nav) {
        const dropdownItems = nav.querySelectorAll('.nav-item.has-dropdown');
        dropdownItems.forEach(item => {
          const link = item.querySelector('.nav-link');
          if (link) {
            link.addEventListener('click', function(e) {
              if (window.innerWidth <= 1100) {
                if (!item.classList.contains('is-open')) {
                  e.preventDefault();
                  dropdownItems.forEach(other => {
                    if (other !== item) {
                      other.classList.remove('is-open');
                      const otherLink = other.querySelector('.nav-link');
                      if (otherLink) otherLink.setAttribute('aria-expanded', 'false');
                    }
                  });
                  item.classList.add('is-open');
                  link.setAttribute('aria-expanded', 'true');
                } else {
                  /* Second click on open accordion → toggle close */
                  e.preventDefault();
                  item.classList.remove('is-open');
                  link.setAttribute('aria-expanded', 'false');
                }
              }
            });
          }
        });

        /* Close drawer when a real nav link is clicked (non-dropdown) */
        nav.querySelectorAll('.nav-link, .nav-dropdown-link').forEach(link => {
          link.addEventListener('click', function(e) {
            if (window.innerWidth <= 1100 && !link.closest('.has-dropdown > .nav-link') && !e.defaultPrevented) {
              closeDrawer();
            }
          });
        });
      }

      /* ── Search Modal ────────────────────────────────────────── */
      if (searchTriggers.length && searchOverlay) {
        searchTriggers.forEach(btn => {
          btn.addEventListener('click', function(e) {
            e.preventDefault();
            closeDrawer(); /* close drawer if open before opening search */
            searchOverlay.classList.add('open');
            if (searchInput) {
              setTimeout(() => searchInput.focus(), 100);
            }
          });
        });
      }

      if (searchClose && searchOverlay) {
        searchClose.addEventListener('click', function() {
          searchOverlay.classList.remove('open');
        });
      }

      if (searchOverlay) {
        searchOverlay.addEventListener('click', function(e) {
          if (e.target === searchOverlay) {
            searchOverlay.classList.remove('open');
          }
        });
      }

      /* ── Escape key closes drawer & search ───────────────────── */
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          if (nav && nav.classList.contains('open')) {
            closeDrawer();
          }
          if (searchOverlay && searchOverlay.classList.contains('open')) {
            searchOverlay.classList.remove('open');
          }
        }
      });

      /* ── Smart Sticky Header on scroll (matching reference site) ───── */
      let lastScrollY = window.scrollY;
      const headerGroup = document.querySelector('.shopify-section-group-header-group') || document.querySelector('.site-top-shell');

      function onHeaderScroll() {
        if (!headerGroup) return;

        /* Always sticky on mobile (screen <= 1100px) */
        if (window.innerWidth <= 1100) {
          headerGroup.classList.remove('is-hidden', 'is-pinned');
          return;
        }

        const currentY = window.scrollY;
        const isSearchOpen = searchOverlay && searchOverlay.classList.contains('open');
        const isNavOpen = nav && nav.classList.contains('open');

        /* When drawer or search is open, keep header visible & pinned */
        if (isSearchOpen || isNavOpen) {
          headerGroup.classList.add('is-pinned');
          headerGroup.classList.remove('is-hidden');
          lastScrollY = currentY;
          return;
        }

        /* At the top of page (scrollY <= 20px) -> return to normal static flow */
        if (currentY <= 20) {
          headerGroup.classList.remove('is-pinned', 'is-hidden');
          lastScrollY = currentY;
          return;
        }

        const diff = currentY - lastScrollY;
        if (Math.abs(diff) < 4) return;

        if (diff > 0 && currentY > 100) {
          /* Scrolling DOWN -> hide header smoothly */
          headerGroup.classList.add('is-pinned', 'is-hidden');
        } else if (diff < 0) {
          /* Scrolling UP -> reveal pinned sticky header smoothly */
          headerGroup.classList.add('is-pinned');
          headerGroup.classList.remove('is-hidden');
        }

        lastScrollY = currentY;
      }

      window.addEventListener('scroll', onHeaderScroll, { passive: true });
      onHeaderScroll();

      /* ── Live update cart count ──────────────────────────────── */
      function updateCartCount() {
        fetch('/cart.js')
          .then(res => res.json())
          .then(cart => {
            document.querySelectorAll('.js-cart-count').forEach(el => {
              el.textContent = cart.item_count || 0;
            });
          })
          .catch(() => {});
      }
      document.addEventListener('cart:updated', updateCartCount);

      /* ── Live update wishlist count ──────────────────────────── */
      function updateWishlistCount() {
        try {
          const list = JSON.parse(localStorage.getItem('riseon_wishlist') || '[]');
          document.querySelectorAll('.js-wishlist-count').forEach(el => {
            el.textContent = Array.isArray(list) ? list.length : 0;
          });
        } catch(err) {}
      }
      updateWishlistCount();
      window.addEventListener('storage', updateWishlistCount);
      document.addEventListener('wishlist:updated', updateWishlistCount);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeader);
    } else {
      initHeader();
    }
    document.addEventListener('shopify:section:load', initHeader);
  })();
</script>

{% schema %}
{
  "name": "Header",
  "class": "header-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search Placeholder Text",
      "default": "Search lightweight rings, earrings, pendants…"
    },
    {
      "type": "url",
      "id": "partner_link",
      "label": "Partner Link"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Action Icon Color",
      "default": "#c9a15b"
    },
    {
      "type": "color",
      "id": "icon_hover_color",
      "label": "Action Icon Hover Color",
      "default": "#f5e4bd"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Action Label Color",
      "default": "#f7eada"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge Background Color",
      "default": "#c9a15b"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge Text Color",
      "default": "#290018"
    },
    {
      "type": "color",
      "id": "nav_bg",
      "label": "Navigation Background",
      "default": "#fffaf7"
    },
    {
      "type": "color",
      "id": "nav_link_color",
      "label": "Navigation Link Color",
      "default": "#252124"
    },
    {
      "type": "color",
      "id": "nav_hover_color",
      "label": "Navigation Hover Color",
      "default": "#4e032e"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_header",
      "label": "Enable Sticky Header",
      "default": true
    }
  ]
}
{% endschema %}
