                      </ul>
                    {% endif %}
                  </div>
                {% endfor %}

                {% for block in section.blocks %}
                  {% if block.type == 'mega_menu_image' %}
                    {% if block.settings.menu_name == link.title %}
                      {% for i in (1..3) %}
                        {% capture img_id %}image_{{ i }}{% endcapture %}
                        {% capture title_id %}title_{{ i }}{% endcapture %}
                        {% capture link_id %}link_{{ i }}{% endcapture %}
                        {% assign current_img = block.settings[img_id] %}
                        {% assign current_title = block.settings[title_id] %}
                        {% assign current_link = block.settings[link_id] %}
                        
                        {% if current_img != blank %}
                          <div class="header__mega-menu-column mega-menu-image-column" style="grid-column: span {{ block.settings.image_column_width | default: 1 }};">
                            <a href="{{ current_link | default: '#' }}" class="mega-menu-image-link">
                              <div class="mega-menu-image-wrapper" style="border-radius: {{ block.settings.border_radius }}px; margin-bottom: 10px;">
                                <img 
                                  src="{{ current_img | image_url: width: 400 }}" 
                                  alt="{{ current_img.alt | default: current_title }}"
                                  class="mega-menu-image"
                                  width="400"
                                  height="auto"
                                  loading="lazy"
                                >
                                {% if current_title != blank %}
                                  <span class="mega-menu-image-title">{{ current_title }}</span>
                                {% endif %}
                              </div>
                            </a>
                          </div>
                        {% endif %}
                      {% endfor %}
                    {% endif %}
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          {% elsif link.links != blank %}
            <div class="header__dropdown-menu">
              <ul class="header__dropdown-list">
                {% for child_link in link.links %}
                  <li class="{% if child_link.links != blank %}header__dropdown-item--has-sublist{% endif %}">
                    <a href="{{ child_link.url }}" class="header__dropdown-link">
                      {{ child_link.title }}
                      {% if child_link.links != blank %}
                        <span class="header__dropdown-arrow" aria-hidden="true">›</span>
                      {% endif %}
                    </a>
                    {% if child_link.links != blank %}
                      <ul class="header__dropdown-sublist">
                        {% for grandchild_link in child_link.links %}
                          <li>
                            <a href="{{ grandchild_link.url }}" class="header__dropdown-link">
                              {{ grandchild_link.title }}
                            </a>
                          </li>
                        {% endfor %}
                      </ul>
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </nav>
    <div class="header__icons">
      {% render 'header-localization' %}
      {% if icon_order == 'custom_order' %}
        {% if settings.show_search_icon %}
          {% render 'icon-search-modal' %}
        {% endif %}
        {% render 'header-wishlist' %}
          {% render 'header-cart' %}
        {% if shop.customer_accounts_enabled %}
         {% render 'header-account' %}
        {% endif %}
      {% elsif icon_order == 'search_first' %}
        {% if settings.show_search_icon %}
          {% render 'icon-search-modal' %}
        {% endif %}
        {% if shop.customer_accounts_enabled %}
          {% render 'header-account' %}
        {% endif %}
        {% render 'header-wishlist' %}
        {% render 'header-cart' %}
      {% else %}
        {% if shop.customer_accounts_enabled %}
          {% render 'header-account' %}
        {% endif %}
        {% if settings.show_search_icon %}
          {% render 'icon-search-modal' %}
        {% endif %}
        {% render 'header-wishlist' %}
        {% render 'header-cart' %}
        {% endif %}
      </div>
    </div>
  {% endif %}
  </div>
</header>
</div>
{% if settings.show_search_icon %}
<div class="header__search-popup" data-search-popup data-popular-products-search-term="{{ section.settings.popular_products_search_term | default: 'kurti' | escape }}" data-popular-products-count="{{ section.settings.popular_products_count | default: 8 }}" data-money-format="{{ shop.money_format | escape }}">
  <div class="header__search-popup-overlay" data-search-close></div>
  <div class="header__search-popup-content color-{{ section.settings.color_scheme }}">
    <button class="header__search-popup-close" aria-label="Close search" data-search-close>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
    <div class="container_width">
      <h2 class="header__search-popup-title">Search Our Site</h2>
      <form action="{{ routes.search_url }}" method="get" class="header__search-popup-form">
      <div class="header__search-popup-input-wrapper">
        <input 
          type="search" 
          name="q" 
          placeholder="i'm look...." 
          class="header__search-popup-input"
          autocomplete="off"
          data-search-input
        >
        <button type="button" class="header__search-popup-clear" aria-label="Clear search" data-search-clear style="display: none;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6L6 18M6 6l12 12"/>
          </svg>
        </button>
        <button type="submit" class="header__search-popup-submit" aria-label="{{ 'general.search.search' | t }}">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <use href="#icon-search"></use>
          </svg>
        </button>
      </div>
    </form>
    
    {% if section.settings.show_trending_searches %}
      <div class="header__search-trending" data-trending-search-wrapper>
       <h3 class="header__search-trending-title">Trending Search</h3>
        <div class="header__search-recent-wrapper">
          <div class="header__search-recent-tags" data-recent-searches-container>
          </div>
          <button type="button" class="header__search-clear-all" aria-label="Clear all searches" data-clear-all-searches style="display: none;">
            Clear All
          </button>
        </div>
      </div>
    {% endif %}
    
    {% if section.settings.show_popular_products %}
      <div class="header__search-popular" data-popular-products-wrapper>
        <h3 class="header__search-popular-title" data-popular-products-title>Related Products</h3>
        <div class="header__search-popular-slider-wrapper swiper">
          <div class="header__search-popular-products swiper-wrapper" data-search-related-products>
            {% comment %} Products will be loaded dynamically via JavaScript based on search query {% endcomment %}
          </div>
          <button class="header__search-popular-arrow header__search-popular-arrow--prev" aria-label="Previous products" type="button" data-search-arrow-prev>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M15 18L9 12L15 6"/>
            </svg>
          </button>
          <button class="header__search-popular-arrow header__search-popular-arrow--next" aria-label="Next products" type="button" data-search-arrow-next>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 18L15 12L9 6"/>
            </svg>
          </button>
        </div>
      </div>
    {% endif %}
    </div>
  </div>
</div>
{% endif %}

{% if enable_mobile_drawer %}
<div class="header__mobile-drawer" data-mobile-drawer>
  <div class="header__mobile-drawer-overlay" data-mobile-drawer-close></div>
  <div class="header__mobile-drawer-content color-{{ section.settings.color_scheme }}">
    <div class="header__mobile-drawer-header">
      {% if logo != blank %}
        <a href="{{ routes.root_url }}" class="header__logo-link">
          <img 
            src="{{ logo | image_url: width: 150 }}" 
            alt="{{ logo.alt | default: shop.name }}"
            class="header__logo header__logo--mobile"
            width="{{ logo.width }}"
            height="{{ logo.height }}"
            loading="eager"
          >
        </a>
      {% else %}
        <h3>{{ shop.name }}</h3>
      {% endif %}
      <button class="header__mobile-drawer-close" aria-label="Close menu" data-mobile-drawer-close>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <nav class="header__mobile-menu" role="navigation">
      {% for link in section.settings.menu.links %}
        <div class="header__mobile-menu-item{% if link.links != blank %} header__mobile-menu-item--has-children{% endif %}">
          <a href="{{ link.url }}" class="header__mobile-menu-link" style="color: {{ menu_font_color_mobile }};" onmouseover="this.style.backgroundColor='{{ menu_hover_bg_mobile }}'; this.style.color='{{ menu_hover_color_mobile }}';" onmouseout="this.style.backgroundColor=''; this.style.color='{{ menu_font_color_mobile }}';">
            <span class="header__mobile-menu-link-content">
              
              <span class="header__mobile-menu-text" style="font-size: {{ section.settings.menu_font_size_mobile | default: 16 }}px;">{{ link.title }}</span>
            </span>
            {% if link.links != blank %}
              <svg class="header__mobile-menu-arrow" width="8" height="12" viewBox="0 0 8 12" fill="none" aria-hidden="true">
                <path d="M1 1L7 6L1 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {% endif %}
          </a>
          {% if link.links != blank %}
            <div class="header__mobile-menu-children-wrapper">
              <ul class="header__mobile-menu-children">
                {% for child_link in link.links %}
                  <li class="{% if child_link.links != blank %}header__mobile-menu-item--has-children{% endif %}">
                    <a href="{{ child_link.url }}" class="header__mobile-menu-link" style="color: {{ menu_font_color_mobile }};" onmouseover="this.style.backgroundColor='{{ menu_hover_bg_mobile }}'; this.style.color='{{ menu_hover_color_mobile }}';" onmouseout="this.style.backgroundColor=''; this.style.color='{{ menu_font_color_mobile }}';">
                      <span class="header__mobile-menu-link-content">
                        
                        <span class="header__mobile-menu-text" style="font-size: {{ section.settings.menu_font_size_mobile | default: 16 }}px;">{{ child_link.title }}</span>
                      </span>
                      {% if child_link.links != blank %}
                        <svg class="header__mobile-menu-arrow" width="8" height="12" viewBox="0 0 8 12" fill="none" aria-hidden="true">
                          <path d="M1 1L7 6L1 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      {% endif %}
                    </a>
                    {% if child_link.links != blank %}
                      <div class="header__mobile-menu-children-wrapper">
                        <ul class="header__mobile-menu-children2">
                          {% for grandchild_link in child_link.links %}
                            {% liquid
                              assign menu_image = ''
                              assign menu_border_radius = 0
                              assign item_index = forloop.index0
                              for block in section.blocks
                                if block.type == 'menu_images'
                                  assign block_matches = false
                                  assign menu_title_field = block.settings.menu_title | strip
                                  if menu_title_field contains '-'
                                    assign title_parts = menu_title_field | split: '-'
                                    assign main_menu_title = title_parts[0] | strip
                                    assign mega_menu_title = ''
                                    assign parts_count = title_parts.size | minus: 1
                                    for i in (1..parts_count)
                                      assign part_index = i
                                      if mega_menu_title == blank
                                        assign mega_menu_title = title_parts[part_index]
                                      else
                                        assign mega_menu_title = mega_menu_title | append: '-' | append: title_parts[part_index]
                                      endif
                                    endfor
                                    assign mega_menu_title = mega_menu_title | strip
                                    if main_menu_title == link.title and mega_menu_title == child_link.title
                                      assign block_matches = true
                                    endif
                                  elsif menu_title_field == child_link.title
                                    assign block_matches = true
                                  endif
                                  if block_matches
                                    assign menu_border_radius = block.settings.border_radius | default: 0
                                    assign image_index = item_index | modulo: 15
                                    if image_index == 0 and block.settings.image_1 != blank
                                      assign menu_image = block.settings.image_1
                                    elsif image_index == 1 and block.settings.image_2 != blank
                                      assign menu_image = block.settings.image_2
                                    elsif image_index == 2 and block.settings.image_3 != blank
                                      assign menu_image = block.settings.image_3
                                    elsif image_index == 3 and block.settings.image_4 != blank
                                      assign menu_image = block.settings.image_4
                                    elsif image_index == 4 and block.settings.image_5 != blank
                                      assign menu_image = block.settings.image_5
                                    elsif image_index == 5 and block.settings.image_6 != blank
                                      assign menu_image = block.settings.image_6
                                    elsif image_index == 6 and block.settings.image_7 != blank
                                      assign menu_image = block.settings.image_7
                                    elsif image_index == 7 and block.settings.image_8 != blank
                                      assign menu_image = block.settings.image_8
                                    elsif image_index == 8 and block.settings.image_9 != blank
                                      assign menu_image = block.settings.image_9
                                    elsif image_index == 9 and block.settings.image_10 != blank
                                      assign menu_image = block.settings.image_10
                                    elsif image_index == 10 and block.settings.image_11 != blank
                                      assign menu_image = block.settings.image_11
                                    elsif image_index == 11 and block.settings.image_12 != blank
                                      assign menu_image = block.settings.image_12
                                    elsif image_index == 12 and block.settings.image_13 != blank
                                      assign menu_image = block.settings.image_13
                                    elsif image_index == 13 and block.settings.image_14 != blank
                                      assign menu_image = block.settings.image_14
                                    elsif image_index == 14 and block.settings.image_15 != blank
                                      assign menu_image = block.settings.image_15
                                    endif
                                    break
                                  endif
                                endif
                              endfor
                            -%}
                            <li>
                              <a href="{{ grandchild_link.url }}" class="header__mobile-menu-link" style="color: {{ menu_font_color_mobile }};" onmouseover="this.style.backgroundColor='{{ menu_hover_bg_mobile }}'; this.style.color='{{ menu_hover_color_mobile }}';" onmouseout="this.style.backgroundColor=''; this.style.color='{{ menu_font_color_mobile }}';">
                                <span class="header__mobile-menu-link-content">
                                  {% if menu_image != blank %}
                                    <span class="header__mobile-menu-icon-wrapper">
                                      <img 
                                        src="{{ menu_image | image_url: width: 36 }}"
                                        alt="{{ menu_image.alt | default: grandchild_link.title | default: 'Menu Icon' }}"
                                        class="header__mobile-menu-icon"
                                        width="35"
                                        height="35"
                                        loading="lazy"
                                        style="border-radius: {{ menu_border_radius }}%;"
                                      >
                                    </span>
                                  {% endif %}
                                  <span class="header__mobile-menu-text" style="font-size: {{ section.settings.menu_font_size_mobile | default: 16 }}px;">{{ grandchild_link.title }}</span>
                                </span>
                              </a>
                            </li>
                          {% endfor %}
                        </ul>
                      </div>
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </nav>
  </div>
</div>
{% endif %}

{% if section.settings.enable_mobile_bottom_nav %}
<div class="mobile-bottom-nav">
    <div class="mobile-bottom-nav__wrapper">
      <a href="{{ routes.root_url }}" class="mobile-bottom-nav__item">
        <div class="mobile-bottom-nav__icon icon-home">
          <svg xmlns="https://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3 9.5L10 3L17 9.5V16C17 16.5523 16.5523 17 16 17H4C3.44772 17 3 16.5523 3 16V9.5Z" />
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M8 17V12H12V17" />
          </svg>
        </div>
        <span class="mobile-bottom-nav__label">Home</span>
      </a>
      <a href="{{ routes.account_url }}" class="mobile-bottom-nav__item">
        <div class="mobile-bottom-nav__icon icon-account">
          {% render 'icon-account' %}
        </div>
        <span class="mobile-bottom-nav__label">Account</span>
      </a>

      {%- if settings.enable_currency_selector and localization.available_countries.size > 1 -%}
        <div class="mobile-bottom-nav__item header-localization" style="padding:0; border:none; background:none;">
          {%- form 'localization', class: 'localization-form', id: 'MobileBottomLocalization' -%}
            <div class="localization-form__select">
              <button type="button" class="mobile-bottom-nav__item-trigger mobile-bottom-nav__item" data-localization-toggle aria-expanded="false" aria-label="Localization" style="width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; background: none; border: none !important; color: inherit;">
                <div class="mobile-bottom-nav__icon icon-localization">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="https://www.w3.org/2000/svg"><path d="M10 19.1666C15.0626 19.1666 19.1667 15.0626 19.1667 9.99992C19.1667 4.93731 15.0626 0.833252 10 0.833252C4.9374 0.833252 0.833344 4.93731 0.833344 9.99992C0.833344 15.0626 4.9374 19.1666 10 19.1666Z" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/><path d="M0.833344 10H19.1667" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/><path d="M10 0.833252C12.3012 3.4839 13.619 6.69178 13.6667 9.99992C13.619 13.3081 12.3012 16.5159 10 19.1666C7.69882 16.5159 6.38101 13.3081 6.33334 9.99992C6.38101 6.69178 7.69882 3.4839 10 0.833252Z" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <span class="mobile-bottom-nav__label" style="font-size: 10px;">{{ cart.currency.iso_code }}</span>
              </button>
              <ul class="localization-form__list" data-localization-list style="bottom: 70px; top: auto; left: 0; right: 0; position: fixed; max-height: 50vh; overflow-y: auto; background: #FEFEFE; border-top: 1px solid #eee; width: 100%; box-shadow: 0 -4px 10px rgba(0,0,0,0.1); z-index: 1001; padding: 0;">
                <div class="localization-form__list-inner" style="max-height: 50vh; padding: 10px 0;">
                  {%- for country in localization.available_countries -%}
                    <li class="localization-form__item" style="display: block; width: 100%;">
                      <a class="localization-form__link" href="#" data-value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}aria-current="true"{% endif %} style="display: block; padding: 10px 20px; color: #333; text-decoration: none; font-size: 14px;">
                        {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                      </a>
                    </li>
                  {%- endfor -%}
                </div>
              </ul>
              <input type="hidden" name="country_code" value="{{ localization.country.iso_code }}">
            </div>
          {%- endform -%}
        </div>
      {%- endif -%}

      <a href="{{ pages[settings.wishlist_page].url | default: routes.root_url }}" class="mobile-bottom-nav__item">
        <div class="mobile-bottom-nav__icon icon-wishlist">
          {{ 'icon-wishlist.svg' | inline_asset_content }}
          <span class="header__wishlist-count" data-wishlist-count>0</span>
        </div>
        <span class="mobile-bottom-nav__label">Wishlist</span>
      </a>
      
    </div>
</div>
{% endif %}




{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "select",
      "id": "header_design",
      "label": "Header Design",
      "options": [
        {
          "value": "design_1",
          "label": "Design 1"
        },
        {
          "value": "design_2",
          "label": "Design 2"
        },
        {
          "value": "design_3",
          "label": "Design 3"
        },
        {
          "value": "design_4",
          "label": "Design 4"
        },
        {
          "value": "design_5",
          "label": "Design 5"
        }
      ],
      "default": "design_1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Upload your store logo. If no logo is uploaded, the shop name will be displayed instead."
    },
      {
      "type": "checkbox",
      "id": "enable_sticky_header",
      "label": "Enable sticky header on scroll",
      "default": true
    },
    {
      "type": "header",
      "content": "Menu Styling (Desktop)"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "header",
      "content": "t:settings.mega_menu"
    },
    {
      "type": "checkbox",
      "id": "enable_mega_menu",
      "label": "t:labels.enable_mega_menu",
      "default": true
    },
    {
      "type": "range",
      "id": "mega_menu_columns",
      "label": "t:labels.mega_menu_columns",
      "min": 2,
      "max": 9,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Mobile Menu"
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_drawer",
      "label": "Enable Mobile Drawer",
      "default": true,
      "info": "Enable mobile drawer menu for mobile devices. When enabled, a hamburger menu will appear on mobile screens."
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_bottom_nav",
      "label": "Enable Mobile Bottom Navigation",
      "default": true
    },
    {
      "type": "header",
      "content": "Search Popup"
    },
    {
      "type": "checkbox",
      "id": "show_trending_searches",
      "label": "Show Trending Searches",
      "default": true,
      "info": "Display trending search tags in the search popup"
    },
    {
      "type": "checkbox",
      "id": "show_popular_products",
      "label": "Show Popular Products",
      "default": true,
      "info": "Display popular products in the search popup"
    },
    {
      "type": "range",
      "id": "popular_products_count",
      "label": "Popular Products Count",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "popular_products_search_term",
      "label": "Popular Products Search Term",
      "info": "The search term used to fetch 'popular' products when the search input is empty"
    },
    {
      "type": "header",
      "content": "Design 5 Settings"
    },
    
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search Placeholder Text",
      "default": "I'm shopping for...."
    },
    {
      "type": "header",
      "content": "Menu Images"
    },
    {
      "type": "paragraph",
      "content": "Add images for menu items. Use format: 'mainmenu-das' (e.g., 'home-demo 1'). This means images will show in 'home' menu under 'demo 1' column. Upload up to 15 images. If you have more than 15 menu items, images will repeat."
    }
  ],
  "blocks": [
    {
      "type": "menu_images",
      "name": "Menu Images",
      "settings": [
        {
          "type": "text",
          "id": "menu_title",
          "label": "Menu Title (Format: Main menu - Mega menu title)",
          "info": "Enter in format: 'main menu-mega menu title' where mainmenu is the main menu title and das is the mega menu column title. Example: 'home-demo 1' means images will show in 'home' menu under 'demo 1' column."
        },
        {
          "type": "range",
          "id": "border_radius",
          "label": "Image Border Radius",
          "min": 0,
          "max": 50,
          "step": 1,
          "unit": "px",
          "default": 0,
          "info": "Set border radius for menu images (0px = square, 50px = circle)"
        },
        {
          "type": "image_picker",
          "id": "image_1",
          "label": "Image 1"
        },
        {
          "type": "image_picker",
          "id": "image_2",
