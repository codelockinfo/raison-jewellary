{% liquid
  assign enable_mega_menu = section.settings.enable_mega_menu
  assign mega_menu_columns = section.settings.mega_menu_columns
  assign enable_mobile_drawer = section.settings.enable_mobile_drawer
  assign header_design = section.settings.header_design | default: 'design_1'
  assign logo = section.settings.logo
  assign icon_order = settings.icon_order | default: 'custom_order'
  assign menu_font_size_desktop = section.settings.menu_font_size_desktop | default: 16
  assign menu_font_size_mobile = section.settings.menu_font_size_mobile | default: 14
  assign menu_font_color_mobile = section.settings.menu_font_color_mobile | default: '#000000'
  assign menu_hover_bg_desktop = section.settings.menu_hover_background_color_desktop | default: 'rgba(0, 0, 0, 0.05)'
  assign menu_hover_bg_mobile = section.settings.menu_hover_background_color_mobile | default: 'rgba(0, 0, 0, 0.05)'
  assign menu_hover_color_desktop = section.settings.menu_hover_font_color_desktop | default: '#000000'
  assign menu_hover_color_mobile = section.settings.menu_hover_font_color_mobile | default: '#000000'
%}

<svg style="display: none;" xmlns="https://www.w3.org/2000/svg">
  <symbol id="icon-arrow-down" viewBox="0 0 10 6" fill="none">
    <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>
  </symbol>
  <symbol id="icon-search" viewBox="0 0 24 24" fill="none">
    <path d="M21 21L15 15M17 10C17 13.866 13.866 17 10 17C6.13401 17 3 13.866 3 10C3 6.13401 6.13401 3 10 3C13.866 3 17 6.13401 17 10Z" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
  </symbol>
</svg>

<div class="header-sticky-wrapper">
<header class="header color-{{ section.settings.color_scheme }}  {% if section.settings.enable_sticky_header %}js-sticky-header{% endif %} header--{{ header_design }}" style="--menu-font-size-desktop: {{ menu_font_size_desktop }}px; --menu-font-size-mobile: {{ menu_font_size_mobile }}px; --menu-hover-background-color-desktop: {{ menu_hover_bg_desktop }}; --menu-hover-font-color-desktop: {{ menu_hover_color_desktop }}; --menu-hover-background-color-mobile: {{ menu_hover_bg_mobile }}; --menu-hover-font-color-mobile: {{ menu_hover_color_mobile }}; --top-bar-background-color: {{ section.settings.top_bar_background_color_design_5 | default: '#228B22' }}; --top-bar-text-color: {{ section.settings.top_bar_text_color_design_5 | default: '#FEFEFE' }};">
  <div class="container_width">
  {% if header_design == 'design_2' %}
    <div class="header__top-row">
      {% if enable_mobile_drawer %}
        <button class="header__mobile-menu-toggle" aria-label="Toggle menu" aria-expanded="false" data-mobile-menu-toggle>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M3 12h18M3 6h18M3 18h18"/>
          </svg>
        </button>
      {% endif %}
      <h2 class="header__title">
        {% if logo != blank %}
          <a href="{{ routes.root_url }}" class="header__logo-link">
            <img src="{{ logo | image_url: width: 200 }}" alt="{{ logo.alt | default: shop.name }}" class="header__logo" width="{{ logo.width }}" height="{{ logo.height }}" loading="eager" fetchpriority="high">
          </a>
        {% else %}
          {{ shop.name | link_to: routes.root_url }}
        {% endif %}
      </h2>
      <div class="header__icons header__icons--mobile">
        {% if icon_order == 'custom_order' %}
          {% if settings.show_search_icon %}
            {% render 'icon-search-modal' %}
          {% endif %}
          {% render 'header-wishlist' %}
          {% render 'header-cart' %}
            {% render 'header-account' %}
        {% elsif icon_order == 'search_first' %}
          {% if settings.show_search_icon %}
            {% render 'icon-search-modal' %}
          {% endif %}
            {% render 'header-account' %}
          {% render 'header-wishlist' %}
          {% render 'header-cart' %}
        {% else %}
            {% render 'header-account' %}
          {% if settings.show_search_icon %}
            {% render 'icon-search-modal' %}
          {% endif %}
          {% render 'header-wishlist' %}
          {% render 'header-cart' %}
        {% endif %}
      </div>
    </div>
    <div class="header__bottom-row">
      <nav class="header__menu header__menu--left" role="navigation" aria-label="{{ 'general.header' | t }}">
        {% for link in section.settings.menu.links %}
          <div class="header__menu-item{% if link.links != blank %} header__menu-item--has-dropdown{% if enable_mega_menu %} header__menu-item--mega-menu{% endif %}{% endif %}">
            <a href="{{ link.url }}" class="header__menu-link">
              {{ link.title }}
              {% if link.links != blank %}
                <svg class="icon-down hidden block-1025 header__menu-arrow" width="10" height="6" aria-hidden="true">
                  <use href="#icon-arrow-down"></use>
                </svg>
              {% endif %}
            </a>

            {% if link.links != blank and enable_mega_menu %}
              <div class="header__mega-menu" data-mega-menu>
                <div class="header__mega-menu-content" style="--columns: {{ mega_menu_columns }}">
                  {% for child_link in link.links %}
                    <div class="header__mega-menu-column">
                      <a href="{{ child_link.url }}" class="header__mega-menu-title">
                        {{ child_link.title }}
                      </a>
                      {% if child_link.links != blank %}
                        <ul class="header__mega-menu-list">
                          {% for grandchild_link in child_link.links %}
                            {% liquid
                              assign menu_image = ''
                              assign menu_border_radius = 0
                              assign item_index = forloop.index0
                              for block in section.blocks
                                if block.type == 'menu_images'
                                  assign block_matches = false
                                  assign menu_title_field = block.settings.menu_title | strip
                                  if menu_title_field contains '-'
                                    assign title_parts = menu_title_field | split: '-'
                                    assign main_menu_title = title_parts[0] | strip
                                    assign mega_menu_title = ''
                                    assign parts_count = title_parts.size | minus: 1
                                    for i in (1..parts_count)
                                      assign part_index = i
                                      if mega_menu_title == blank
                                        assign mega_menu_title = title_parts[part_index]
                                      else
                                        assign mega_menu_title = mega_menu_title | append: '-' | append: title_parts[part_index]
                                      endif
                                    endfor
                                    assign mega_menu_title = mega_menu_title | strip
                                    if main_menu_title == link.title and mega_menu_title == child_link.title
                                      assign block_matches = true
                                    endif
                                  elsif menu_title_field == child_link.title
                                    assign block_matches = true
                                  endif
                                  if block_matches
                                    assign menu_border_radius = block.settings.border_radius | default: 0
                                    assign image_index = item_index | modulo: 15
                                    if image_index == 0 and block.settings.image_1 != blank
                                      assign menu_image = block.settings.image_1
                                    elsif image_index == 1 and block.settings.image_2 != blank
                                      assign menu_image = block.settings.image_2
                                    elsif image_index == 2 and block.settings.image_3 != blank
                                      assign menu_image = block.settings.image_3
                                    elsif image_index == 3 and block.settings.image_4 != blank
                                      assign menu_image = block.settings.image_4
                                    elsif image_index == 4 and block.settings.image_5 != blank
                                      assign menu_image = block.settings.image_5
                                    elsif image_index == 5 and block.settings.image_6 != blank
                                      assign menu_image = block.settings.image_6
                                    elsif image_index == 6 and block.settings.image_7 != blank
                                      assign menu_image = block.settings.image_7
                                    elsif image_index == 7 and block.settings.image_8 != blank
                                      assign menu_image = block.settings.image_8
                                    elsif image_index == 8 and block.settings.image_9 != blank
                                      assign menu_image = block.settings.image_9
                                    elsif image_index == 9 and block.settings.image_10 != blank
                                      assign menu_image = block.settings.image_10
                                    elsif image_index == 10 and block.settings.image_11 != blank
                                      assign menu_image = block.settings.image_11
                                    elsif image_index == 11 and block.settings.image_12 != blank
                                      assign menu_image = block.settings.image_12
                                    elsif image_index == 12 and block.settings.image_13 != blank
                                      assign menu_image = block.settings.image_13
                                    elsif image_index == 13 and block.settings.image_14 != blank
                                      assign menu_image = block.settings.image_14
                                    elsif image_index == 14 and block.settings.image_15 != blank
                                      assign menu_image = block.settings.image_15
                                    endif
                                    break
                                  endif
                                endif
                              endfor
                            %}
                            <li>
                              <a href="{{ grandchild_link.url }}" class="header__mega-menu-link">
                                <div class="image_boxes">
                                {% if menu_image != blank %}
                                  <img 
                                    src="{{ menu_image | image_url: width: 36 }}" 
                                    alt="{{ menu_image.alt | default: grandchild_link.title | default: 'Menu Icon' }}"
                                    class="header__mega-menu-link-icon"
                                    width="36"
                                    height="36"
                                    loading="lazy"
                                    style="border-radius: {{ menu_border_radius }}%;"
                                  >
                                {% endif %}
                                </div>
                                {{ grandchild_link.title }}
                              </a>
                            </li>
                          {% endfor %}
                        </ul>
                      {% endif %}
                    </div>
                  {% endfor %}

                  {% for block in section.blocks %}
                    {% if block.type == 'mega_menu_image' %}
                      {% if block.settings.menu_name == link.title %}
                        {% for i in (1..3) %}
                          {% capture img_id %}image_{{ i }}{% endcapture %}
                          {% capture title_id %}title_{{ i }}{% endcapture %}
                          {% capture link_id %}link_{{ i }}{% endcapture %}
                          {% assign current_img = block.settings[img_id] %}
                          {% assign current_title = block.settings[title_id] %}
                          {% assign current_link = block.settings[link_id] %}
                          
                          {% if current_img != blank %}
                            <div class="header__mega-menu-column mega-menu-image-column" style="grid-column: span {{ block.settings.image_column_width | default: 1 }};">
                              <a href="{{ current_link | default: '#' }}" class="mega-menu-image-link">
                                <div class="mega-menu-image-wrapper" style="border-radius: {{ block.settings.border_radius }}px; margin-bottom: 10px;">
                                  <img 
                                    src="{{ current_img | image_url: width: 400 }}" 
                                    alt="{{ current_img.alt | default: current_title }}"
                                    class="mega-menu-image"
                                    width="400"
                                    height="auto"
                                    loading="lazy"
                                  >
                                  {% if current_title != blank %}
                                    <span class="mega-menu-image-title">{{ current_title }}</span>
                                  {% endif %}
                                </div>
                              </a>
                            </div>
                          {% endif %}
                        {% endfor %}
                      {% endif %}
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            {% elsif link.links != blank %}
              <div class="header__dropdown-menu">
                <ul class="header__dropdown-list">
                  {% for child_link in link.links %}
                    <li class="{% if child_link.links != blank %}header__dropdown-item--has-sublist{% endif %}">
                      <a href="{{ child_link.url }}" class="header__dropdown-link">
                        {{ child_link.title }}
                        {% if child_link.links != blank %}
                          <span class="header__dropdown-arrow" aria-hidden="true">›</span>
                        {% endif %}
                      </a>
                      {% if child_link.links != blank %}
                        <ul class="header__dropdown-sublist">
                          {% for grandchild_link in child_link.links %}
                            <li>
                              <a href="{{ grandchild_link.url }}" class="header__dropdown-link">
                                {{ grandchild_link.title }}
                              </a>
                            </li>
                          {% endfor %}
                        </ul>
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </nav>
      <div class="header__icons header__icons--right">
      {% comment %} {% render 'header-localization' %} {% endcomment %}
        {% if icon_order == 'custom_order' %}
          {% if settings.show_search_icon %}
            {% render 'icon-search-modal' %}
          {% endif %}
          {% render 'header-wishlist' %}
          {% render 'header-cart' %}
            {% render 'header-account' %}
        {% elsif icon_order == 'search_first' %}
          {% if settings.show_search_icon %}
            {% render 'icon-search-modal' %}
          {% endif %}
            {% render 'header-account' %}
          {% render 'header-wishlist' %}
          {% render 'header-cart' %}
        {% else %}
            {% render 'header-account' %}
          {% if settings.show_search_icon %}
            {% render 'icon-search-modal' %}
          {% endif %}
          {% render 'header-wishlist' %}
          {% render 'header-cart' %}
        {% endif %}
      </div>
    </div>
  {% elsif header_design == 'design_3' %}
    <div class="header__top-row">
      {% if enable_mobile_drawer %}
        <button class="header__mobile-menu-toggle" aria-label="Toggle menu" aria-expanded="false" data-mobile-menu-toggle>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M3 12h18M3 6h18M3 18h18"/>
          </svg>
        </button>
      {% endif %}
      <h2 class="header__title">
        {% if logo != blank %}
          <a href="{{ routes.root_url }}" class="header__logo-link">
            <img 
              src="{{ logo | image_url: width: 200 }}" 
              alt="{{ logo.alt | default: shop.name }}"
              class="header__logo"
              width="{{ logo.width }}"
              height="{{ logo.height }}"
              loading="eager"
              fetchpriority="high"
            >
          </a>
        {% else %}
          {{ shop.name | link_to: routes.root_url }}
        {% endif %}
      </h2>
      <div class="header__search-bar header__search-bar--design-3">
        <form action="{{ routes.search_url }}" method="get" class="header__search-form--design-3">
          <input 
            type="search" 
            name="q" 
            value="{{ search.terms | escape }}"
            placeholder="{% if section.settings.search_placeholder != blank %}{{ section.settings.search_placeholder }}{% else %}I'm shopping for....{% endif %}" 
            class="header__search-input--design-3"
            autocomplete="off"
          >
          <button type="submit" class="header__search-button--design-3" aria-label="Search">
            Search
          </button>
        </form>
      </div>
      <div class="header__icons">
      {% comment %} {% render 'header-localization' %} {% endcomment %}
        {% if icon_order == 'custom_order' %}
          {% if settings.show_search_icon %}
            {% render 'icon-search-modal' %}
          {% endif %}
          {% render 'header-wishlist' %}
          {% render 'header-cart' %}
            {% render 'header-account' %}
        {% elsif icon_order == 'search_first' %}
          {% if settings.show_search_icon %}
            {% render 'icon-search-modal' %}
          {% endif %}
            {% render 'header-account' %}
          {% render 'header-wishlist' %}
          {% render 'header-cart' %}
        {% else %}
            {% render 'header-account' %}
          {% if settings.show_search_icon %}
            {% render 'icon-search-modal' %}
          {% endif %}
          {% render 'header-wishlist' %}
          {% render 'header-cart' %}
        {% endif %}
      </div>
    </div>
    <div class="header__bottom-row">
      <h2 class="header__title header__title--mobile-center">
        {% if logo != blank %}
          <a href="{{ routes.root_url }}" class="header__logo-link">
            <img 
