{% liquid
  assign section_class = 'flash-sale-section flash-sale-section--' | append: section.settings.layout
%}


<section
  id="flash-sale-{{ section.id }}"
  class="flash-sale-section color-{{ section.settings.color_scheme }} {{ section_class }}"
  data-start-date="{{ section.settings.start_date }}"
  data-end-date="{{ section.settings.end_date }}"
  style="
    --countdown-value-color: {{ section.settings.countdown_value_color | default: '#FEFEFE' }};
    --countdown-value-color-mobile: {{ section.settings.countdown_value_color_mobile | default: section.settings.countdown_value_color | default: '#FEFEFE' }};
    --countdown-label-color: {{ section.settings.countdown_label_color | default: '#FEFEFE' }};
    --countdown-label-color-mobile: {{ section.settings.countdown_label_color_mobile | default: section.settings.countdown_label_color | default: '#FEFEFE' }};
    --countdown-separator-color: {{ section.settings.countdown_separator_color | default: '#FEFEFE' }};
    --countdown-separator-color-mobile: {{ section.settings.countdown_separator_color_mobile | default: section.settings.countdown_separator_color | default: '#FEFEFE' }};
    --padding-desktop: {{ section.settings.section_padding_desktop }};
    --padding-mobile: {{ section.settings.section_padding_mobile }};
    --overlay-bg-color: {{ section.settings.overlay_bg_color | default: 'rgba(0, 0, 0, 0.7)' }};
    --overlay-bg-color-mobile: {{ section.settings.overlay_bg_color_mobile | default: section.settings.overlay_bg_color | default: 'rgba(0, 0, 0, 0.7)' }};
  ">
  <div class="flash-sale-section__container">
    <div class="flash-sale-section__wrapper">

    {% if section.settings.image %}
      <div class="flash-sale-section__image">
        {% assign loading_strategy = section.settings.lazy_load | default: 'lazy' %}
        {% assign fetch_priority = 'low' %}
        {% if loading_strategy == 'eager' %}
          {% assign fetch_priority = 'high' %}
        {% endif %}
        {% if section.settings.image_mobile %}
          <picture>
            <source media="(max-width: 768px)" srcset="{{ section.settings.image_mobile | image_url: width: 1200 }}">
            <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="{{ section.settings.heading | default: 'Flash Sale' }}" loading="{{ loading_strategy }}" fetchpriority="{{ fetch_priority }}" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}">
          </picture>
        {% else %}
          {{ section.settings.image | image_url: width: 2000 | image_tag: loading: loading_strategy, fetchpriority: fetch_priority, alt: section.settings.heading }}
        {% endif %}
      </div>
    {% endif %}

    {% if section.settings.show_overlay %}
      <div class="flash-sale-section__overlay flash-sale-section__overlay--{{ section.settings.overlay_position | default: 'center' }}">
        <div class="flash-sale-section__content flash-sale-section__content--{{ section.settings.content_position | default: 'left' }}">

          {% if section.settings.heading != blank %}
            <div class="flash-sale-section__overlay-heading" style="color: var(--color-heading);">
                      {% render 'heading-style-banner',
          heading: section.settings.heading,
          heading_tag: section.settings.heading_tag,
          heading_style: section.settings.heading_style,
          heading_alignment: section.settings.heading_alignment,
          wrapper_class: 'flash-sale-section'
        %}
            </div>
          {% endif %}

          <p class="flash-sale-section__overlay-subheading" style="color: var(--color-subtext);">
            {{ section.settings.overlay_subheading }}
          </p>

          {% if section.settings.show_countdown %}
            <div class="flash-sale-section__countdown" data-countdown>
              <div class="countdown-item">
                <span class="countdown-value" data-days style="color: var(--countdown-value-color);">00</span>
                <small class="countdown-label" style="color: var(--countdown-label-color);">Days</small>
              </div>
              <span class="countdown-separator" style="color: var(--countdown-separator-color);">:</span>
              <div class="countdown-item">
                <span class="countdown-value" data-hours style="color: var(--countdown-value-color);">00</span>
                <small class="countdown-label" style="color: var(--countdown-label-color);">Hours</small>
              </div>
              <span class="countdown-separator" style="color: var(--countdown-separator-color);">:</span>
              <div class="countdown-item">
                <span class="countdown-value" data-minutes style="color: var(--countdown-value-color);">00</span>
                <small class="countdown-label" style="color: var(--countdown-label-color);">Minutes</small>
              </div>
              <span class="countdown-separator" style="color: var(--countdown-separator-color);">:</span>
              <div class="countdown-item">
                <span class="countdown-value" data-seconds style="color: var(--countdown-value-color);">00</span>
                <small class="countdown-label" style="color: var(--countdown-label-color);">Seconds</small>
              </div>
            </div>
          {% endif %}

          {% if section.settings.button_text != blank %}
            <a href="{{ section.settings.button_link }}" class="flash-sale-section__button">
              {{ section.settings.button_text }}
            </a>
          {% endif %}

        </div>
      </div>
    {% endif %}
    </div>
  </div>
</section>


{% stylesheet %}
  .flash-sale-section {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding: var(--padding-desktop);
    background-color: transparent
  }

  .flash-sale-section__container {
    width: 100%;
    margin: 0 auto;
    padding: 0;
  }

  .flash-sale-section__wrapper {
    position: relative;
    width: 100%;
    min-height: 500px;
    overflow: visible;
  }

  .flash-sale-section__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .flash-sale-section__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .flash-sale-section img,
  .flash-sale-section picture,
  .flash-sale-section video,
  .flash-sale-section canvas,
  .flash-sale-section svg {
    display: block;
    max-width: 100%;
    height: 100%;
  }



  .flash-sale-section__overlay {
    position: absolute;
    z-index: 2;
    padding: 40px;
    background: var(--overlay-bg-color, rgba(0, 0, 0, 0.7));
    border-radius: 8px;
    min-width: 300px;
    max-width: 500px;
    /* Always vertically center */
    top: 50%;
    /* Reset horizontal positioning - will be set by position classes */
    left: auto;
    right: auto;
  }

  .flash-sale-section__wrapper .flash-sale-section__overlay--left,
  .flash-sale-section__overlay.flash-sale-section__overlay--left {
    left: 5% !important;
    right: auto !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    transform: translateY(-50%) !important;
    -webkit-transform: translateY(-50%) !important;
    -moz-transform: translateY(-50%) !important;
    -ms-transform: translateY(-50%) !important;
  }

  .flash-sale-section__wrapper .flash-sale-section__overlay--center,
  .flash-sale-section__overlay.flash-sale-section__overlay--center {
    left: 50% !important;
    right: auto !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    transform: translate(-50%, -50%) !important;
    -webkit-transform: translate(-50%, -50%) !important;
    -moz-transform: translate(-50%, -50%) !important;
    -ms-transform: translate(-50%, -50%) !important;
  }

  .flash-sale-section__wrapper .flash-sale-section__overlay--right,
  .flash-sale-section__overlay.flash-sale-section__overlay--right {
    right: 5% !important;
    left: auto !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    transform: translateY(-50%) !important;
    -webkit-transform: translateY(-50%) !important;
    -moz-transform: translateY(-50%) !important;
    -ms-transform: translateY(-50%) !important;
  }

  .flash-sale-section__content {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: flex-start;
  }

  .flash-sale-section__content--left {
    align-items: flex-start;
    text-align: left;
  }

  .flash-sale-section__content--left .flash-sale-section__countdown {
    justify-content: flex-start;
  }

  .flash-sale-section__content--center {
    align-items: center;
    text-align: center;
  }

  .flash-sale-section__content--center .flash-sale-section__countdown {
    justify-content: center;
  }

  .flash-sale-section__content--right {
    align-items: flex-end;
    text-align: right;
  }

  .flash-sale-section__content--right .flash-sale-section__countdown {
    justify-content: flex-end;
  }

  .flash-sale-section__overlay-heading {
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
  }

  .flash-sale-section__overlay-subheading {
    margin: 0;
    line-height: 1.5;
  }


  .flash-sale-section__countdown {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .flash-sale-section__countdown .countdown-item {
    display: flex !important;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    padding: 16px 20px;
    border-radius: 8px;
    min-width: 70px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease, background 0.3s ease;
    visibility: visible !important;
    opacity: 1 !important;
  }

  /* Ensure all countdown items are visible */
  .flash-sale-section__countdown [data-days],
  .flash-sale-section__countdown [data-hours],
  .flash-sale-section__countdown [data-minutes],
  .flash-sale-section__countdown [data-seconds] {
    display: block !important;
    visibility: visible !important;
  }

  .flash-sale-section__countdown .countdown-separator {
    display: inline !important;
    visibility: visible !important;
    opacity: 1 !important;
  }

  .countdown-item:hover {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.2);
  }

  .countdown-value {
    font-weight: 700;
    font-size: 24px;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .countdown-label {
    margin-top: 6px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 500;
    font-size: 11px;
  }

  .countdown-separator {
    font-weight: 700;
    padding: 0 2px;
    line-height: 1;
    margin-top: 25px;
    font-size:28px;
  }

  .flash-sale-section__button {
    display: inline-block;
    padding: 14px 32px;
    text-decoration: none;
    border:none !important;
    font-weight: 600;
    transition: all 0.3s ease;
    text-align: center;
    background-color: var(--color-button); 
    color: var(--color-button-text); 
  }

  .flash-sale-section__button:hover {
    opacity: 0.9;
    background-color: var(--color-button-hover);
    color: var(--color-button-text-hover);
  }


  @media (max-width: 768px) {
    .flash-sale-section {
      padding: var(--padding-mobile);
    }

    .flash-sale-section__overlay {
      padding: 24px;
      min-width: auto;
      max-width:90%;
      top: 50% !important;
    }

    .flash-sale-section__overlay--left {
      left: 5% !important;
      right: auto !important;
      transform: translateY(-50%) !important;
    }

    .flash-sale-section__overlay--center {
      left: 50% !important;
      right: auto !important;
      transform: translate(-50%, -50%) !important;
    }

    .flash-sale-section__overlay--right {
      right: 5% !important;
      left: auto !important;
      transform: translateY(-50%) !important;
    }
.flash-sale-section__content {
  gap:0;
}

.flash-sale-section__subheading {
  font-size: var(--sub-heading-font-size-mobile)!important;
}

.flash-sale-section__wrapper .flash-sale-section__overlay--center, .flash-sale-section__overlay.flash-sale-section__overlay--center {
  -webkit-transform: translate(-50%, -50%) !important;
}

.flash-sale-section__countdown .countdown-item{
  padding:10px!important;
}
.flash-sale-section__countdown{
  gap:0 !important;
}
.flash-sale-section__countdown .countdown-item {
  min-width:50px;
}

    .flash-sale-section__overlay {
      background: var(--overlay-bg-color-mobile, var(--overlay-bg-color, rgba(0, 0, 0, 0.7))) !important;
    }

    .flash-sale-section__overlay-heading {
      font-size: var(--overlay-heading-font-size-mobile, 32px) !important;
    }

    .countdown-value {
      color: var(--countdown-value-color-mobile) !important;
    }

    .countdown-label {
      color: var(--countdown-label-color-mobile) !important;
    }

    .countdown-separator {
      color: var(--countdown-separator-color-mobile) !important;
    }

    .flash-sale-section__countdown {
      gap: 8px;
      margin: 15px 0;
    }

    .countdown-item {
      padding: 12px 14px;
      min-width: 55px;
    }

    .countdown-value {
      font-size: 14px !important;
    }

    .countdown-label {
      margin-top: 4px;
      font-size: 9px;
    }

    .countdown-separator {
      font-size: 20px;
    }

    .flash-sale-section__button {
      padding: 12px 24px;
    }

    .flash-sale-section__wrapper {
      min-height: 400px;
    }

    .flash-sale-section__heading-wrapper {
      padding: 15px 0;
      margin-bottom: 15px;
    }
  }

.flash-sale-section__image::after {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 1;
}
{% endstylesheet %}

<script>
(function() {
  'use strict';

  if (window.Shopify && Shopify.designMode && window.flatpickr) {
    flatpickr(
      'input[name="sections[{{ section.id }}][settings][start_date]"]',
      { enableTime: true, dateFormat: "Y-m-d H:i" }
    );

    flatpickr(
      'input[name="sections[{{ section.id }}][settings][end_date]"]',
      { enableTime: true, dateFormat: "Y-m-d H:i" }
    );
  }
  function parseDate(dateStr) {
    // Return null for empty or whitespace-only strings
    if (!dateStr || typeof dateStr !== 'string' || dateStr.trim() === '') {
      return null;
    }
    
    const date = dateStr.trim();
    let timestamp = null;
    
    try {
      // Try parsing as "Y-m-d H:i" format first (e.g., "2024-01-15 14:30")
      if (date.includes(' ') && !date.includes('T')) {
        const parts = date.split(' ');
        if (parts.length < 2) {
          // Try parsing as date only (no time)
          const dateOnly = new Date(date);
          timestamp = dateOnly.getTime();
        } else {
          const [datePart, timePart] = parts;
          const dateComponents = datePart.split('-');
          
          if (dateComponents.length !== 3) {
            return null;
          }
          
          const [year, month, day] = dateComponents.map(Number);
          const timeComponents = (timePart || '0:0').split(':');
          const [hour = 0, minute = 0] = timeComponents.map(Number);
          
          // Validate parsed values
          if (isNaN(year) || isNaN(month) || isNaN(day) || 
              year < 1000 || year > 9999 || 
              month < 1 || month > 12 || 
              day < 1 || day > 31) {
            return null;
          }
          
          // Create date in local timezone
          const dateObj = new Date(year, month - 1, day, hour, minute, 0, 0);
          timestamp = dateObj.getTime();
          
          // Verify the date was created correctly (accounting for month being 0-indexed)
          if (dateObj.getFullYear() !== year || 
              dateObj.getMonth() !== (month - 1) || 
              dateObj.getDate() !== day) {
            return null;
          }
        }
      } else if (date.includes('T')) {
        // ISO format with T separator
        timestamp = new Date(date).getTime();
      } else {
        // Try parsing as date only or other formats
        timestamp = new Date(date).getTime();
      }
      
      if (isNaN(timestamp)) {
        return null;
      }
      
      return timestamp;
    } catch (error) {
      return null;
    }
  }
  function initFlashSale() {
    const section = document.getElementById('flash-sale-{{ section.id }}');
    if (!section) return;

    const startDateStr = section.dataset.startDate;
    const endDateStr = section.dataset.endDate;
    
    const start = parseDate(startDateStr);
    const end = parseDate(endDateStr);
    const now = Date.now();

    // Show section by default (make sure it's visible)
    section.style.display = '';
    section.style.visibility = 'visible';

    // Hide section if before start date (only if start date is set)
    if (start !== null && now < start) {
      section.style.display = 'none';
      return;
    }

    // Hide section if after end date (only if end date is set)
    if (end !== null && now > end) {
      section.style.display = 'none';
      return;
    }

    // Section should be visible - initialize countdown timer if enabled
    const timer = section.querySelector('[data-countdown]');
    if (!timer) {
      // No countdown timer, but section should still be visible
      return;
    }

    // If no end date, don't show countdown
    if (!end) {
      timer.style.display = 'none';
      return;
    }

    // Verify all countdown elements exist
    const allElements = {
      days: timer.querySelector('[data-days]'),
      hours: timer.querySelector('[data-hours]'),
      minutes: timer.querySelector('[data-minutes]'),
      seconds: timer.querySelector('[data-seconds]')
    };

    const missingElements = Object.entries(allElements)
      .filter(([key, el]) => !el)
      .map(([key]) => key);

    // Ensure timer container is visible
    timer.style.display = 'flex';
    timer.style.visibility = 'visible';

    let intervalId = null;

    function updateCountdown() {
      const now = Date.now();
      let diff = end - now;

      // Sale has ended
      if (diff <= 0) {
        if (intervalId) {
          clearInterval(intervalId);
          intervalId = null;
        }
        section.style.display = 'none';
        return;
      }

      // Calculate time units correctly
      const totalSeconds = Math.floor(diff / 1000);
      const days = Math.floor(totalSeconds / 86400);
      const hours = Math.floor((totalSeconds % 86400) / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;

      // Get all countdown elements
      const daysEl = timer.querySelector('[data-days]');
      const hoursEl = timer.querySelector('[data-hours]');
      const minutesEl = timer.querySelector('[data-minutes]');
      const secondsEl = timer.querySelector('[data-seconds]');
      const allItems = timer.querySelectorAll('.countdown-item');
      const allSeparators = timer.querySelectorAll('.countdown-separator');

      // Ensure all items and separators are visible
      allItems.forEach(item => {
        item.style.display = 'flex';
        item.style.visibility = 'visible';
        item.style.opacity = '1';
      });
      
      allSeparators.forEach(sep => {
        sep.style.display = 'inline';
        sep.style.visibility = 'visible';
        sep.style.opacity = '1';
      });

      // Update all countdown values - always update even if 0
      if (daysEl) {
        daysEl.textContent = String(days).padStart(2, '0');
        const daysItem = daysEl.closest('.countdown-item');
        if (daysItem) {
          daysItem.style.display = 'flex';
          daysItem.style.visibility = 'visible';
        }
      } else {
      }

      if (hoursEl) {
        hoursEl.textContent = String(hours).padStart(2, '0');
        const hoursItem = hoursEl.closest('.countdown-item');
        if (hoursItem) {
          hoursItem.style.display = 'flex';
          hoursItem.style.visibility = 'visible';
        }
      } else {
      }

      if (minutesEl) {
        minutesEl.textContent = String(minutes).padStart(2, '0');
        const minutesItem = minutesEl.closest('.countdown-item');
        if (minutesItem) {
          minutesItem.style.display = 'flex';
          minutesItem.style.visibility = 'visible';
        }
      } else {
        
      }

      if (secondsEl) {
        secondsEl.textContent = String(seconds).padStart(2, '0');
        const secondsItem = secondsEl.closest('.countdown-item');
        if (secondsItem) {
          secondsItem.style.display = 'flex';
          secondsItem.style.visibility = 'visible';
        }
      } else {
      }
    }

    // Initial update
    updateCountdown();

    // Update every second
    intervalId = setInterval(updateCountdown, 1000);

    // Cleanup on page unload
    window.addEventListener('beforeunload', function() {
      if (intervalId) {
        clearInterval(intervalId);
      }
    });
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFlashSale);
  } else {
    initFlashSale();
  }

  // Re-initialize on theme editor updates
  if (window.Shopify && Shopify.designMode) {
    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail.sectionId === '{{ section.id }}') {
        initFlashSale();
      }
    });
  }
})();
</script>

{% schema %}
{
  "name": "Flash Sale",
  "tag": "section",
  "class": "flash-sale-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "lazy_load",
      "label": "Image Loading",
      "options": [
        { "value": "lazy", "label": "Lazy" },
        { "value": "eager", "label": "Eager" }
      ],
      "default": "lazy"
    },
        {
      "type": "text",
      "id": "section_padding_desktop",
      "label": "Section Padding Desktop",
      "default": "60px 0 60px 0",
      "info": "e.g., 40px 0px 40px 0px (Top Right Bottom Left)"
    },
    {
      "type": "text",
      "id": "section_padding_mobile",
      "label": "Section Padding Mobile",
      "default": "40px 0 40px 0",
      "info": "e.g., 40px 0px 40px 0px (Top Right Bottom Left)"
    },
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Background Image (Mobile)",
      "info": "Optional: Use a different image for mobile devices"
    },
    {
      "type": "header",
      "content": "Overlay Settings"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show Overlay",
      "default": true
    },
    {
      "type": "select",
      "id": "overlay_position",
      "label": "Overlay Position",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content Position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "info": "Text alignment inside the overlay"
    },
    {
      "type": "color",
      "id": "overlay_bg_color",
      "label": "Overlay Background Color (Desktop)",
      "default": "rgba(0,0,0,0.7)",
      "alpha": true,
      "info": "Background color for the overlay box. Adjust opacity for transparency (default: 70% opacity)."
    },
    {
      "type": "color",
