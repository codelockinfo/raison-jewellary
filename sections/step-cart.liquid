{% liquid
  assign show_header = section.settings.show_header
  assign logo = section.settings.logo
  assign logo_width = section.settings.logo_width | default: 156
  assign show_security_badge = section.settings.show_security_badge
  assign security_badge_text = section.settings.security_badge_text | default: '🔒 100% secure checkout'
  assign show_stepper = section.settings.show_stepper
  assign hide_theme_header = section.settings.hide_theme_header
  assign hide_theme_footer = section.settings.hide_theme_footer
%}

{%- style -%}
  :root {
    --wine: #4e032e;
    --deep: #290018;
    --gold: #c9a15b;
    --soft: #e5c98c;
    --ivory: #faf7f2;
    --ink: #252124;
    --muted: #756d72;
    --line: #eadfd9;
  }

  {%- if hide_theme_header -%}
    body:has(#StepCartSection) .site-top-shell,
    body:has(#StepCartSection) .announcement,
    body:has(#StepCartSection) .header,
    body:has(#StepCartSection) .nav {
      display: none !important;
    }
  {%- endif -%}

  {%- if hide_theme_footer -%}
    body:has(#StepCartSection) footer,
    body:has(#StepCartSection) .footer,
    body:has(#StepCartSection) .footer-main,
    body:has(#StepCartSection) .popular,
    body:has(#StepCartSection) .legal {
      display: none !important;
    }
  {%- endif -%}

  .smart-checkout {
    color: #31262b;
    background: #f8f4f1;
    min-height: 100vh;
    font-family: var(--font-mulish), Mulish, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    padding-bottom: 60px;
  }

  .smart-checkout * {
    box-sizing: border-box;
  }

  .smart-checkout-header {
    background: #fff;
    border-bottom: 1px solid #eadfd9;
    justify-content: space-between;
    align-items: center;
    height: 82px;
    padding: 0 max(24px, 50vw - 640px);
    display: flex;
  }

  .smart-checkout-header a.smart-logo-wrap {
    width: {{ logo_width }}px;
    display: block;
    line-height: 1;
  }

  .smart-checkout-header img {
    object-fit: contain;
    width: 100%;
    height: 54px;
    display: block;
  }

  .smart-checkout-header span.smart-header-security {
    color: #65595e;
    letter-spacing: .04em;
    font-size: 12px;
    font-weight: 500;
  }

  .smart-steps {
    display: none !important;
  }

  .smart-checkout-shell {
    grid-template-columns: minmax(0, 1fr) 360px;
    align-items: start;
    gap: 26px;
    width: min(1180px, 100% - 40px);
    margin: 36px auto 70px;
    display: grid;
  }

  .smart-checkout-main, 
  .smart-summary {
    background: #fff;
    border: 1px solid #eadfd9;
  }

  .smart-checkout-main {
    padding: 32px;
  }

  .smart-title {
    border-bottom: 1px solid #eee6e1;
    justify-content: space-between;
    align-items: flex-start;
    gap: 18px;
    padding-bottom: 22px;
    display: flex;
  }

  .smart-title span {
    color: var(--wine);
    letter-spacing: .14em;
    font-size: 10px;
    font-weight: 700;
    display: block;
    text-transform: uppercase;
  }

  .smart-title h1 {
    margin: 5px 0 0;
    font-family: var(--font-heading--family, var(--font-mulish, 'Mulish', sans-serif));
    font-size: 34px;
    line-height: 1.05;
    font-weight: 600;
    color: #351c28;
  }

  .smart-title > small {
    color: #8a7f84;
    font-size: 11px;
  }

  .smart-cart-item {
    border-bottom: 1px solid #eee6e1;
    grid-template-columns: 150px minmax(0, 1fr) auto;
    gap: 22px;
    padding: 26px 0;
    display: grid;
    position: relative;
    align-items: start;
  }

  .smart-cart-image {
    background: #fbf8f6;
    height: 150px;
    display: block;
    overflow: hidden;
  }

  .smart-cart-image img {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  .smart-cart-copy > span {
    color: #9a7b45;
    letter-spacing: .1em;
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    display: block;
  }

  .smart-cart-copy h2 {
    margin: 7px 0 8px;
    font-family: var(--font-heading--family, var(--font-mulish, 'Mulish', sans-serif));
    font-size: 20px;
    line-height: 1.2;
    font-weight: 600;
  }

  .smart-cart-copy h2 a {
    color: #351c28;
    text-decoration: none;
    transition: color 0.2s;
  }

  .smart-cart-copy h2 a:hover {
    color: var(--wine);
  }

  .smart-cart-copy p, 
  .smart-cart-copy > small {
    color: #74696e;
    margin: 0;
    font-size: 12px;
    line-height: 1.6;
    display: block;
  }

  .smart-item-actions {
    align-items: center;
    gap: 18px;
    margin-top: 18px;
    display: flex;
  }

  .smart-item-actions label {
    font-size: 11px;
    display: inline-flex;
    align-items: center;
    color: #31262b;
  }

  .smart-item-actions select {
    background: #fff;
    border: 1px solid #ddcfca;
    margin-left: 7px;
    padding: 7px 25px 7px 8px;
    font-size: 12px;
    color: #31262b;
    cursor: pointer;
    border-radius: 2px;
    outline: none;
  }

  .smart-item-actions select:focus {
    border-color: var(--wine);
  }

  .smart-item-actions button.smart-remove-btn {
    color: var(--wine);
    background: transparent;
    border: 0 !important;
    font-size: 11px;
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
    transition: opacity 0.2s;
  }

  .smart-item-actions button.smart-remove-btn:hover {
    opacity: 0.75;
  }

  .smart-item-price {
    text-align: right;
  }

  .smart-item-price strong {
    font-size: 17px;
    font-weight: 700;
    color: #351c28;
    display: block;
  }

  .smart-item-price del {
    color: #a19599;
    margin-top: 5px;
    font-size: 11px;
    display: block;
  }

  .smart-promises {
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    padding: 22px 0;
    display: grid;
  }

  .smart-promises span {
    color: #5f5358;
    text-align: center;
    border: 1px solid #eee6e1;
    justify-content: center;
    align-items: center;
    gap: 8px;
    min-height: 58px;
    padding: 10px;
    font-size: 10px;
    display: flex;
    font-weight: 500;
  }

  .smart-promises b {
    color: var(--gold);
    font-size: 16px;
    font-weight: 700;
  }

  .smart-code {
    padding-top: 2px;
  }

  .smart-code label {
    margin-bottom: 8px;
    font-size: 11px;
    font-weight: 700;
    display: block;
    color: #31262b;
  }

  .smart-code > div {
    grid-template-columns: 1fr 90px;
    max-width: 440px;
    display: grid;
  }

  .smart-code input {
    border: 1px solid #ddcfca;
    height: 42px;
    padding: 0 12px;
    font-size: 13px;
    color: #31262b;
    outline: none;
    border-radius: 2px 0 0 2px;
  }

  .smart-code input:focus {
    border-color: var(--wine);
  }

  .smart-code button {
    color: var(--wine);
    background: #efe7e2;
    border: 0;
    font-weight: 700;
    font-size: 12px;
    cursor: pointer;
    border-radius: 0 2px 2px 0;
    transition: background 0.2s;
  }

  .smart-code button:hover {
    background: #e3d5ce;
  }

  .smart-code small {
    color: #756a6f;
    margin-top: 7px;
    font-size: 11px;
    display: block;
  }

  .smart-summary {
    padding: 27px;
    position: sticky;
    top: 20px;
  }

  .smart-summary h2 {
    margin: 0 0 22px;
    font-family: var(--font-heading--family, var(--font-mulish, 'Mulish', sans-serif));
    font-size: 22px;
    line-height: 1.1;
    font-weight: 600;
    color: #351c28;
  }

  .smart-summary > div {
    color: #71666b;
    justify-content: space-between;
    gap: 18px;
    padding: 8px 0;
    font-size: 12px;
    display: flex;
  }

  .smart-summary .free {
    color: #2d6c4c;
    font-weight: 700;
  }

  .smart-summary .smart-total {
    border-top: 1px solid #ded2cc;
    border-bottom: 1px solid #ded2cc;
    align-items: center;
    margin-top: 12px;
    padding: 18px 0;
  }

  .smart-total span {
    color: #382d32;
    flex-direction: column;
    font-weight: 700;
    display: flex;
  }

  .smart-total small {
    color: #8e8388;
    margin-top: 4px;
    font-size: 9px;
    font-weight: 400;
  }

  .smart-total strong {
    color: var(--wine);
    font-size: 20px;
    font-weight: 700;
  }

  .smart-primary {
    border: 1px solid var(--wine);
    background: var(--wine);
    color: #fff;
    letter-spacing: .08em;
    text-transform: uppercase;
    width: 100%;
    min-height: 50px;
    margin-top: 20px;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }

  .smart-primary:hover {
    background: var(--deep);
    border-color: var(--deep);
  }

  .smart-security {
    color: #7b7075;
    margin: 16px 0 0;
    font-size: 10px !important;
    line-height: 1.6;
  }

  .smart-help {
    border-top: 1px solid #eee6e1;
    flex-direction: column;
    gap: 5px !important;
    margin-top: 17px !important;
    padding-top: 17px !important;
    display: flex;
  }

  .smart-help b {
    color: #3d3237;
    font-size: 11px;
  }

  .smart-help span, 
  .smart-help a {
    color: var(--wine);
    font-weight: 600;
    font-size: 12px;
    text-decoration: none;
  }


  .smart-empty {
    text-align: center;
    background: #fff;
    border: 1px solid #eadfd9;
    width: min(620px, 100% - 40px);
    margin: 90px auto;
    padding: 60px 30px;
  }

  .smart-empty > span {
    color: var(--gold);
    font-size: 46px;
    display: block;
    line-height: 1;
  }

  .smart-empty h1 {
    font-family: var(--font-heading--family, var(--font-mulish, 'Mulish', sans-serif));
    font-size: 36px;
    line-height: 1.1;
    font-weight: 600;
    margin: 16px 0 10px;
    color: #351c28;
  }

  .smart-empty p {
    color: #756a6f;
    line-height: 1.7;
    max-width: 440px;
    margin: 0 auto;
    font-size: 13px;
  }

  .smart-empty a {
    background: var(--wine);
    color: #fff;
    text-transform: uppercase;
    letter-spacing: .09em;
    margin-top: 24px;
    padding: 15px 25px;
    font-size: 10px;
    font-weight: 700;
    display: inline-flex;
    text-decoration: none;
    transition: background 0.2s;
  }

  .smart-empty a:hover {
    background: var(--deep);
  }

  /* Responsive */
  @media (max-width: 820px) {
    .smart-checkout-header {
      height: 68px;
      padding: 0 18px;
    }
    .smart-checkout-header a.smart-logo-wrap {
      width: 125px;
    }
    .smart-checkout-header span.smart-header-security {
      font-size: 10px;
    }
    .smart-checkout-shell {
      grid-template-columns: 1fr;
      width: min(100% - 24px, 680px);
      margin-bottom: 30px;
    }
    .smart-summary {
      grid-row: 1;
      padding: 20px;
      position: static;
    }
    .smart-checkout-main {
      padding: 22px;
    }
    .smart-cart-item {
      grid-template-columns: 105px 1fr;
      gap: 14px;
    }
    .smart-cart-image {
      height: 112px;
    }
    .smart-item-price {
      text-align: left;
      grid-column: 2;
      margin-top: -15px;
    }
    .smart-promises, 
    .smart-form-grid {
      grid-template-columns: 1fr;
    }
    .smart-form-grid label.wide {
      grid-column: auto;
    }
    .smart-title h1 {
      font-size: 29px;
    }
  }

  @media (max-width: 480px) {
    .smart-checkout-header span.smart-header-security {
      font-size: 0;
    }
    .smart-checkout-header span.smart-header-security:after {
      content: "🔒 Secure";
      font-size: 10px;
    }
    .smart-steps {
      margin: 18px auto 24px;
    }
    .smart-checkout-main {
      padding: 18px 15px;
    }
    .smart-summary {
      padding: 18px;
    }
    .smart-cart-item {
      grid-template-columns: 92px 1fr;
    }
    .smart-cart-image {
      height: 100px;
    }
    .smart-cart-copy h2 {
      font-size: 21px;
    }
    .smart-cart-copy p {
      font-size: 10px;
    }
    .smart-item-actions {
      margin-top: 11px;
    }
    .smart-title {
      align-items: flex-end;
    }
    .smart-title h1 {
      font-size: 27px;
    }
    .smart-title > small {
      font-size: 9px;
    }
  }
{%- endstyle -%}

<div class="smart-checkout" id="StepCartSection" 
     data-section-id="{{ section.id }}" 
     data-hide-header="{{ hide_theme_header }}" 
     data-hide-footer="{{ hide_theme_footer }}">

  {%- if show_header -%}
    <header class="smart-checkout-header">
      <a href="{{ routes.root_url }}" class="smart-logo-wrap" aria-label="{{ shop.name }} home">
        {%- if logo != blank -%}
          <img src="{{ logo | image_url: width: 320 }}" 
               alt="{{ logo.alt | default: shop.name }}" 
               width="{{ logo_width }}" 
               height="54" 
               loading="eager">
        {%- else -%}
          <img src="https://riseon-jewels.r-katariya56.chatgpt.site/riseon-logo-trimmed.png" 
               alt="{{ shop.name | default: 'Riseon Jewels' }}" 
               width="{{ logo_width }}" 
               height="54" 
               loading="eager">
        {%- endif -%}
      </a>
      {%- if show_security_badge -%}
        <span class="smart-header-security">{{ security_badge_text }}</span>
      {%- endif -%}
    </header>
  {%- endif -%}

  <div class="smart-checkout-shell" id="smart-checkout-shell" {% if cart.item_count == 0 %}style="display: none;"{% endif %}>
    <section class="smart-checkout-main">
      
      <!-- ================= STEP 1: BAG ================= -->
      <div class="step-panel" id="step-panel-bag" data-panel="bag">
        <div class="smart-title">
          <div>
            <span>{{ section.settings.bag_eyebrow | default: 'YOUR SELECTION' }}</span>
            <h1>{{ section.settings.bag_title | default: 'Shopping bag' }}</h1>
          </div>
          <small id="smart-cart-count-label">{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}</small>
        </div>

        <div class="smart-cart-items-list" id="smart-cart-items-list">
          {% for item in cart.items %}
            {%- liquid
              assign item_price = item.final_line_price | money
              if cart.currency.iso_code == 'INR'
                assign item_price = item_price | replace: 'Rs.', '₹' | replace: 'Rs', '₹'
              endif
              assign item_orig_price = item.original_line_price | money
              if cart.currency.iso_code == 'INR'
                assign item_orig_price = item_orig_price | replace: 'Rs.', '₹' | replace: 'Rs', '₹'
              endif
            -%}
            <article class="smart-cart-item" data-item-key="{{ item.key }}">
              <a href="{{ item.url }}" class="smart-cart-image">
                {% if item.image %}
                  <img src="{{ item.image | image_url: width: 300 }}" alt="{{ item.title | escape }}" loading="lazy">
                {% else %}
                  {{ 'image' | placeholder_svg_tag }}
                {% endif %}
              </a>
              <div class="smart-cart-copy">
                <span>{{ section.settings.item_collection_badge | default: 'GOLD · LABORATORY-GROWN DIAMONDS' }}</span>
                <h2><a href="{{ item.url }}">{{ item.product.title }}</a></h2>
                {%- unless item.product.has_only_default_variant -%}
                  <p>{{ item.variant.title | replace: ' / ', ' · ' }}</p>
                {%- endunless -%}
                {%- if section.settings.show_sku and item.sku != blank -%}
                  <small>SKU {{ item.sku }}</small>
                {%- endif -%}
                <div class="smart-item-actions">
                  <label>
                    Qty 
                    <select class="smart-qty-select" data-item-key="{{ item.key }}" aria-label="Quantity for {{ item.title }}">
                      {% for q in (1..10) %}
                        <option value="{{ q }}" {% if item.quantity == q %}selected{% endif %}>{{ q }}</option>
                      {% endfor %}
                      {% if item.quantity > 10 %}
                        <option value="{{ item.quantity }}" selected>{{ item.quantity }}</option>
                      {% endif %}
                    </select>
                  </label>
                  <button type="button" class="smart-remove-btn" data-item-key="{{ item.key }}">Remove</button>
                </div>
              </div>
              <div class="smart-item-price">
                <strong>{{ item_price }}</strong>
                {%- if item.original_line_price > item.final_line_price -%}
                  <del>{{ item_orig_price }}</del>
                {%- endif -%}
              </div>
            </article>
          {% endfor %}
        </div>

        {%- if section.settings.show_promises -%}
          <div class="smart-promises">
            {%- if section.settings.promise_1_text != blank -%}
              <span><b>{{ section.settings.promise_1_icon | default: '✓' }}</b> {{ section.settings.promise_1_text }}</span>
            {%- endif -%}
            {%- if section.settings.promise_2_text != blank -%}
              <span><b>{{ section.settings.promise_2_icon | default: '⌾' }}</b> {{ section.settings.promise_2_text }}</span>
            {%- endif -%}
            {%- if section.settings.promise_3_text != blank -%}
              <span><b>{{ section.settings.promise_3_icon | default: '↺' }}</b> {{ section.settings.promise_3_text }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_coupon -%}
          <form class="smart-code" onsubmit="return false;">
            <label for="cart-code">{{ section.settings.coupon_title | default: 'Referral or coupon code' }}</label>
            <div>
              <input id="cart-code" 
                     placeholder="{{ section.settings.coupon_placeholder | default: 'Enter code' }}" 
                     autocomplete="off" 
                     value="{%- for app in cart.discount_applications -%}{{ app.title | escape }}{% break %}{%- endfor -%}">
              <button type="button" id="cart-code-btn">{{ section.settings.coupon_button_text | default: 'Apply' }}</button>
            </div>
            <small id="smart-code-msg" style="display: none;"></small>
          </form>
        {%- endif -%}
      </div>



    </section>

    <!-- ================= RIGHT COLUMN: ORDER SUMMARY ================= -->
    <aside class="smart-summary" id="smart-order-summary">
      <h2>{{ section.settings.summary_title | default: 'Order summary' }}</h2>
      
      {%- liquid
        assign cart_subtotal = cart.total_price | money
        if cart.currency.iso_code == 'INR'
          assign cart_subtotal = cart_subtotal | replace: 'Rs.', '₹' | replace: 'Rs', '₹'
        endif
      -%}
      <div>
        <span>Product total</span>
        <b class="smart-summary-subtotal">{{ cart_subtotal }}</b>
      </div>

      {%- if section.settings.show_gst -%}
        <div>
          <span>{{ section.settings.gst_label | default: 'GST' }}</span>
          <b class="smart-summary-gst">{{ section.settings.gst_value | default: '₹0' }}</b>
        </div>
      {%- endif -%}

      {%- if section.settings.show_insured_delivery -%}
        <div>
          <span>{{ section.settings.insured_delivery_label | default: 'Insured delivery' }}</span>
          <b class="free">{{ section.settings.insured_delivery_value | default: 'FREE' }}</b>
        </div>
      {%- endif -%}

      <div class="smart-total">
        <span>
          Total payable
          <small>{{ section.settings.total_tax_note | default: 'Inclusive of all taxes' }}</small>
        </span>
        <strong class="smart-summary-total">{{ cart_subtotal }}</strong>
      </div>

      <!-- Action Button on Step 1 -->
      <button class="smart-primary" type="button" id="btn-summary-checkout">
        {{ section.settings.checkout_btn_text | default: 'SECURE CHECKOUT' }}
      </button>

      {%- if section.settings.show_security_note -%}
        <p class="smart-security">
          {{ section.settings.security_note | default: '▣ Payments are processed by an authorised provider. Riseon does not store your card number, CVV or UPI PIN.' }}
        </p>
      {%- endif -%}

      {%- if section.settings.show_help -%}
        <div class="smart-help">
          <b>{{ section.settings.help_title | default: 'Need help before ordering?' }}</b>
          {% if section.settings.help_number != blank %}
            <a href="tel:{{ section.settings.help_number | escape }}">{{ section.settings.help_phone | default: 'Call 7359215333' }}</a>
          {% else %}
            <span>{{ section.settings.help_phone | default: 'Call 7359215333' }}</span>
          {% endif %}
        </div>
      {%- endif -%}
    </aside>
  </div>

  <!-- ================= EMPTY BAG STATE ================= -->
  <section class="smart-empty" id="smart-empty-bag" {% if cart.item_count > 0 %}style="display: none;"{% endif %}>
    <span>◇</span>
    <h1>Your bag is empty</h1>
    <p>Explore lightweight gold and laboratory-grown diamond jewellery designed for everyday wear.</p>
    <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}">Continue shopping</a>
  </section>

</div>

<script>
(function() {
  function formatRupees(cents) {
    var rupees = Math.round(cents / 100);
    return '₹' + rupees.toLocaleString('en-IN');
  }

  // "Secure checkout" button in summary - Direct redirect to Shopify checkout
  var summaryCheckoutBtn = document.getElementById('btn-summary-checkout');
  if (summaryCheckoutBtn) {
    summaryCheckoutBtn.addEventListener('click', function(e) {
      e.preventDefault();

      summaryCheckoutBtn.textContent = 'Redirecting to checkout...';
      summaryCheckoutBtn.disabled = true;
      summaryCheckoutBtn.style.opacity = '0.7';

      var couponVal = (document.getElementById('cart-code')?.value || '').trim();
      var checkoutUrl = '/checkout';

      if (couponVal) {
        checkoutUrl += '?discount=' + encodeURIComponent(couponVal);
        fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ attributes: { 'Discount Code': couponVal } })
        }).finally(function() {
          window.location.href = checkoutUrl;
        });
      } else {
        window.location.href = checkoutUrl;
      }
    });
  }

  // Coupon code apply
  var couponBtn = document.getElementById('cart-code-btn');
  var couponInput = document.getElementById('cart-code');
  var couponMsg = document.getElementById('smart-code-msg');

  if (couponBtn && couponInput) {
    couponBtn.addEventListener('click', function() {
      var code = couponInput.value.trim();
      if (!code) {
        if (couponMsg) {
          couponMsg.textContent = 'Enter a referral or coupon code.';
          couponMsg.style.display = 'block';
        }
        return;
      }
      couponBtn.textContent = 'Applying...';
      
      // Store in cart attribute and notify user
      fetch('/cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          attributes: { 'Discount Code': code }
        })
      }).then(function() {
        couponBtn.textContent = 'Apply';
        if (couponMsg) {
          couponMsg.textContent = 'Code ' + code + ' saved. Eligibility will be verified before payment.';
          couponMsg.style.display = 'block';
        }
      }).catch(function() {
        couponBtn.textContent = 'Apply';
        if (couponMsg) {
          couponMsg.textContent = 'Code saved. Eligibility will be verified at checkout.';
          couponMsg.style.display = 'block';
        }
      });
    });
  }

  // Quantity dropdowns
  var qtySelects = document.querySelectorAll('.smart-qty-select');
  qtySelects.forEach(function(select) {
    select.addEventListener('change', function() {
      var itemKey = select.getAttribute('data-item-key');
      var newQty = parseInt(select.value, 10);
      updateLineItem(itemKey, newQty);
    });
  });

  // Remove buttons
  var removeBtns = document.querySelectorAll('.smart-remove-btn');
  removeBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var itemKey = btn.getAttribute('data-item-key');
      updateLineItem(itemKey, 0);
    });
  });

  function updateLineItem(itemKey, quantity) {
    // Show loading state
    var itemRow = document.querySelector('.smart-cart-item[data-item-key="' + itemKey + '"]');
    if (itemRow) itemRow.style.opacity = '0.5';

    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        id: itemKey,
        quantity: quantity
      })
    })
    .then(function(res) { return res.json(); })
    .then(function(cart) {
      if (cart.item_count === 0) {
        var shell = document.getElementById('smart-checkout-shell');
        var stepper = document.getElementById('smart-stepper-nav');
        var emptyBag = document.getElementById('smart-empty-bag');
        if (shell) shell.style.display = 'none';
        if (stepper) stepper.style.display = 'none';
        if (emptyBag) emptyBag.style.display = 'block';
        return;
      }

      // If removed item, remove row
      if (quantity === 0 && itemRow) {
        itemRow.remove();
      }

      // Update count label
      var countLabel = document.getElementById('smart-cart-count-label');
      if (countLabel) {
        countLabel.textContent = cart.item_count + (cart.item_count === 1 ? ' item' : ' items');
      }

      // Update subtotal & total
      var formattedTotal = formatRupees(cart.total_price);
      document.querySelectorAll('.smart-summary-subtotal, .smart-summary-total, .smart-btn-total').forEach(function(el) {
        el.textContent = formattedTotal;
      });

      // Update line price
      if (quantity > 0) {
        var updatedItem = cart.items.find(function(it) { return it.key === itemKey; });
        if (updatedItem && itemRow) {
          var priceEl = itemRow.querySelector('.smart-item-price strong');
          if (priceEl) priceEl.textContent = formatRupees(updatedItem.final_line_price);
          itemRow.style.opacity = '1';
        }
      }

      // Dispatch theme event
      window.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart: cart } }));
    })
    .catch(function(err) {
      if (itemRow) itemRow.style.opacity = '1';
    });
  }

})();
</script>

