{%- liquid
  assign slide_count = section.blocks.size
  if slide_count == 0
    assign slide_count = 4
  endif
-%}

<section class="hero-carousel" id="HeroCarousel-{{ section.id }}" aria-label="Featured Riseon collections" aria-roledescription="carousel">
  <h1 class="visually-hidden">{{ section.settings.seo_heading | default: 'Rise in Style — Lightweight Gold and Lab-Grown Diamond Jewellery' }}</h1>
  
  <div class="hero-carousel-track" aria-live="off">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- assign is_active = false -%}
        {%- if forloop.first -%}{%- assign is_active = true -%}{%- endif -%}
        <a 
          href="{{ block.settings.link | default: '#shop' }}" 
          class="hero-carousel-slide{% if is_active %} is-active{% endif %}" 
          aria-hidden="{% if is_active %}false{% else %}true{% endif %}" 
          tabindex="{% if is_active %}0{% else %}-1{% endif %}"
          {{ block.shopify_attributes }}
        >
          <picture>
            {%- if block.settings.mobile_image != blank -%}
              <source media="(max-width: 768px)" srcset="{{ block.settings.mobile_image | image_url: width: 800 }}">
            {%- endif -%}
            {%- if block.settings.image != blank -%}
              <img 
                src="{{ block.settings.image | image_url: width: 2000 }}" 
                alt="{{ block.settings.alt_text | default: block.settings.image.alt | default: 'Riseon Jewels campaign' }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                {% if forloop.first %}fetchpriority="high"{% endif %}
              >
            {%- else -%}
              {%- case forloop.index -%}
                {%- when 1 -%}
                  <img src="https://riseon-jewels.r-katariya56.chatgpt.site/hero/riseon-earned-shine.png" alt="Riseon Jewels everyday diamonds campaign" loading="eager" fetchpriority="high">
                {%- when 2 -%}
                  <img src="https://riseon-jewels.r-katariya56.chatgpt.site/hero/riseon-office-edit.png" alt="Riseon Jewels office edit" loading="lazy">
                {%- when 3 -%}
                  <img src="https://riseon-jewels.r-katariya56.chatgpt.site/hero/riseon-modern-mangalsutra.png" alt="Riseon Jewels modern mangalsutra" loading="lazy">
                {%- else -%}
                  <img src="https://riseon-jewels.r-katariya56.chatgpt.site/hero/riseon-trust.png" alt="Riseon Jewels trust and transparency campaign" loading="lazy">
              {%- endcase -%}
            {%- endif -%}
          </picture>
        </a>
      {%- endfor -%}
    {%- else -%}
      <!-- Default 4 reference slides -->
      <a href="#shop" class="hero-carousel-slide is-active" aria-hidden="false" tabindex="0">
        <img src="https://riseon-jewels.r-katariya56.chatgpt.site/hero/riseon-earned-shine.png" alt="Riseon Jewels everyday diamonds campaign" loading="eager" fetchpriority="high">
      </a>
      <a href="#occasions" class="hero-carousel-slide" aria-hidden="true" tabindex="-1">
        <img src="https://riseon-jewels.r-katariya56.chatgpt.site/hero/riseon-office-edit.png" alt="Riseon Jewels office edit" loading="lazy">
      </a>
      <a href="/collections/mangalsutra-pendant" class="hero-carousel-slide" aria-hidden="true" tabindex="-1">
        <img src="https://riseon-jewels.r-katariya56.chatgpt.site/hero/riseon-modern-mangalsutra.png" alt="Riseon Jewels modern mangalsutra collection" loading="lazy">
      </a>
      <a href="/pages/about-us" class="hero-carousel-slide" aria-hidden="true" tabindex="-1">
        <img src="https://riseon-jewels.r-katariya56.chatgpt.site/hero/riseon-trust.png" alt="Riseon Jewels trust and transparency campaign" loading="lazy">
      </a>
    {%- endif -%}
  </div>

  {%- if section.settings.show_arrows != false -%}
    <button class="hero-carousel-arrow previous" type="button" aria-label="Show previous banner" data-carousel-prev>‹</button>
    <button class="hero-carousel-arrow next" type="button" aria-label="Show next banner" data-carousel-next>›</button>
  {%- endif -%}

  {%- if section.settings.show_dots != false -%}
    <div class="hero-carousel-dots" aria-label="Choose a banner">
      {%- for i in (1..slide_count) -%}
        <button 
          class="{% if forloop.first %}is-active{% endif %}" 
          type="button" 
          aria-label="Show banner {{ forloop.index }} of {{ slide_count }}"
          data-carousel-dot="{{ forloop.index0 }}"
        ></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<script>
  (function() {
    function initCarousel() {
      const carousel = document.getElementById('HeroCarousel-{{ section.id }}');
      if (!carousel) return;

      const slides = carousel.querySelectorAll('.hero-carousel-slide');
      const dots = carousel.querySelectorAll('.hero-carousel-dots button');
      const prevBtn = carousel.querySelector('[data-carousel-prev]');
      const nextBtn = carousel.querySelector('[data-carousel-next]');
      let currentIndex = 0;
      let timer = null;
      const autoplaySpeed = {{ section.settings.autoplay_speed | default: 5000 }};
      const isAutoplay = {{ section.settings.autoplay | default: true }};

      function goToSlide(index) {
        if (!slides.length) return;
        currentIndex = (index + slides.length) % slides.length;
        
        slides.forEach((slide, i) => {
          const isActive = i === currentIndex;
          slide.classList.toggle('is-active', isActive);
          slide.setAttribute('aria-hidden', !isActive);
          slide.setAttribute('tabindex', isActive ? '0' : '-1');
        });

        dots.forEach((dot, i) => {
          dot.classList.toggle('is-active', i === currentIndex);
          dot.setAttribute('aria-current', i === currentIndex ? 'true' : 'false');
        });
      }

      function startAutoplay() {
        if (isAutoplay && !timer) {
          timer = setInterval(() => goToSlide(currentIndex + 1), autoplaySpeed);
        }
      }

      function stopAutoplay() {
        if (timer) {
          clearInterval(timer);
          timer = null;
        }
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          stopAutoplay();
          goToSlide(currentIndex - 1);
          startAutoplay();
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          stopAutoplay();
          goToSlide(currentIndex + 1);
          startAutoplay();
        });
      }

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          stopAutoplay();
          goToSlide(i);
          startAutoplay();
        });
      });

      carousel.addEventListener('mouseenter', stopAutoplay);
      carousel.addEventListener('mouseleave', startAutoplay);

      // Touch swipe support
      let touchStartX = 0;
      carousel.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
        stopAutoplay();
      }, { passive: true });

      carousel.addEventListener('touchend', (e) => {
        const diffX = e.changedTouches[0].screenX - touchStartX;
        if (Math.abs(diffX) > 40) {
          if (diffX < 0) {
            goToSlide(currentIndex + 1);
          } else {
            goToSlide(currentIndex - 1);
          }
        }
        startAutoplay();
      }, { passive: true });

      startAutoplay();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCarousel);
    } else {
      initCarousel();
    }
    document.addEventListener('shopify:section:load', initCarousel);
  })();
</script>

{% schema %}
{
  "name": "Hero Carousel",
  "class": "hero-carousel-section",
  "settings": [
    {
      "type": "text",
      "id": "seo_heading",
      "label": "SEO Heading (Hidden Screen Reader Text)",
      "default": "Rise in Style — Lightweight Gold and Lab-Grown Diamond Jewellery"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3000,
      "max": 9000,
      "step": 1000,
      "unit": "ms",
      "label": "Autoplay Speed",
      "default": 5000
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Navigation Arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show Indicator Dots",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Image (Optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Slide Link"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Image Alt Text",
          "default": "Riseon Jewels fine jewellery campaign"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Carousel",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "link": "#shop",
            "alt_text": "Riseon Jewels everyday diamonds campaign"
          }
        },
        {
          "type": "slide",
          "settings": {
            "link": "#occasions",
            "alt_text": "Riseon Jewels office edit"
          }
        },
        {
          "type": "slide",
          "settings": {
            "link": "/collections/mangalsutra-pendant",
            "alt_text": "Riseon Jewels modern mangalsutra collection"
          }
        },
        {
          "type": "slide",
          "settings": {
            "link": "/pages/about-us",
            "alt_text": "Riseon Jewels trust and transparency campaign"
          }
        }
      ]
    }
  ]
}
{% endschema %}
