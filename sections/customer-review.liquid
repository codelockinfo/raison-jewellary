      "info": "Example: 40px 15px 40px 15px"
    },
  ],
  "blocks": [
    {
      "type": "review_block",
      "name": "Review",
      "settings": [
        {
          "type": "header",
          "content": "Media"
        },
        {
          "type": "select",
