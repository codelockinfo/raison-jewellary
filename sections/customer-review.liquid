        },
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Reviews",
      "blocks": [
        { "type": "review_block" },
        { "type": "review_block" },
        { "type": "review_block" }
      ]
    }
  ]
}
