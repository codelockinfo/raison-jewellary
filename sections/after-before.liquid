{% liquid
%}

<section 
  class="skin-section color-{{ section.settings.color_scheme }} skeleton-container"
  style="
    --section-padding-desktop: {{ section.settings.section_padding_desktop }};
    --section-padding-mobile: {{ section.settings.section_padding_mobile }};
  "
>
  <div class="skeleton-visible">
    <div class="container_width">
       <div class="skin-wrapper {% if section.settings.content_position == 'right' %}skin-wrapper--reversed{% endif %}" style="display: flex; gap: 40px; align-items: center;">
          <div style="flex: 1;">
            <div class="skeleton-box skeleton-shimmer skeleton-title" style="height: 40px; width: 300px; margin-bottom: 20px;"></div>
            <div class="skeleton-box skeleton-shimmer skeleton-text medium" style="margin-bottom: 30px;"></div>
            <div class="skeleton-box skeleton-shimmer" style="width: 150px; height: 50px; border-radius: 5px;"></div>
          </div>
          <div style="flex: 1;">
            <div class="skeleton-box skeleton-shimmer" style="width: 100%; height: 500px; border-radius: 15px;"></div>
          </div>
       </div>
    </div>
  </div>
  <div class="container_width">
    <div class="skin-wrapper {% if section.settings.content_position == 'right' %}skin-wrapper--reversed{% endif %}">
    <div class="skin-content">
      <span class="tagline">{{ section.settings.tagline }}</span>
      <div class="common-heading">
        {% if section.settings.heading != blank %}
          {% render 'heading-style-banner',
          heading: section.settings.heading,
          heading_tag: section.settings.heading_tag,
          heading_style: section.settings.heading_style,
          heading_alignment: section.settings.heading_alignment,
          wrapper_class: 'skin-section'
        %}
        {% endif %}
      </div>
      <p class="common-text">{{ section.settings.text }}</p>
      <a href="{{ section.settings.button_link }}" class="common-btn">
        {{ section.settings.button_text }}
      </a>
    </div>
    <div class="before-after">
      <div class="img-container">
        {% if section.settings.before_image != blank %}
          <img src="{{ section.settings.before_image | image_url: width: 1000 }}" class="before-img" alt="{{ section.settings.before_image.alt | default: 'Before Image' }}" width="1000" height="{{ 1000 | divided_by: section.settings.before_image.aspect_ratio | round }}">
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'before-img placeholder-svg' }}
        {% endif %}
        {% if section.settings.after_image != blank %}
          <img src="{{ section.settings.after_image | image_url: width: 1000 }}" class="after-img" alt="{{ section.settings.after_image.alt | default: 'After Image' }}" width="1000" height="{{ 1000 | divided_by: section.settings.after_image.aspect_ratio | round }}">
        {% else %}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'after-img placeholder-svg' }}
        {% endif %}
        <div class="line"></div>
        <label for="BeforeAfterSlider-{{ section.id }}" class="visually-hidden">Adjust before and after image visibility</label>
        <input id="BeforeAfterSlider-{{ section.id }}" type="range" min="0" max="100" value="50" class="slider">
        <div class="slider-handle">
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
        </div>
        <span class="label before">Before</span>
        <span class="label after">After</span>
      </div>
    </div>
    </div>
  </div>
</section>

<script>
document.querySelectorAll('.slider').forEach(slider => {
  const container = slider.closest('.img-container');
  const afterImg = container.querySelector('.after-img');
  const line = container.querySelector('.line');
  const handle = container.querySelector('.slider-handle');
  const beforeLabel = container.querySelector('.label.before');
  const afterLabel = container.querySelector('.label.after');
  
  const updatePosition = (value) => {
    const numValue = parseFloat(value);
    
    // Update image and line position
    afterImg.style.clipPath = `inset(0 0 0 ${numValue}%)`;
    line.style.left = numValue + '%';
    handle.style.left = numValue + '%';
    
// Reverse labels logic
if (numValue <= 20) {
  // Mostly BEFORE side → show AFTER
  afterLabel.style.opacity = '1';
  afterLabel.style.visibility = 'visible';

  beforeLabel.style.opacity = '0';
  beforeLabel.style.visibility = 'hidden';

} else if (numValue >= 80) {
  // Mostly AFTER side → show BEFORE
  beforeLabel.style.opacity = '1';
  beforeLabel.style.visibility = 'visible';

  afterLabel.style.opacity = '0';
  afterLabel.style.visibility = 'hidden';

} else {
  // Center area → show both
  beforeLabel.style.opacity = '1';
  beforeLabel.style.visibility = 'visible';

  afterLabel.style.opacity = '1';
  afterLabel.style.visibility = 'visible';
}


  };
  
  // Initialize position
  updatePosition(slider.value);
  
  slider.addEventListener('input', e => {
    updatePosition(e.target.value);
  });
});
</script>

{% schema %}
{
  "name": "Before After Skin",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content Position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "EFFORTLESS GLOW"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Transform Your Skin"
    },
     {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading Level (Size)",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h1"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Experience the power of skincare with visible results."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Explore Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before Image"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After Image"
    },
    { "type": "header", "content": "Section Spacing" },
    { "type": "text", "id": "section_padding_desktop", "label": "Section Padding (Desktop)", "default": "60px 20px 60px 20px" },
    { "type": "text", "id": "section_padding_mobile", "label": "Section Padding (Mobile)", "default": "20px 20px 20px 20px" }

  ],
  "presets": [
    {
      "name": "Before After Skin Section"
    }
  ]
}
{% endschema %}
