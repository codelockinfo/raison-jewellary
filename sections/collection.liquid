{% comment %}
  Riseon Jewels - Luxury Collection Page Section
  Matches: https://riseon-jewels.r-katariya56.chatgpt.site/jewellery/rings
{% endcomment %}

{%- paginate collection.products by section.settings.products_per_page -%}
<div class="collection-page-wrap" id="CollectionSection-{{ section.id }}" data-section-id="{{ section.id }}">
  
  {%- if section.settings.show_breadcrumbs -%}
    <div class="collection-crumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span>›</span>
      <a href="{{ routes.all_products_collection_url }}">Jewellery</a>
      <span>›</span>
      <strong>{{ section.settings.custom_collection_title | default: collection.title }}</strong>
    </div>
  {%- endif -%}

  {%- if section.settings.show_collection_title -%}
    {%- liquid
      assign meta_title = collection.metafields.custom.display_title
      if meta_title != blank
        assign resolved_title = meta_title
      elsif section.settings.custom_collection_title != blank
        assign resolved_title = section.settings.custom_collection_title
      else
        assign resolved_title = collection.title
      endif
    -%}
    <div class="collection-header-banner">
      <h1 class="collection-main-title">
        {{ resolved_title }}
      </h1>
      {%- if section.settings.show_collection_description and collection.description != blank -%}
        <div class="collection-main-description">
          {{ collection.description }}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- comment -%} Tag Pill Filter Blocks — below collection title {%- endcomment -%}
  {%- assign has_pill_blocks = false -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'tag_pill_filter' -%}{%- assign has_pill_blocks = true -%}{%- endif -%}
  {%- endfor -%}
  {%- if has_pill_blocks -%}
    <div class="grid-pill-filters">
      {%- for block in section.blocks -%}
        {%- if block.type == 'tag_pill_filter' -%}
          {%- assign pill_tag = block.settings.tag | strip -%}
          {%- assign pill_tag_handle = pill_tag | handle -%}
          {%- assign pill_label = block.settings.title | default: pill_tag -%}
          {%- assign pill_active = false -%}
          {%- if current_tags contains pill_tag -%}
            {%- assign pill_active = true -%}
          {%- endif -%}
          {%- if pill_tag != blank -%}
            <a
              href="{% if pill_active %}{{ collection.url }}{% else %}{{ collection.url }}/{{ pill_tag_handle }}{% endif %}"
              class="grid-pill {% if pill_active %}active{% endif %}"
              {{ block.shopify_attributes }}
            >
              {{ pill_label }}
              {%- assign pill_count = 0 -%}
              {%- for p in collection.products -%}
                {%- if p.tags contains pill_tag -%}{%- assign pill_count = pill_count | plus: 1 -%}{%- endif -%}
              {%- endfor -%}
              <span class="grid-pill-count">{{ pill_count }}</span>
            </a>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.show_style_rail -%}
    <section class="catalogue-style-rail" aria-label="Shop by style">
      <div class="catalogue-style-heading">
        {%- if section.settings.show_style_rail_eyebrow and section.settings.style_rail_eyebrow != blank -%}
          <span>{{ section.settings.style_rail_eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.show_style_rail_title and section.settings.style_rail_title != blank -%}
          <h1>{{ section.settings.style_rail_title }}</h1>
        {%- endif -%}
      </div>

      <div class="catalogue-style-options">
        <a href="{{ collection.url }}" class="style-pill {% unless current_tags %}active{% endunless %}">
          All {{ collection.title }}
        </a>
        {%- for block in section.blocks -%}
          {%- if block.type == 'style_item' -%}
            {%- assign filter_handle = block.settings.tag | handle -%}
            {%- assign is_active = false -%}
            {%- if current_tags contains block.settings.tag -%}
              {%- assign is_active = true -%}
            {%- endif -%}
            <a 
              href="{% if block.settings.link != blank %}{{ block.settings.link }}{% elsif block.settings.tag != blank %}{{ collection.url }}/{{ filter_handle }}{% else %}#{% endif %}" 
              class="style-pill {% if is_active %}active{% endif %}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.title | default: block.settings.tag }}
              {%- if block.settings.count != blank -%}
                <small>{{ block.settings.count }}</small>
              {%- endif -%}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  <div class="collection-toolbar">
    {%- if section.settings.show_filters and collection.all_products_count > 0 -%}
      {%- liquid
        assign active_count = current_tags.size
        for f in collection.filters
          assign active_count = active_count | plus: f.active_values.size
          if f.type == 'price_range' and f.min_value.value != nil or f.max_value.value != nil
            assign active_count = active_count | plus: 1
          endif
        endfor
      -%}
      <button type="button" class="mobile-filter-trigger js-filter-drawer-open" aria-label="Open filters">
        FILTERS{% if active_count > 0 %} ({{ active_count }}){% endif %}
      </button>
    {%- endif -%}

    <span class="collection-counter">
      <strong>{{ paginate.items }}</strong> of {{ collection.all_products_count | default: paginate.items }} designs
    </span>

    {%- if section.settings.show_sort_by -%}
      <label class="collection-sort-label">
        Sort by
        <select id="SortBy" name="sort_by" class="collection-sort-select" onchange="location.href = this.value">
          {%- for option in collection.sort_options -%}
            <option 
              value="{{ collection.url }}?sort_by={{ option.value }}" 
              {% if option.value == collection.sort_by %}selected{% endif %}
            >
              {{ option.name }}
            </option>
          {%- endfor -%}
        </select>
      </label>
    {%- endif -%}
  </div>

  {%- comment -%} Active filter tags row {%- endcomment -%}
  {%- liquid
    assign has_active_filters = false
    if current_tags.size > 0
      assign has_active_filters = true
    endif
    for filter in collection.filters
      if filter.active_values.size > 0 or filter.min_value.value != nil or filter.max_value.value != nil
        assign has_active_filters = true
        break
      endif
    endfor
  -%}

  {%- if has_active_filters -%}
    <div class="active-filter-row">
      {%- for tag in current_tags -%}
        <a href="{{ collection.url }}" class="active-filter-pill">
          {{ tag }} ✕
        </a>
      {%- endfor -%}
      {%- for filter in collection.filters -%}
        {%- for value in filter.active_values -%}
          <a href="{{ value.url_to_remove }}" class="active-filter-pill">
            {{ value.label | escape }} ✕
          </a>
        {%- endfor -%}
        {%- if filter.type == 'price_range' -%}
          {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
            <a href="{{ filter.url_to_remove }}" class="active-filter-pill">
              {{ filter.min_value.value | default: 0 | money }} - {{ filter.max_value.value | default: filter.range_max | money }} ✕
            </a>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      <a href="{{ collection.url }}" class="clear-all-filters clear">Clear all</a>
    </div>
  {%- endif -%}

  <div class="collection-shell">
    
    {%- if section.settings.show_filters and collection.all_products_count > 0 -%}
      <aside class="collection-filters" id="CollectionSidebar">
        <div class="filter-title">
          <strong>{{ section.settings.filters_title | default: 'FILTERS' }}</strong>
          <button type="button" class="js-filter-drawer-close" aria-label="Close filters">✕</button>
        </div>

        <form class="filter-form" id="CollectionFilterForm">
          {%- if section.settings.filter_type == 'storefront' and collection.filters.size > 0 -%}
            {%- for filter in collection.filters -%}
              <details class="filter-group">
                <summary>{{ filter.label }}</summary>
                <div>
                  {%- case filter.type -%}
                    {%- when 'boolean' or 'list' -%}
                      {%- for value in filter.values -%}
                        <label class="{% if value.count == 0 and value.active == false %}unavailable{% endif %}">
                          <input 
                            type="checkbox" 
                            name="{{ value.param_name }}" 
                            value="{{ value.value }}"
                            {% if value.active %}checked{% endif %}
                            {% if value.count == 0 and value.active == false %}disabled{% endif %}
                            onchange="this.form.submit()"
                          >
                          <span>{{ value.label }}</span>
                          <small>{{ value.count }}</small>
                        </label>
                      {%- endfor -%}

                    {%- when 'price_range' -%}
                      <div class="filter-price-inputs">
                        <input 
                          type="number" 
                          name="{{ filter.min_value.param_name }}" 
                          placeholder="Min" 
                          value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                        >
                        <span>-</span>
                        <input 
                          type="number" 
                          name="{{ filter.max_value.param_name }}" 
                          placeholder="Max" 
                          value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                        >
                      </div>
                      <button type="submit" class="filter-apply-btn">Apply</button>
                  {%- endcase -%}
                </div>
              </details>
            {%- endfor -%}

          {%- else -%}
            {%- comment -%} Custom blocks mode {%- endcomment -%}
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'tag_filter' -%}
                  {%- assign tags_arr = block.settings.tags_list | split: ',' -%}
                  {%- if tags_arr.size > 0 -%}
                    <details class="filter-group" {{ block.shopify_attributes }}>
                      <summary>{{ block.settings.title | default: 'Filter' }}</summary>
                      <div>
                        {%- for raw_tag in tags_arr -%}
                          {%- assign t = raw_tag | strip -%}
                          {%- assign t_handle = t | handle -%}
                          {%- assign is_active = false -%}
                          {%- if current_tags contains t -%}
                            {%- assign is_active = true -%}
                          {%- endif -%}
                          <label class="{% if is_active %}active{% endif %}">
                            <input 
                              type="checkbox" 
                              {% if is_active %}checked{% endif %}
                              onchange="location.href='{% if is_active %}{{ collection.url }}{% else %}{{ collection.url }}/{{ t_handle }}{% endif %}'"
                            >
                            <span>{{ t }}</span>
                          </label>
                        {%- endfor -%}
                      </div>
                    </details>
                  {%- endif -%}
                {%- when 'variant_filter' -%}
                  <details class="filter-group" {{ block.shopify_attributes }}>
                    <summary>{{ block.settings.title | default: 'Color' }}</summary>
                    <div>
                      {%- for filter in collection.filters -%}
                        {%- if filter.label contains block.settings.variant_label or filter.label contains 'Color' -%}
                          {%- for value in filter.values -%}
                            <label class="{% if value.count == 0 and value.active == false %}unavailable{% endif %}">
                              <input 
                                type="checkbox" 
                                name="{{ value.param_name }}" 
                                value="{{ value.value }}"
                                {% if value.active %}checked{% endif %}
                                onchange="this.form.submit()"
                              >
                              <span>{{ value.label }}</span>
                              <small>{{ value.count }}</small>
                            </label>
                          {%- endfor -%}
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </details>
              {%- endcase -%}
            {%- endfor -%}
          {%- endif -%}
        </form>

        <button type="button" class="filter-apply js-filter-drawer-close">
          Show {{ paginate.items }} designs
        </button>
      </aside>
    {%- endif -%}

    <section class="collection-results" aria-live="polite">

      {%- if collection.products.size > 0 -%}
        <div class="collection-grid cols-desktop-{{ section.settings.columns_desktop }} cols-mobile-{{ section.settings.columns_mobile }}">
          {%- for product in collection.products -%}
            {%- render 'product-card', product: product -%}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <div class="collection-pagination" style="text-align: center; margin: 45px 0 20px;">
            {{ paginate | default_pagination }}
          </div>
        {%- endif -%}

      {%- else -%}
        <div class="collection-empty">
          <span>◇</span>
          <h2>No products found</h2>
          <p>Try clearing active filters or browse all categories.</p>
          <a href="{{ collection.url }}" class="btn primary" style="margin-top: 15px; display: inline-block;">Clear Filters</a>
        </div>
      {%- endif -%}
    </section>

  </div>
  
  <div class="filter-scrim js-filter-drawer-close" aria-hidden="true"></div>
</div>
{%- endpaginate -%}

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const openBtns = document.querySelectorAll('.js-filter-drawer-open');
    const closeBtns = document.querySelectorAll('.js-filter-drawer-close');
    const sidebar = document.getElementById('CollectionSidebar');
    const scrim = document.querySelector('.filter-scrim');

    openBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        if (sidebar) sidebar.classList.add('open');
        if (scrim) scrim.style.display = 'block';
      });
    });

    closeBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        if (sidebar) sidebar.classList.remove('open');
        if (scrim) scrim.style.display = 'none';
      });
    });
  });
</script>

{% schema %}
{
  "name": "Collection Grid",
  "class": "collection-page-section",
  "settings": [
    {
      "type": "header",
      "content": "Breadcrumbs & Heading"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show Breadcrumbs",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_collection_title",
      "label": "Show Collection Title",
      "default": true
    },
    {
      "type": "text",
      "id": "custom_collection_title",
      "label": "Custom Collection Title (Override)",
      "info": "Priority: Metafield (custom.display_title) → This field → Default collection title. To use metafield: Shopify Admin → Content → Metafields → Collections → add key 'display_title' in namespace 'custom'."
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "label": "Show Collection Description",
      "default": false
    },
    {
      "type": "header",
      "content": "Style Filter Rail (Top)"
    },
    {
      "type": "checkbox",
      "id": "show_style_rail",
      "label": "Show Style Filter Rail",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_style_rail_eyebrow",
      "label": "Show Eyebrow Text",
      "default": true
    },
    {
      "type": "text",
      "id": "style_rail_eyebrow",
      "label": "Eyebrow Text (e.g. FIND YOUR FIT)",
      "default": "FIND YOUR FIT"
    },
    {
      "type": "checkbox",
      "id": "show_style_rail_title",
      "label": "Show Heading Text",
      "default": true
    },
    {
      "type": "text",
      "id": "style_rail_title",
      "label": "Heading Text (e.g. Shop by Style)",
      "default": "Shop by Style"
    },
    {
      "type": "header",
      "content": "Product Grid Columns"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 6,
      "max": 48,
      "step": 2,
      "default": 24
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Products per row (Desktop)",
      "options": [
        { "value": "2", "label": "2 Cards" },
        { "value": "3", "label": "3 Cards" },
        { "value": "4", "label": "4 Cards" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Products per row (Mobile)",
      "options": [
        { "value": "1", "label": "1 Card" },
        { "value": "2", "label": "2 Cards" },
        { "value": "3", "label": "3 Cards" },
        { "value": "4", "label": "4 Cards" }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Filters & Sorting"
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show Filters Sidebar",
      "default": true
    },
    {
      "type": "text",
      "id": "filters_title",
      "label": "Filters Title",
      "default": "FILTERS"
    },
    {
      "type": "select",
      "id": "filter_type",
      "label": "Filters Type",
      "options": [
        { "value": "storefront", "label": "Storefront Filters (Shopify Native)" },
        { "value": "custom", "label": "Custom Tag Blocks" }
      ],
      "default": "storefront"
    },
    {
      "type": "checkbox",
      "id": "show_sort_by",
      "label": "Show Sort By Dropdown",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "style_item",
      "name": "Style Filter Pill",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Pill Title",
          "default": "Everyday Rings"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag Filter (optional)",
          "default": "Everyday"
        },
        {
          "type": "text",
          "id": "count",
          "label": "Count Badge (optional)",
          "default": "1"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom Link (optional)"
        }
      ]
    },
    {
      "type": "tag_filter",
      "name": "Custom Tag Filter",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Filter Group Title",
          "default": "Ring Type"
        },
        {
          "type": "textarea",
          "id": "tags_list",
          "label": "Tags (comma separated)",
          "default": "Solitaire, Everyday, Engagement, Cocktail, Band, Eternity"
        }
      ]
    },
    {
      "type": "variant_filter",
      "name": "Variant Filter",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Gold Purity"
        },
        {
          "type": "text",
          "id": "variant_label",
          "label": "Option Name",
          "default": "Purity"
        }
      ]
    },
    {
      "type": "tag_pill_filter",
      "name": "Tag Pill Filter (Grid)",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Pill Label",
          "info": "Displayed text on the pill button",
          "default": "Solitaire"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Product Tag",
          "info": "Exact tag name on products to filter (e.g. Solitaire)",
          "default": "Solitaire"
        }
      ]
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}