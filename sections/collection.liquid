@media(max-width:768px){

  .collection-faq-section{
    padding:30px 15px;
  }

  .faq-header h2{
    font-size:30px;
  }

  .faq-question{
    font-size:16px;
    padding:20px;
  }

  .faq-answer-inner{
    padding:0 20px 20px;
  }
}
</style>