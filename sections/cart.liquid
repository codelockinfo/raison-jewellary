    .item-upsells { margin-left: 0; }
    .cart-footer-summary { flex-direction: column; align-items: stretch; gap: 2rem; }
    .summary-left, .summary-right { width: 100%; text-align: left; }
    .summary-payment-icons { justify-content: center; }
    .item-price {font-size: 14px;}
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const cartForm = document.querySelector('.cart-form');
  if (!cartForm) return;

  function formatMoney(cents) {
    if (window.Shopify && window.Shopify.formatMoney) {
      let formatted = window.Shopify.formatMoney(cents);
      if (window.Shopify.currency.active === 'EUR') {
        formatted = formatted.replace('.', 'TEMP').replace(',', '.').replace('TEMP', ',');
      } else if (window.Shopify.currency.active === 'INR') {
        formatted = formatted.replace(/Rs\./g, '₹').replace(/Rs/g, '₹').replace(/R /g, '₹ ');
      }
      return formatted;
    }
    const shopCurrency = window.Shopify?.currency?.active || 'USD';
    try {
      return new Intl.NumberFormat(undefined, {
        style: 'currency',
        currency: shopCurrency
      }).format(cents / 100);
    } catch (e) {
      return (cents / 100).toFixed(2) + ' ' + shopCurrency;
    }
  }

  function updateCartUI(cart) {
    // Update line item prices
    cart.items.forEach(item => {
      const lineItemRows = document.querySelectorAll(`[data-cart-item][data-item-key="${item.key}"]`);
      lineItemRows.forEach(row => {
        const unitPriceElement = row.querySelector('[data-unit-price]');
        if (unitPriceElement) {
          if (item.original_price != item.final_price) {
            unitPriceElement.innerHTML = `
              <span class="cart-item__price--sale">${formatMoney(item.final_price)}</span>
              <span class="cart-item__price--compare">${formatMoney(item.original_price)}</span>
            `;
          } else {
            unitPriceElement.innerHTML = `<span>${formatMoney(item.final_price)}</span>`;
          }
        }

        const linePriceElement = row.querySelector('[data-line-price]');
        if (linePriceElement) {
          if (item.original_line_price != item.final_line_price) {
            linePriceElement.innerHTML = `
              <span class="cart-item__price--sale">${formatMoney(item.final_line_price)}</span>
              <span class="cart-item__price--compare">${formatMoney(item.original_line_price)}</span>
            `;
          } else {
            linePriceElement.innerHTML = `<span>${formatMoney(item.final_line_price)}</span>`;
          }
        }
        
        // Update input value
        const input = row.querySelector('[data-cart-quantity]');
        if (input && parseInt(input.value) !== item.quantity) {
          input.value = item.quantity;
        }

        // Trigger button update state
        if (typeof window.QuantityInput !== 'undefined' && window.QuantityInput.updateButtons) {
          const selector = input?.closest('[data-quantity-selector]');
          if (selector) window.QuantityInput.updateButtons(selector);
        }
      });
    });

    // Update totals
    const storedDiscount = localStorage.getItem('cart_applied_discount');
    const hasDiscountApps = cart.discount_applications && cart.discount_applications.length > 0;
    const isManualActive = !!(storedDiscount && (cart.total_discount > 0 || hasDiscountApps));
    const displayedTotal = isManualActive ? cart.total_price : (parseInt(cart.total_price) + parseInt(cart.total_discount));

    const totalDiscounts = (cart.discount_applications || []).reduce((sum, app) => sum + (app.total_allocated_amount || 0), 0) || cart.total_discount;
    const originalSubtotal = parseInt(cart.total_price) + parseInt(totalDiscounts);
    document.querySelectorAll('[data-cart-subtotal]').forEach(el => el.innerHTML = formatMoney(originalSubtotal));
    document.querySelectorAll('[data-cart-total]').forEach(el => el.innerHTML = formatMoney(displayedTotal));

    // Update Shipping Progress
    updateShippingProgress(cart.total_price);

    // Update cart count
    document.querySelectorAll('[data-cart-count], .header__cart-count').forEach(el => {
      el.textContent = cart.item_count;
    });

    if (cart.item_count === 0) {
      // document.dispatchEvent(new CustomEvent('cart:updated')); // The MainCartSection listener will handle it
    }

    // Toggle discount buttons based on actual discount presence
    const discBtn = document.querySelectorAll('[data-apply-coupon]');
    const removeBtn = document.querySelectorAll('[data-remove-coupon]');
    const discInput = document.querySelectorAll('[data-discount-input]');
    const discountContainers = document.querySelectorAll('[data-discounts-container]');

    // Always update input fields from sessionStorage
    discInput.forEach(input => {
      input.value = storedDiscount || '';
    });

    if (isManualActive) {
       discBtn.forEach(btn => btn.style.display = 'none');
       removeBtn.forEach(btn => btn.style.display = 'block');
       
       // Build and show discount rows
       discountContainers.forEach(container => {
          container.style.display = 'block';
          const discounts = cart.cart_level_discount_applications || cart.discount_applications || [];
          if (discounts.length > 0) {
             let html = '';
             discounts.forEach(discount => {
                const discountTitle = discount.title || discount.code || 'Discount';
                const discountAmount = discount.total_allocated_amount || discount.amount || 0;
                html += `
                  <div class="total-row summary-total-row discount-row" data-discount-row style="color: #2e7d32; display: flex; justify-content: space-between;">
                    <span class="cart-total-label">Discount (${discountTitle}):</span>
                    <span class="total-value value">-${formatMoney(discountAmount)}</span>
                  </div>
                `;
             });
             container.innerHTML = html;
          }
       });
    } else {
       if (cart.total_discount === 0 && !hasDiscountApps) {
          localStorage.removeItem('cart_applied_discount');
       }
       discBtn.forEach(btn => btn.style.display = 'block');
       removeBtn.forEach(btn => btn.style.display = 'none');
       discountContainers.forEach(container => {
          container.style.display = 'none';
          container.innerHTML = '';
       });
    }
  }

  function updateShippingProgress(cartTotal) {
    const freeShippingThreshold = 50000;
    const remaining = Math.max(0, freeShippingThreshold - cartTotal);
    const progress = Math.min(100, (cartTotal / freeShippingThreshold) * 100);
    
    const progressFill = document.querySelector('.shipping-fill');
    const progressIcon = document.querySelector('.shipping-icon-indicator');
    const progressText = document.querySelector('.shipping-text');
    
    if (progressFill) progressFill.style.width = `${progress}%`;
    // if (progressIcon) progressIcon.style.left = `${progress}%`;
    
    if (progressText) {
      if (cartTotal >= freeShippingThreshold) {
        progressText.innerHTML = "Congratulations! You've got free shipping!";
      } else {
        progressText.innerHTML = `Add ${formatMoney(remaining)} more to get free shipping!`;
      }
    }
  }

  // Handle Cart Note AJAX Update
  const cartNote = document.querySelector('[data-cart-note]');
  if (cartNote) {
    let noteTimeout;
    cartNote.addEventListener('input', function() {
      clearTimeout(noteTimeout);
      noteTimeout = setTimeout(async () => {
        try {
          await fetch('/cart/update.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ note: this.value })
          });
        } catch (err) {
        }
      }, 500);
    });
  }

  // Function to update prices instantly without server call
  function updateInstantPrices(inputElement, newQuantity) {
    const cartItem = inputElement.closest('[data-cart-item]');
    if (!cartItem) return;

    // Get current unit price from data attributes or parse from DOM
    const unitPriceElement = cartItem.querySelector('[data-unit-price]');
    const linePriceElement = cartItem.querySelector('[data-line-price]');
    
    if (unitPriceElement && linePriceElement) {
      // Extract current unit price (remove currency symbols and formatting)
      let unitPriceText = unitPriceElement.textContent || unitPriceElement.innerText;
      // Remove currency symbols and convert to number
      let unitPrice = parseFloat(unitPriceText.replace(/[^\d.-]/g, ''));
      
      if (!isNaN(unitPrice) && unitPrice > 0) {
        // Calculate new line total
        const newLineTotal = unitPrice * newQuantity;
        
        // Update line price instantly
        linePriceElement.innerHTML = `<span>${formatMoney(newLineTotal * 100)}</span>`;
        
        // Update cart totals instantly
        updateCartTotalsInstantly();
      }
    }
  }

  // Function to update cart totals instantly
  function updateCartTotalsInstantly() {
    let subtotal = 0;
    
    // Calculate subtotal from all line items
    document.querySelectorAll('[data-cart-item]').forEach(item => {
      const linePriceElement = item.querySelector('[data-line-price]');
      if (linePriceElement) {
        const priceText = linePriceElement.textContent || linePriceElement.innerText;
        const price = parseFloat(priceText.replace(/[^\d.-]/g, ''));
        if (!isNaN(price)) {
          subtotal += price;
        }
      }
    });
    
    // For instant updates, don't modify discount display - let server handle that
    // Just update subtotal and shipping progress
    document.querySelectorAll('[data-cart-subtotal]').forEach(el => {
      el.innerHTML = formatMoney(subtotal * 100); // Convert back to cents
    });
    
    // Don't update total during instant changes if discount is present
    // Let server response handle accurate total with discounts
    const hasDiscountRows = document.querySelectorAll('[data-discount-row]').length > 0;
    if (!hasDiscountRows) {
      // Only update total if no discount is present
      document.querySelectorAll('[data-cart-total]').forEach(el => {
        el.innerHTML = formatMoney(subtotal * 100);
      });
    }
    
    // Update shipping progress
    updateShippingProgress(subtotal * 100);
  }

  async function updateQuantity(itemKey, quantity, inputElement) {
    const container = inputElement?.closest('[data-cart-item]') || document.body;
    container.style.opacity = '0.5';
    container.style.pointerEvents = 'none';

    try {
      const response = await fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: itemKey, quantity: quantity })
      });

      if (response.ok) {
        const cart = await response.json();
        updateCartUI(cart);
      } else {
        document.dispatchEvent(new CustomEvent('cart:updated')); 
        window.showToast('Failed to update cart. Please try again.', 'error');
      }
    } catch (error) {
      document.dispatchEvent(new CustomEvent('cart:updated'));
      window.showToast('Error updating cart.', 'error');
    } finally {
      container.style.opacity = '1';
      container.style.pointerEvents = 'auto';
    }
  }

  // Handle quantity button clicks
  cartForm.addEventListener('click', function(e) {
    const btn = e.target.closest('[data-quantity-decrease], [data-quantity-increase]');
    if (!btn) return;

    const input = btn.closest('[data-quantity-selector]').querySelector('[data-cart-quantity]');
    if (!input) return;

    let value = parseInt(input.value) || 0;
    if (btn.hasAttribute('data-quantity-increase')) {
      value++;
    } else if (btn.hasAttribute('data-quantity-decrease')) {
      value = Math.max(1, value - 1);
    }

    if (input.value != value) {
      input.value = value;
      // Trigger change event manually
      input.dispatchEvent(new Event('change', { bubbles: true }));
    }
  });

  // Use delegation for ALL changes on cart form
  cartForm.addEventListener('change', function(e) {
    const input = e.target.closest('[data-cart-quantity]');
    if (!input) return;

    const itemKey = input.dataset.itemKey;
    const value = parseInt(input.value) || 0;

    if (itemKey) {
      // Update prices instantly
      updateInstantPrices(input, value);
      
      // Still update server with delay for accuracy
      clearTimeout(window.cartUpdateTimeout);
      window.cartUpdateTimeout = setTimeout(() => {
        updateQuantity(itemKey, value, input);
      }, 300);
    }
  });

  // Handle Enter key in inputs
  cartForm.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && e.target.closest('[data-cart-quantity]')) {
      e.preventDefault();
      e.target.blur();
    }
  });

  document.addEventListener('cart:refresh', async () => {
    try {
      const response = await fetch('/cart.js');
      const cart = await response.json();
      updateCartUI(cart);
    } catch (e) {}
  });

  // Toggle Cart Page Addons
  const addonBtns = document.querySelectorAll('[data-toggle-addon]');
  const addonContents = document.querySelectorAll('[data-addon-content]');
  
  addonBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.toggleAddon;
      const content = document.querySelector(`[data-addon-content="${target}"]`);
      
      if (!content) return;
      
      const isActive = btn.classList.contains('active');
      
      // If clicking already active tab, just return to keep it open
      if (isActive && (btn.classList.contains('addon-tab-btn') || btn.classList.contains('cart-drawer__addon-btn'))) {
        return;
      }

      addonContents.forEach(c => c.style.display = 'none');
      addonBtns.forEach(b => b.classList.remove('active'));
      
      if (!isActive) {
          content.style.display = 'block';
          btn.classList.add('active');
      }
    });
  });

  // Handle Cancel buttons specifically
  cartForm.addEventListener('click', (e) => {
    const noteCancelBtn = e.target.closest('[data-note-cancel]');
    if (noteCancelBtn) {
      const noteTextarea = document.querySelector('.addon-content-pane[data-addon-content="note"] [data-cart-note]');
      if (noteTextarea) {
        noteTextarea.value = '';
        // Trigger input event to save the empty note via AJAX
        noteTextarea.dispatchEvent(new Event('input', { bubbles: true }));
      }
      return;
    }

    const saveNoteBtn = e.target.closest('.addon-btn-save');
    if (saveNoteBtn) {
      const noteTextarea = document.querySelector('.addon-content-pane[data-addon-content="note"] [data-cart-note]');
      if (noteTextarea) {
        const originalText = saveNoteBtn.textContent;
        saveNoteBtn.textContent = 'SAVING...';
        saveNoteBtn.disabled = true;
        
        fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ note: noteTextarea.value })
        }).then(() => {
          saveNoteBtn.textContent = 'SAVED!';
          noteTextarea.value = ''; // Clear textarea after successful save
          setTimeout(() => {
            saveNoteBtn.textContent = originalText;
            saveNoteBtn.disabled = false;
          }, 2000);
        }).catch(err => {
          saveNoteBtn.textContent = originalText;
          saveNoteBtn.disabled = false;
        });
      }
      return;
    }

    const shippingCancelBtn = e.target.closest('[data-shipping-cancel]');
    if (shippingCancelBtn) {
      const pane = document.querySelector('[data-addon-content="shipping"]');
      if (pane) {
        pane.querySelectorAll('input, select').forEach(el => {
          if (el.tagName === 'SELECT') {
            el.selectedIndex = 0;
            el.dispatchEvent(new Event('change', { bubbles: true }));
          } else {
            el.value = '';
          }
        });
      }
      return;
    }
  });

  // Initialize Countdown Timer for Cart Page
  function initCartPageCountdown() {
    const timerEl = document.getElementById('cart-page-countdown-timer');
    if (!timerEl) return;

    if (window.cartPageCountdownInterval) {
      clearInterval(window.cartPageCountdownInterval);
    }

    let startTime = localStorage.getItem('cart_countdown_start');
    if (!startTime) {
      startTime = Date.now();
      localStorage.setItem('cart_countdown_start', startTime);
    }

    const duration = 10 * 60 * 1000;
    
    const updateTimer = () => {
      const elapsed = Date.now() - startTime;
      const remaining = Math.max(0, duration - elapsed);
      
      const totalSeconds = Math.floor(remaining / 1000);
      const m = Math.floor(totalSeconds / 60);
      const s = totalSeconds % 60;
      
      timerEl.textContent = `${m.toString().padStart(2, '0')} m ${s.toString().padStart(2, '0')} s`;
      
      if (remaining <= 0) {
        clearInterval(window.cartPageCountdownInterval);
        localStorage.removeItem('cart_countdown_start');
      }
    };

    updateTimer();
    window.cartPageCountdownInterval = setInterval(updateTimer, 1000);
  }
  initCartPageCountdown();

  // Initialize Shipping Calculator
  if (typeof Shopify !== 'undefined' && Shopify.CountryProvinceSelector) {
    new Shopify.CountryProvinceSelector('address_country', 'address_province', {
      hideElement: 'address_province_container_page'
    });
  }

  // Handle shipping calculation
  const calculateBtn = document.querySelector('[data-calculate-shipping]');
  if (calculateBtn) {
    calculateBtn.addEventListener('click', () => {
      // Mock calculation for UI purposes or implement full Shopify AJAX shipping if needed
      alert('Shipping estimation is active. Rates will be calculated at checkout.');
    });
  }

  // Handle discount code application
  cartForm.addEventListener('click', async (e) => {
    // 1. Apply Discount
    const applyBtn = e.target.closest('[data-apply-coupon]');
    if (applyBtn && !applyBtn.closest('.cart-drawer')) {
      const container = applyBtn.closest('[data-discount-form-container]');
      const input = container.querySelector('[data-discount-input]');
      const messageEl = container.querySelector('[data-discount-message]');
      const code = input ? input.value.trim() : '';
      
      if (!code) return;

      const originalText = applyBtn.textContent;
      applyBtn.textContent = 'Applying...';
      applyBtn.disabled = true;

      try {
        // Step 1: Apply the discount code via Shopify's discount endpoint
        const discountRes = await fetch(`/discount/${encodeURIComponent(code)}`);

        // Step 2: Wait a moment for Shopify to register the discount
        await new Promise(resolve => setTimeout(resolve, 800));

        // Step 3: Refresh cart to check current state
        const cartAfter = await (await fetch('/cart.js')).json();

        // Step 4: Check if discount is reflected in cart.js
        const hasApp = cartAfter.discount_applications && cartAfter.discount_applications.some(app =>
          (app.title && app.title.toLowerCase() === code.toLowerCase()) ||
          (app.code && app.code.toLowerCase() === code.toLowerCase())
        );
        const hasCartDiscount = cartAfter.total_discount > 0;

        if (hasApp || hasCartDiscount) {
          // Discount visible in cart.js right away - update UI live
          localStorage.setItem('cart_applied_discount', code);
          localStorage.removeItem('cart_discount_cleared');
          localStorage.removeItem('cart_discount_clearing');
          await fetch('/cart/update.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ attributes: { 'user_applied_coupon': code } })
          });
          
          if (messageEl) messageEl.innerHTML = `<span style="color: #4caf50; font-size: 13px; font-weight: 500; margin-top: 8px; display: block;">✓ Applied successfully!</span>`;
          updateCartUI(cartAfter);
          document.dispatchEvent(new CustomEvent('cart:updated'));
        } else {
          // Discount not visible in cart.js yet (might be checkout-only or invalid).
          // We don't save to localStorage as "successfully applied" here to avoid confusing the UI.
          applyBtn.textContent = originalText;
          applyBtn.disabled = false;
          
          if (messageEl) messageEl.innerHTML = `<span style="color: #666; font-size: 13px; font-weight: 500; margin-top: 8px; display: block;">ℹ Discount code entered. It will be verified at checkout.</span>`;
          // We still update the attribute so checkout has it
          await fetch('/cart/update.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ attributes: { 'user_applied_coupon': code } })
          });
        }
      } catch (err) {
        applyBtn.textContent = originalText;
        applyBtn.disabled = false;
        if (messageEl) messageEl.innerHTML = `<span style="color: #f44336; font-size: 13px; font-weight: 500; margin-top: 8px; display: block;">✕ Something went wrong. Try again.</span>`;
      }
    }

    // 2. Remove Discount
    const removeBtn = e.target.closest('[data-remove-coupon]');
    if (removeBtn && !removeBtn.closest('.cart-drawer')) {
      const originalText = removeBtn.textContent;
      removeBtn.textContent = 'Removing...';
      removeBtn.disabled = true;

      try {
        // Clear Shopify session using multiple methods for reliability
        await fetch('/discount/NONE?t=' + Date.now(), { cache: 'no-store' }); 
        await fetch('/discount/1?t=' + Date.now(), { cache: 'no-store' }); 
        await fetch('/discount/CLEAR?t=' + Date.now(), { cache: 'no-store' }); 
        await fetch('/discount/ ?t=' + Date.now(), { cache: 'no-store' }); 
        await fetch('/checkout?discount=&t=' + Date.now(), { cache: 'no-store' }); // Clear from checkout session
        await new Promise(resolve => setTimeout(resolve, 1000));
        await fetch('/cart.js', { cache: 'no-store' }); // Wake up cart session
        
        localStorage.removeItem('cart_applied_discount');
        localStorage.setItem('cart_discount_cleared', 'true');
        localStorage.setItem('cart_discount_clearing', 'true');

        await fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ attributes: { 'user_applied_coupon': '', 'user_applied_discount': '' } })
        });
        
        setTimeout(() => {
          localStorage.removeItem('cart_discount_clearing');
        }, 5000);

        const cart = await (await fetch('/cart.js', { cache: 'no-store' })).json();
        updateCartUI(cart);
        
        // Update URL without reload to strip any discount codes
        const cleanURL = window.location.protocol + "//" + window.location.host + window.location.pathname;
        window.history.replaceState({}, '', cleanURL);
        
        // Refresh cart section via AJAX
        document.dispatchEvent(new CustomEvent('cart:updated'));
      } catch (err) {
        removeBtn.textContent = originalText;
        removeBtn.disabled = false;
      }
    }
  });

  // Handle Enter key for discount input
  cartForm.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && e.target.closest('[data-discount-input]')) {
      e.preventDefault();
      const container = e.target.closest('[data-discount-form-container]');
      const applyBtn = container ? container.querySelector('[data-apply-coupon]') : null;
      if (applyBtn && applyBtn.style.display !== 'none') {
        applyBtn.click();
      }
    }
  });

  // Clear error message on typing
  cartForm.addEventListener('input', function(e) {
    if (e.target.closest('[data-discount-input]')) {
       const container = e.target.closest('[data-discount-form-container]');
       const messageEl = container ? container.querySelector('[data-discount-message]') : null;
       if (messageEl) messageEl.innerHTML = '';
    }
  });

  // Initialization: Restore state from localStorage
  let storedDiscount = localStorage.getItem('cart_applied_discount');
  const formEl = document.querySelector('.cart-form');
  const liquidDiscountCode = formEl ? formEl.getAttribute('data-cart-discount-code') : '';
  const initialTotalDiscount = formEl ? parseInt(formEl.getAttribute('data-cart-total-discount')) || 0 : 0;
  const isClearing = localStorage.getItem('cart_discount_clearing');
  const hasBeenCleared = localStorage.getItem('cart_discount_cleared');

  if (liquidDiscountCode) {
    // Always trust the server: if Liquid says there's a discount, it's there.
    storedDiscount = liquidDiscountCode;
    localStorage.setItem('cart_applied_discount', storedDiscount);
    localStorage.removeItem('cart_discount_cleared');
    localStorage.removeItem('cart_discount_clearing');
  } else {
    // If Liquid says there is NO discount code active... 
    // And there's no money being discounted...
    if (initialTotalDiscount === 0 && !isClearing) {
      // Then the discount has been removed (probably at checkout)
      storedDiscount = null;
      localStorage.removeItem('cart_applied_discount');
    }
  }

  if (storedDiscount && !isClearing) {
    // A discount was manually applied — restore UI to "applied" state
    document.querySelectorAll('[data-discount-input]').forEach(input => {
      input.value = storedDiscount;
    });
    document.querySelectorAll('[data-apply-coupon]').forEach(btn => btn.style.display = 'none');
    document.querySelectorAll('[data-remove-coupon]').forEach(btn => btn.style.display = 'block');
    
    // Show discount rows only when there is an actual discount reported by server
    if (initialTotalDiscount > 0) {
      document.querySelectorAll('[data-discount-row]').forEach(row => row.style.display = 'flex');
      document.querySelectorAll('[data-discounts-container]').forEach(c => c.style.display = 'block');
    } else {
      document.querySelectorAll('[data-discount-row]').forEach(row => row.style.display = 'none');
      document.querySelectorAll('[data-discounts-container]').forEach(c => c.style.display = 'none');
    }
    localStorage.removeItem('cart_discount_clearing');
  } else {
    // No discount active — reset UI to default "Apply" state
    if (isClearing) {
       // Still clearing, don't reset inputs yet but show Apply button
    } else {
       localStorage.removeItem('cart_applied_discount');
       document.querySelectorAll('[data-discount-input]').forEach(input => input.value = '');
    }
    document.querySelectorAll('[data-apply-coupon]').forEach(btn => btn.style.display = 'block');
    document.querySelectorAll('[data-remove-coupon]').forEach(btn => btn.style.display = 'none');
    document.querySelectorAll('[data-discount-row]').forEach(row => row.style.display = 'none');
    document.querySelectorAll('[data-discounts-container]').forEach(c => c.style.display = 'none');
  }

  // Add recommendations to cart (Delegated)
  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('[data-add-recommendation]');
    if (!btn || btn.closest('.cart-drawer')) return; // Drawer handles its own

    e.preventDefault();
    const variantId = btn.dataset.variantId;
    if (!variantId) return;

    btn.textContent = 'Adding...';
    try {
      const response = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
      });
      if (response.ok) {
        document.dispatchEvent(new CustomEvent('cart:updated'));
        btn.textContent = 'Added!';
        setTimeout(() => { btn.textContent = 'Add To Cart'; }, 2000);
      }
    } catch (err) {
      btn.textContent = 'Add To Cart';
    }
  });



  // Initialize table shipping calculator
  if (typeof Shopify !== 'undefined' && Shopify.CountryProvinceSelector) {
    if (document.getElementById('address_country_table')) {
      new Shopify.CountryProvinceSelector('address_country_table', 'address_province_table', {
        hideElement: 'address_province_container_table'
      });
    }
  }

  // Sync with drawer and other components using Section Rendering API
  document.addEventListener('cart:updated', async () => {
    const mainSection = document.getElementById('MainCartSection');
    if (!mainSection) return;
    
    // Preserve state before refresh
    const termsCheck = document.querySelector('[data-terms-checkbox]');
    const isTermsChecked = termsCheck ? termsCheck.checked : false;
    const discountInputs = document.querySelectorAll('[data-discount-input]');
    const discountValues = Array.from(discountInputs).map(input => input.value);
    
    const sectionId = mainSection.dataset.sectionId;
    try {
      const response = await fetch(`${window.location.pathname}?section_id=${sectionId}`);
      if (response.ok) {
        const html = await response.text();
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');
        const newContent = doc.getElementById('MainCartSection');
        
        if (newContent) {
          mainSection.innerHTML = newContent.innerHTML;
          
          // Re-apply preserved state
          const newTermsCheck = document.querySelector('[data-terms-checkbox]');
          if (newTermsCheck) {
              newTermsCheck.checked = isTermsChecked;
              newTermsCheck.dispatchEvent(new Event('change', { bubbles: true }));
          }
          document.querySelectorAll('[data-discount-input]').forEach((input, i) => {
              if (discountValues[i]) input.value = discountValues[i];
          });

          // Re-initialize components
          initCartPageCountdown();
          if (typeof Shopify !== 'undefined' && Shopify.CountryProvinceSelector) {
            if (document.getElementById('address_country')) {
              new Shopify.CountryProvinceSelector('address_country', 'address_province', {
                hideElement: 'address_province_container_page'
              });
            }
            if (document.getElementById('address_country_table')) {
              new Shopify.CountryProvinceSelector('address_country_table', 'address_province_table', {
                hideElement: 'address_province_container_table'
              });
            }
          }
          
          // Refresh total discount/attributes for the form
          const cart = await (await fetch('/cart.js')).json();
          updateCartUI(cart); 
        }
      }
    } catch (err) {
    }
  });

  // Terms & Conditions enforcement for the cart page
  const termsCheckboxes = document.querySelectorAll('[data-terms-checkbox]');
  const checkoutButtons = document.querySelectorAll('button[name="checkout"], [data-checkout-btn]');

  if (termsCheckboxes.length > 0) {
    const handleCheckoutClick = (e) => {
      const checkbox = document.querySelector('[data-terms-checkbox]');
      if (checkbox && !checkbox.checked) {
        checkbox.reportValidity();
        e.preventDefault();
        e.stopPropagation();
      }
    };

    checkoutButtons.forEach(btn => {
      btn.removeAttribute('disabled');
      btn.style.pointerEvents = 'auto';
      btn.style.opacity = '1';
      btn.addEventListener('click', handleCheckoutClick, true);
    });

    // Handle additional payment buttons (if any)
    const additionalButtons = document.querySelectorAll('.cart-drawer__additional-buttons, .additional-checkout-buttons');
    if (additionalButtons.length > 0) {
      additionalButtons.forEach(wrap => {
         wrap.classList.remove('hidden-additional-buttons'); // Ensure visible
      });
    }
  }
});
</script>

