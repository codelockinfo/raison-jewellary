

{% liquid
  assign badge_position = settings.badge_position_on_cards | default: 'top_left'
  assign badge_corner_radius = settings.badge_corner_radius | default: 4

  # Visibility logic: Use card_settings if passed (for section-level control), fallback to global settings
  assign show_sale_badge = true
  if card_settings.show_badge != nil
    assign show_sale_badge = card_settings.show_badge
  elsif card_settings.show_sale_badge != nil
    assign show_sale_badge = card_settings.show_sale_badge
  elsif settings.show_badge != nil
    assign show_sale_badge = settings.show_badge
  elsif settings.show_sale_badge != nil
    assign show_sale_badge = settings.show_sale_badge
  endif

  assign show_sold_out_badge = true
  if card_settings.show_sold_out_badge != nil
    assign show_sold_out_badge = card_settings.show_sold_out_badge
  elsif settings.show_sold_out_badge != nil
    assign show_sold_out_badge = settings.show_sold_out_badge
  endif

  assign is_on_sale = false
  assign is_sold_out = false

  if show_sale_badge
    if product.compare_at_price > product.price and product.compare_at_price > 0
      assign is_on_sale = true
    elsif product.compare_at_price_min > product.price_min and product.compare_at_price_min > 0
      assign is_on_sale = true
    endif
  endif

  if show_sold_out_badge and product.available == false
    assign is_sold_out = true
  endif
%}

{% if is_on_sale or is_sold_out %}
  <div class="product-card__badges product-card__badges--{{ badge_position }}">

    {%- comment -%}
      Badge priority:
      Sold Out > Sale
    {%- endcomment -%}

    {% if is_sold_out %}
      <span
        class="product-card__badge product-card__badge--sold-out"
        style="
          background-color: {{ settings.badge_sold_out_background_color | default: '#000000' }};
          color: {{ settings.badge_sold_out_text_color | default: '#FEFEFE' }};
          border-radius: {{ badge_corner_radius }}px;
        "
      >
        {{ settings.badge_sold_out_text | default: 'Sold Out' }}
      </span>
    {% endif %}

    {% if is_on_sale %}
      {% liquid
        assign sale_bg = settings.badge_color | default: settings.badge_sale_background_color | default: '#ff0000'
        assign sale_text = settings.badge_text_color | default: settings.badge_sale_text_color | default: '#FEFEFE'
      %}
      <span
        class="product-card__badge product-card__badge--sale"
        style="
          background-color: {{ sale_bg }};
          color: {{ sale_text }};
          border-radius: {{ badge_corner_radius }}px;
        "
      >
        {% if settings.badge_sale_text != blank %}
          {{ settings.badge_sale_text }}
        {% else %}
          Sale
        {% endif %}
      </span>
    {% endif %}

  </div>
{% endif %}

