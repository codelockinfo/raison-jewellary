{% comment %}
  Renders a skeleton loader for various components
  Usage: {% render 'skeleton-loader', type: 'product-card', count: 4, grid_class: 'grid' %}
{% endcomment %}

{% case type %}
  {% when 'product-card' %}
    <div class="{{ grid_class | default: 'skeleton-grid' }}">
      {% for i in (1..count) %}
        <div class="skeleton-card" style="padding: 15px; border: 1px solid #f0f0f0; border-radius: 8px;">
          <div class="skeleton-box skeleton-shimmer" style="width: 100%; aspect-ratio: 1/1; border-radius: 8px; margin-bottom: 15px;"></div>
          <div class="skeleton-box skeleton-shimmer skeleton-text" style="width: 80%; margin-bottom: 10px;"></div>
          <div class="skeleton-box skeleton-shimmer skeleton-text short"></div>
        </div>
      {% endfor %}
    </div>

  {% when 'banner' %}
    <div class="skeleton-banner" style="width: 100%; height: 600px; display: flex; align-items: center; justify-content: center; background: #fafafa;">
      <div class="container_width" style="display: flex; gap: 40px; align-items: center;">
        <div class="skeleton-box skeleton-shimmer" style="flex: 1; height: 400px; border-radius: 20px;"></div>
        <div style="flex: 1;">
          <div class="skeleton-box skeleton-shimmer skeleton-title" style="height: 60px; width: 80%;"></div>
          <div class="skeleton-box skeleton-shimmer skeleton-text long"></div>
          <div class="skeleton-box skeleton-shimmer skeleton-text medium"></div>
          <div class="skeleton-box skeleton-shimmer skeleton-button" style="margin-top: 30px;"></div>
        </div>
      </div>
    </div>

  {% when 'review' %}
    <div class="{{ grid_class | default: 'skeleton-grid' }}" style="display: flex; gap: 20px; overflow: hidden;">
      {% for i in (1..count) %}
        <div class="skeleton-review" style="flex: 1; min-width: 300px; padding: 25px; background: #FEFEFE; border-radius: 15px; border: 1px solid #f5f5f5;">
          <div style="display: flex; gap: 15px; margin-bottom: 20px;">
             <div class="skeleton-box skeleton-shimmer" style="width: 80px; height: 80px; border-radius: 10px;"></div>
             <div style="flex: 1;">
                <div class="skeleton-box skeleton-shimmer skeleton-text short"></div>
                <div class="skeleton-box skeleton-shimmer skeleton-text long"></div>
             </div>
          </div>
          <div class="skeleton-box skeleton-shimmer skeleton-text long"></div>
          <div class="skeleton-box skeleton-shimmer skeleton-text medium"></div>
        </div>
      {% endfor %}
    </div>

  {% when 'product-showcase' %}
    <div class="{{ grid_class | default: 'skeleton-grid' }}" style="--grid-gap: {{ gap | default: '20px' }}px; --grid-columns: {{ count | default: 4 }};">
      {% for i in (1..count) %}
        <div class="skeleton-showcase-card" style="position: relative; height: 535px; background: #FEFEFE; border-radius: 20px; overflow: hidden; border: 1px solid #f0f0f0;">
          <div class="skeleton-box skeleton-shimmer" style="width: 100%; height: 100%;"></div>
          <div style="position: absolute; bottom: 10px; left: 10px; right: 10px; background: rgba(255,255,255,0.9); padding: 15px; border-radius: 12px; display: flex; gap: 15px; align-items: center;">
            <div class="skeleton-box skeleton-shimmer" style="width: 50px; height: 50px; border-radius: 8px; flex-shrink: 0;"></div>
            <div style="flex: 1;">
              <div class="skeleton-box skeleton-shimmer skeleton-text" style="width: 70%; margin-bottom: 8px;"></div>
              <div class="skeleton-box skeleton-shimmer skeleton-text short"></div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

  {% when 'collection-slider-list' %}
    <div class="skeleton-collection-slider" style="display: flex; gap: 20px; overflow: hidden; padding: 60px 0;">
      {% for i in (1..count) %}
        <div class="skeleton-collection-card" style="width: 380px; height: 700px; background: #FEFEFE; border-radius: 20px; flex-shrink: 0; position: relative; overflow: hidden; border: 1px solid #f0f0f0;">
          <div class="skeleton-box skeleton-shimmer" style="width: 100%; height: 100%;"></div>
          <div style="position: absolute; bottom: 30px; left: 24px; right: 24px;">
            <div class="skeleton-box skeleton-shimmer skeleton-title" style="height: 30px; width: 60%; margin-bottom: 10px;"></div>
            <div class="skeleton-box skeleton-shimmer skeleton-text" style="width: 80%;"></div>
          </div>
        </div>
      {% endfor %}
    </div>

  {% when 'store-locations' %}
    <div class="skeleton-store-locations" style="display: flex; flex-direction: column; gap: 40px; padding: 60px 0;">
      <div style="display: flex; gap: 40px; align-items: flex-start;">
        <div class="skeleton-box skeleton-shimmer" style="flex: 1; height: 500px; border-radius: 20px;"></div>
        <div style="flex: 1; padding: 40px 0;">
          <div class="skeleton-box skeleton-shimmer skeleton-title" style="height: 40px; width: 50%; margin-bottom: 30px;"></div>
          <div class="skeleton-box skeleton-shimmer skeleton-text" style="width: 80%; margin-bottom: 15px;"></div>
          <div class="skeleton-box skeleton-shimmer skeleton-text" style="width: 60%; margin-bottom: 15px;"></div>
          <div class="skeleton-box skeleton-shimmer skeleton-text" style="width: 70%; margin-bottom: 40px;"></div>
          <div class="skeleton-box skeleton-shimmer skeleton-button" style="width: 150px; height: 50px;"></div>
        </div>
      </div>
    </div>

  {% when 'featured-product-split' %}
    <div class="skeleton-product-split" style="display: flex; gap: 40px; padding: 60px 0;">
      <!-- Main Content -->
      <div style="flex: 1; display: flex; gap: 40px;">
        <div class="skeleton-box skeleton-shimmer" style="width: 50%; aspect-ratio: 1/1; border-radius: 8px;"></div>
        <div style="width: 50%;">
          <div class="skeleton-box skeleton-shimmer skeleton-title" style="height: 48px; width: 60%; margin-bottom: 20px;"></div>
          <div class="skeleton-box skeleton-shimmer skeleton-text" style="width: 40%; height: 30px; margin-bottom: 30px;"></div>
          <div class="skeleton-box skeleton-shimmer skeleton-text long" style="margin-bottom: 15px;"></div>
          <div class="skeleton-box skeleton-shimmer skeleton-text medium" style="margin-bottom: 40px;"></div>
          <div class="skeleton-box skeleton-shimmer skeleton-button" style="width: 100%; height: 50px; border-radius: 30px;"></div>
        </div>
      </div>
    </div>
    <!-- Thumbnails at bottom (mirrored from code position) -->
    <div style="display: flex; gap: 10px; margin-top: 20px;">
      {% for i in (1..6) %}
        <div class="skeleton-box skeleton-shimmer" style="width: 100px; height: 100px; border-radius: 8px;"></div>
      {% endfor %}
    </div>

{% endcase %}

<style>
  .skeleton-grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns, 4), 1fr);
    gap: var(--grid-gap, 20px);
  }
  @media (max-width: 768px) {
    .skeleton-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

