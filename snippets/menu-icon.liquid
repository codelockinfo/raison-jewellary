{% comment %}
  Generates SVG icon for menu items
  Usage: {% render 'menu-icon', handle: menu_handle %}
{% endcomment %}

{% liquid
  assign icon_handle = handle | default: ''
  assign icon_name_dash = icon_handle | append: '.svg'
  assign icon_name_space = icon_handle | replace: '-', ' ' | append: '.svg'
%}

{% comment %} Try to load from assets first {% endcomment %}


{% comment %} Check if dash version exists {% endcomment %}
{% if icon_name_dash != blank %}
  {% comment %} We'll use JavaScript to check if file exists {% endcomment %}
{% endif %}

<svg 
  xmlns="https://www.w3.org/2000/svg" 
  width="18" 
  height="18" 
  viewBox="0 0 24 24" 
  fill="none"
  class="menu-icon-svg"
  data-handle="{{ icon_handle }}"
  data-icon-dash="{{ icon_name_dash | asset_url }}"
  data-icon-space="{{ icon_name_space | asset_url }}"
>
  <path 
    d="M4 14.7519C3.37037 13.8768 3 12.8059 3 11.6493C3 9.20008 4.8 6.9375 7.5 6.5C8.34694 4.48637 10.3514 3 12.6893 3C15.684 3 18.1317 5.32251 18.3 8.25C19.8893 8.94488 21 10.6503 21 12.4969C21 13.5693 20.6254 14.5541 20 15.3275M12.5 12.9995L10.5 21.0008M8.5 11.9995L6.5 20.0008M16.5 12L14.5 20.0013" 
    stroke="currentColor" 
    stroke-width="2" 
    stroke-linecap="round" 
    stroke-linejoin="round"
  />
</svg>

<script>
  (function() {
    const svg = document.querySelector('.menu-icon-svg[data-handle="{{ icon_handle }}"]');
    if (!svg) return;
    
    const handle = svg.dataset.handle;
    const iconDash = svg.dataset.iconDash;
    const iconSpace = svg.dataset.iconSpace;
    
    // Try to load external SVG file
    function loadIcon(url, fallbackUrl) {
      fetch(url)
        .then(response => {
          if (response.ok) {
            return response.text();
          }
          throw new Error('Not found');
        })
        .then(svgContent => {
          // Replace current SVG with loaded content
          const parser = new DOMParser();
          const doc = parser.parseFromString(svgContent, 'image/svg+xml');
          const loadedSvg = doc.querySelector('svg');
          if (loadedSvg) {
            loadedSvg.setAttribute('width', '18');
            loadedSvg.setAttribute('height', '18');
            loadedSvg.setAttribute('class', 'menu-icon-svg');
            svg.parentNode.replaceChild(loadedSvg, svg);
          }
        })
        .catch(() => {
          // Try fallback
          if (fallbackUrl && fallbackUrl !== url) {
            loadIcon(fallbackUrl, null);
          }
        });
    }
    
    // Start loading
    if (iconDash) {
      loadIcon(iconDash, iconSpace);
    }
  })();
</script>

