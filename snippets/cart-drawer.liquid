{% liquid
  assign free_shipping_threshold = 50000 | default: 50000
  assign cart_total = cart.total_price
  assign remaining_amount = free_shipping_threshold | minus: cart_total
  assign progress_percentage = cart_total | times: 100 | divided_by: free_shipping_threshold
  if progress_percentage > 100
    assign progress_percentage = 100
  endif
  assign has_free_shipping = false
  if cart_total >= free_shipping_threshold
    assign has_free_shipping = true
  endif
  assign show_vendor = settings.show_cart_vendor
  assign show_cart_note = settings.cart_notes_enable
  assign cart_type = settings.cart_type | default: 'drawer'
  assign show_discount_code = settings.discount_code_enable
  assign show_shipping_calculator = settings.cart_estimate_shipping
  assign show_trust_badge = false
  if settings.cart_drawer_trust_badge != blank
    assign show_trust_badge = true
  endif
  assign show_accelerated_checkout = settings.cart_drawer_show_accelerated_button
  assign show_delivery_days = settings.show_delivery_days
  assign show_delivery_time = settings.delivery_time_enable
%}
<div class="cart-drawer" data-cart-drawer data-cart-type="{{ cart_type }}" data-cart-discount-code="{%- for app in cart.discount_applications -%}{{ app.title | escape }}{% break %}{%- endfor -%}" data-cart-total-discount="{{ cart.total_discount }}" style="display: none;">
  <div class="cart-drawer__overlay" data-cart-drawer-close></div>
  <div class="cart-drawer__content">
    <div class="cart-drawer__header">
      <div class="cart-drawer__title">Shopping Cart (<span data-cart-count>{{ cart.item_count }}</span>)</div>
      <button class="cart-drawer__close" aria-label="Close cart" data-cart-drawer-close>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <div class="cart-drawer__shipping-progress" data-shipping-progress {% if cart.item_count == 0 %}style="display: none;"{% endif %}>
      <div class="shipping-progress-bar">
        <div class="shipping-progress-bar__fill" style="width: {{ progress_percentage }}%"></div>
        <div class="shipping-progress-bar__icon">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13"></rect>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 10"></polygon>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
          </svg>
        </div>
      </div>
      {% if has_free_shipping %}
        <p class="shipping-progress__message shipping-progress__message--success">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M13.3333 4L6 11.3333L2.66667 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Congratulations! You've got free shipping!
        </p>
      {% else %}
        <p class="shipping-progress__message">
          Add 
          {%- liquid
            if settings.currency_code_enabled
              assign money_remaining = remaining_amount | money_with_currency
            else
              assign money_remaining = remaining_amount | money
            endif
          -%}
          {% if cart.currency.iso_code == 'EUR' %}
            {{ money_remaining | replace: '.', 'TEMP' | replace: ',', '.' | replace: 'TEMP', ',' }}
          {% elsif cart.currency.iso_code == 'INR' %}
            {{ money_remaining | replace: 'Rs.', '₹' | replace: 'Rs', '₹' }}
          {% else %}
            {{ money_remaining }}
          {% endif %}
          more to get free shipping!
        </p>
      {% endif %}
      {% unless has_free_shipping %}
        <p class="shipping-progress__warning">
          You're out of time! Checkout now to avoid losing your order!
        </p>
      {% endunless %}
    </div>
    
    <div class="cart-drawer__countdown" {% if cart.item_count == 0 %}style="display: none;"{% endif %}>
      <span class="countdown-icon">🔥</span>
      <span class="countdown-text" style= "color:#000;">Products are limited, checkout within <span id="cart-countdown-timer">00 m 00 s</span></span>
    </div>
    <div class="m-cartitems" style="flex: 1; overflow-y: auto;">
     <div class="cart-drawer__items" data-cart-items>
      {% if cart.item_count > 0 %}
        {% for item in cart.items %}
          <div class="cart-item" data-cart-item data-item-key="{{ item.key }}">
            <div class="cart-item__image">
              {% if item.image %}
                {% render 'image', 
                  image: item.image, 
                  url: item.url,
                  width: 120,
                  height: 120,
                  class: 'cart-item__img'
                %}
              {% else %}
                <a href="{{ item.url }}">
                  {{ 'product-2.svg' | asset_url | image_tag: alt: item.title, class: 'cart-item__img', width: 120, height: 120 }}
                </a>
              {% endif %}
            </div>
            <div class="cart-item__details">
              <h3 class="cart-item__title">
                <a href="{{ item.url }}">{{ item.product.title }}</a>
              </h3>
              {% if show_vendor and item.product.vendor != blank %}
                <p class="cart-item__vendor">{{ item.product.vendor }}</p>
              {% endif %}
              {% if item.variant.title != 'Default Title' %}
                <p class="cart-item__variant">{{ item.variant.title }}</p>
              {% endif %}
              <div class="cart-item__price">
                {% if item.original_price != item.final_price %}
                  <span class="cart-item__price--original">
                    {%- liquid
                      if settings.currency_code_enabled
                        assign money_original_price = item.original_price | money_with_currency
                      else
                        assign money_original_price = item.original_price | money
                      endif
                    -%}
                    {% if cart.currency.iso_code == 'EUR' %}
                      {{ money_original_price | replace: '.', 'TEMP' | replace: ',', '.' | replace: 'TEMP', ',' }}
                    {% elsif cart.currency.iso_code == 'INR' %}
                      {{ money_original_price | replace: 'Rs.', '₹' | replace: 'Rs', '₹' }}
                    {% else %}
                      {{ money_original_price }}
                    {% endif %}
                  </span>
                {% endif %}
                  <span class="cart-item__price--current">
                    {%- liquid
                      if settings.currency_code_enabled
                        assign money_final_price = item.final_price | money_with_currency
                      else
                        assign money_final_price = item.final_price | money
                      endif
                    -%}
                    {% if cart.currency.iso_code == 'EUR' %}
                      {{ money_final_price | replace: '.', 'TEMP' | replace: ',', '.' | replace: 'TEMP', ',' }}
                    {% elsif cart.currency.iso_code == 'INR' %}
                      {{ money_final_price | replace: 'Rs.', '₹' | replace: 'Rs', '₹' }}
                    {% else %}
                      {{ money_final_price }}
                    {% endif %}
                  </span>
              </div>
              <div class="cart-item__quantity">
                {% render 'quantity-input', 
                  value: item.quantity, 
                  item_key: item.key,
                  container_class: 'cart-item__quantity-selector',
                  data_attributes: 'data-quantity-input',
                  minus_attributes: 'data-quantity-decrease',
                  plus_attributes: 'data-quantity-increase'
                %}
              </div>
            </div>
            <button 
              type="button" 
              class="cart-item__remove" 
              aria-label="Remove {{ item.title | escape }}"
              data-remove-item
              data-item-key="{{ item.key }}"
            >
              <svg xmlns="https://www.w3.org/2000/svg" width="16" height="18" viewBox="0 0 16 18" fill="none">
<path d="M1.25 4.5H2.75M2.75 4.5H14.75M2.75 4.5L2.75 15C2.75 15.3978 2.90804 15.7794 3.18934 16.0607C3.47064 16.342 3.85218 16.5 4.25 16.5H11.75C12.1478 16.5 12.5294 16.342 12.8107 16.0607C13.092 15.7794 13.25 15.3978 13.25 15V4.5M5 4.5V3C5 2.60218 5.15804 2.22064 5.43934 1.93934C5.72064 1.65804 6.10218 1.5 6.5 1.5H9.5C9.89782 1.5 10.2794 1.65804 10.5607 1.93934C10.842 2.22064 11 2.60218 11 3V4.5M6.5 8.25V12.75M9.5 8.25V12.75" stroke="#1E1E1E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
            </button>
          </div>
        {% endfor %}
      {% else %}
        <div class="cart-drawer__empty">
          <p>Your cart is empty</p>
          <a href="{{ routes.all_products_collection_url }}" class="cart-drawer__continue-shopping">Continue Shopping</a>
        </div>
      {% endif %}
    </div>
  </div>
    <div class="cart-drawer__recommendations" {% if cart.item_count == 0 %}style="display: none;"{% endif %}>
      <div class="cart-drawer__recommendations-title">Frequently bought together</div>
      <div class="swiper cart-drawer__recommendations-slider" data-recommendations-slider>
        <div class="swiper-wrapper">
          {% comment %} Get recommended products - exclude cart items {% endcomment %}
          {% assign cart_product_ids = '' %}
          {% for item in cart.items %}
            {% assign cart_product_ids = cart_product_ids | append: item.product.id | append: ',' %}
          {% endfor %}
          
          {% assign recommendations_count = 0 %}
          {% for product in collections.all.products limit: 20 %}
            {% unless cart_product_ids contains product.id or product.available == false %}
              {% if recommendations_count < 5 %}
                <div class="swiper-slide">
                  <div class="recommendation-item">
                    <div class="recommendation-item__image">
                      {% if product.featured_image %}
                        {% render 'image', 
                          image: product.featured_image, 
                          url: product.url,
                          width: 60,
                          height: 60,
                          class: 'recommendation-item__img'
                        %}
                      {% else %}
                        <a href="{{ product.url }}">
                          <div class="recommendation-item__placeholder">
                            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                          </div>
                        </a>
                      {% endif %}
                    </div>
                    <div class="recommendation-item__content">
                      <div class="recommendation-item__info">
                          <div class="recommendation-item__title">
                            <a href="{{ product.url }}">{{ product.title }}</a>
                          </div>
                      </div>
                      <div class="recommendation-item__actions">
                          <p class="recommendation-item__price">
                            {%- liquid
                              if settings.currency_code_enabled
                                assign money_product_price = product.price | money_with_currency
                              else
                                assign money_product_price = product.price | money
                              endif
                            -%}
                            {% if cart.currency.iso_code == 'EUR' %}
                              {{ money_product_price | replace: '.', 'TEMP' | replace: ',', '.' | replace: 'TEMP', ',' }}
                            {% elsif cart.currency.iso_code == 'INR' %}
                              {{ money_product_price | replace: 'Rs.', '₹' | replace: 'Rs', '₹' }}
                            {% else %}
                              {{ money_product_price }}
                            {% endif %}
                          </p>
                          {% assign first_variant = product.selected_or_first_available_variant %}
                          {% if first_variant %}
                            <button 
                              type="button" 
                              class="recommendation-item__add-btn" 
                              aria-label="Add {{ product.title | escape }} to cart"
                              data-add-recommendation
                              data-product-id="{{ product.id }}"
                              data-variant-id="{{ first_variant.id }}"
                            >
                              ADD
                            </button>
                          {% else %}
                            <button class="recommendation-item__add-btn recommendation-item__add-btn--disabled" disabled aria-label="Sold out">
                              SOLD
                            </button>
                          {% endif %}
                      </div>
                    </div>
                  </div>
                </div>
                {% assign recommendations_count = recommendations_count | plus: 1 %}
              {% endif %}
            {% endunless %}
          {% endfor %}
          
          {% if recommendations_count == 0 %}
            <div class="swiper-slide">
              <div class="recommendation-item">
               <p style="padding: 10px; width: 100%; text-align: center; color: #666;">No recommendations available</p>
              </div>
            </div>
          {% endif %}
        </div>
      </div>
      <div class="cart-drawer__recommendations-dots" data-recommendations-dots></div>
    </div>
   <div class="cart-drawer__footer" {% if cart.item_count == 0 %}style="display: none;"{% endif %}>
        <div class="cart-drawer__addons-row">
          {% if show_cart_note %}
            <button type="button" class="cart-drawer__addon-btn" data-toggle-addon="note" aria-label="Add Note" data-label="Add Note">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            </button>
          {% endif %}
          
          {% if show_shipping_calculator %}
            <button type="button" class="cart-drawer__addon-btn" data-toggle-addon="shipping" aria-label="Estimate Shipping" data-label="Estimate Shipping">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </button>
          {% endif %}

          {% if show_discount_code %}
            <button type="button" class="cart-drawer__addon-btn" data-toggle-addon="coupon" aria-label="Add Coupon" data-label="Add Coupon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-1.414 1.414L15 7.828l1.414-1.414L15 5zM9 19l-1.414-1.414L9 16.172l1.414 1.414L9 19zM21 11V5h-6m0 0l-5 5m5-5H5v14h14v-9m0 0l-5 5"/></svg>
            </button>
          {% endif %}
        </div>

        {% if show_cart_note %}
          <div class="cart-drawer__note cart-drawer__addon-content" data-addon-content="note" style="display: none;">
            <div class="cart-drawer__note-header">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                <label for="cart-note" class="cart-drawer__note-title">Tell us how we can make this order just right</label>
            </div>
            <textarea 
              id="cart-note" 
              name="note" 
              class="cart-drawer__note-input" 
              placeholder="Please add any order or delivery instructions we should take note of"
              data-cart-note
            >{{ cart.note }}</textarea>
            <div class="cart-drawer__note-actions">
                <button type="button" class="cart-drawer__note-btn cart-drawer__note-btn--cancel" aria-label="Cancel" data-note-cancel>CANCEL</button>
                <button type="button" class="cart-drawer__note-btn cart-drawer__note-btn--save" aria-label="Save" data-note-save>SAVE</button>
            </div>
          </div>
        {% endif %}

        {% if show_shipping_calculator %}
          <div class="cart-drawer__shipping-estimator cart-drawer__addon-content" data-addon-content="shipping" style="display: none;">
            <div class="cart-drawer__shipping-content">
              <div class="cart-drawer__note-header">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                <h3 class="cart-drawer__note-title">Estimate shipping rates</h3>
              </div>
              
              <div class="cart-drawer__shipping-field">
                <label for="drawer_address_country" class="cart-drawer__field-label">Country</label>
                <select id="drawer_address_country" name="address[country]" class="cart-drawer__field-input" data-default="{{ settings.default_country_estimate_shipping }}">{{ country_option_tags }}</select>
              </div>

              <div id="drawer_address_province_container" class="cart-drawer__shipping-field" style="display:none;">
                <label for="drawer_address_province" class="cart-drawer__field-label">Province</label>
                <select id="drawer_address_province" name="address[province]" class="cart-drawer__field-input" data-default=""></select>
              </div>

                <label for="drawer_address_zip" class="cart-drawer__field-label">Postal/Zip Code</label>
                <input type="text" id="drawer_address_zip" name="address[zip]" class="cart-drawer__field-input" placeholder="Postal/Zip Code">

              <div class="cart-drawer__note-actions">
                  <button type="button" class="cart-drawer__note-btn cart-drawer__note-btn--cancel" aria-label="Cancel" data-shipping-cancel>CANCEL</button>
                  <button type="button" class="cart-drawer__note-btn cart-drawer__note-btn--save" aria-label="Calculate" data-calculate-shipping>CALCULATE</button>
              </div>
              
              {% if show_delivery_days %}
                <div class="cart-drawer__delivery-info">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  <span>Estimated delivery: 3-5 business days</span>
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}

        {% if show_discount_code %}
          <div class="cart-drawer__discount cart-drawer__addon-content" data-addon-content="coupon" style="display: none;">
             {% render 'cart-discount-form', label: 'Add Coupon', show_label: true %}
          </div>
        {% endif %}

        {% if show_delivery_time %}
          <div class="cart-drawer__delivery-time-info">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            <span>Standard delivery time: 9:00 AM - 6:00 PM</span>
          </div>
        {% endif %}

        <div class="cart-drawer__subtotal">
          <span class="cart-drawer__subtotal-label">Subtotal</span>
          <div class="cart-drawer__subtotal-wrapper" style="display: flex; flex-direction: column; align-items: flex-end;">
            <div data-discount-wrapper style="display: none; align-items: center; gap: 8px; margin-bottom: 4px;">
              <span style="font-size: 13px; color: #888; text-decoration: line-through;" data-cart-original-total></span>
              <span style="font-size: 12px; background: #e8f5e9; color: #2e7d32; padding: 2px 6px; border-radius: 4px; font-weight: 500;" data-cart-discount-amount></span>
            </div>
            {%- liquid
              assign is_manual_active = false
              if cart.discount_applications.size > 0
                assign is_manual_active = true
              endif

              assign displayed_total = cart.total_price
              if is_manual_active == false and cart.total_discount > 0
                assign displayed_total = cart.total_price | plus: cart.total_discount
              endif
            -%}
            <span class="cart-drawer__subtotal-amount" data-cart-total>
              {%- liquid
                if settings.currency_code_enabled
                  assign money_displayed_total = displayed_total | money_with_currency
                else
                  assign money_displayed_total = displayed_total | money
                endif
              -%}
              {% if cart.currency.iso_code == 'EUR' %}
                {{ money_displayed_total | replace: '.', 'TEMP' | replace: ',', '.' | replace: 'TEMP', ',' }}
              {% elsif cart.currency.iso_code == 'INR' %}
                {{ money_displayed_total | replace: 'Rs.', '₹' | replace: 'Rs', '₹' }}
              {% else %}
                {{ money_displayed_total }}
              {% endif %}
            </span>
          </div>
        </div>

        {% if show_trust_badge %}
          <div class="cart-drawer__trust-badge">
            <img src="{{ settings.cart_drawer_trust_badge | image_url: width: 400 }}" alt="Trust Badge" loading="lazy" width="{{ settings.cart_drawer_trust_badge.width }}" height="{{ settings.cart_drawer_trust_badge.height }}">
          </div>
        {% endif %}

        {% liquid
          if settings.agree_text != blank and settings.show_agree_on_cart
            render 'agree-terms-checkbox'
          endif
        %}

        <div class="cart-drawer__buttons">
          <a href="{{ routes.cart_url }}" class="cart-drawer__btn cart-drawer__btn--secondary">View Cart</a>
          <div class="cart-drawer__checkout-wrapper" style="flex: 1; display: flex; flex-direction: column; gap: 8px;">
            <a href="/checkout" class="cart-drawer__btn cart-drawer__btn--primary" data-checkout-btn>Checkout</a>
            {% if show_accelerated_checkout and additional_checkout_buttons %}
              <div class="cart-drawer__additional-buttons">
                {{ content_for_additional_checkout_buttons }}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
</div>
<style>
  .cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
    height: 100dvh;
    z-index: 10005;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .cart-drawer.active {
    opacity: 1;
    visibility: visible;
  }
  .cart-drawer__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    cursor: pointer;
  }
  .cart-drawer__content {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    max-width: 420px;
    height: 100%;
    height: 100dvh;
    background: #FEFEFE;
    box-shadow: -2px 0 10px rgba(0, 0, 0, 0.1);
    transform: translateX(100%);
    transition: transform 0.3s ease;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .cart-drawer.active .cart-drawer__content {
    transform: translateX(0);
  }
  .m-cartitems{
    flex: 1;
    overflow-y: auto;
    min-height: 0;
  }
  .cart-drawer__header {
    display: flex;
    margin:10px 15px 5px 15px;
    align-items: center;
    justify-content: space-between;
    padding: 10px
    border-bottom: 1px solid #e0e0e0;
    flex-shrink: 0;
  }
  .cart-drawer__title {
    text-align:center;
    margin: 0;
    font-weight: 600;
    font-size:20px;
    color: #000;
  }
  .cart-drawer__close {
    background: none;
    border: none !important;
    cursor: pointer;
    padding: 0.5rem;
    color: #000;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cart-drawer__shipping-progress {
    padding: 8px 30px 8px 15px;
    border-bottom: 1px solid #e0e0e0;
    flex-shrink: 0;
  }
  .shipping-progress-bar {
    position: relative;
    width: 100%;
    height: 8px;
    background: #e0e0e0;
    border-radius: 4px;
    margin-bottom: 8px;
  }
  .shipping-progress-bar__fill {
    height: 100%;
    background: {{ settings.free_shipping_accent_color | default: '#4caf50' }};
    transition: width 0.3s ease;
    border-radius: 4px;
  }
  .shipping-progress-bar__icon {
    position: absolute;
    top: 50%;
    padding:4px;
    right: -12px;
    transform: translateY(-50%);
    width: 24px;
    height: 24px;
    background: #FEFEFE;
    border: 1px solid {{ settings.free_shipping_accent_color | default: '#4caf50' }};
    border-radius: 50%;
    color: {{ settings.free_shipping_accent_color | default: '#4caf50' }};
