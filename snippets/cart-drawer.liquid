<script>
  (function() {
    class CartDrawer {
      constructor() {
        this.drawer = document.querySelector('[data-cart-drawer]');
        this.closeBtns = document.querySelectorAll('[data-cart-drawer-close]');
        this.quantityInputs = document.querySelectorAll('[data-quantity-input]');
        this.quantityDecreaseBtns = document.querySelectorAll('[data-quantity-decrease]');
        this.quantityIncreaseBtns = document.querySelectorAll('[data-quantity-increase]');
        this.removeBtns = document.querySelectorAll('[data-remove-item]');
        this.recommendationsSwiper = null;
        this.appliedDiscountCode = null; // Only set when user explicitly applies a code

        if (!this.drawer) {
          return;
        }
        
        // Only access drawer elements after confirming drawer exists
        this.checkoutBtn = this.drawer.querySelector('[data-checkout-btn]');
        this.termsCheckbox = this.drawer.querySelector('[data-terms-checkbox]');
        this.cartNoteInput = this.drawer.querySelector('[data-cart-note]');
        
        this.init();
      }

      init() {
        this.checkCartState();
        if (typeof Shopify !== 'undefined' && Shopify.CountryProvinceSelector && document.getElementById('drawer_address_country')) {
          new Shopify.CountryProvinceSelector('drawer_address_country', 'drawer_address_province', {
            hideElement: 'drawer_address_province_container'
          });
        }
        this.cartType = this.getCartType();
        document.addEventListener('click', (e) => {
          const openBtn = e.target.closest('[data-cart-drawer-open]');
          if (openBtn) {
            e.preventDefault();
            e.stopPropagation();
            if (this.cartType === 'drawer' && this.drawer) {
              this.open();
            } else {
              window.location.href = '{{ routes.cart_url }}';
            }
          }
        });
        // Global delegated interactions for Drawer and Cart Page
        document.addEventListener('click', async (e) => {
          // 1. Close button
          if (e.target.closest('[data-cart-drawer-close]')) {
            this.close();
            return;
          }

          // 2. Quantity decrease
          const decreaseBtn = e.target.closest('[data-quantity-decrease]');
          if (decreaseBtn) {
            const itemKey = decreaseBtn.dataset.itemKey;
            this.updateQuantity(itemKey, -1);
            return;
          }

          // 3. Quantity increase
          const increaseBtn = e.target.closest('[data-quantity-increase]');
          if (increaseBtn) {
            const itemKey = increaseBtn.dataset.itemKey;
            this.updateQuantity(itemKey, 1);
            return;
          }

          // 4. Remove item
          const removeBtn = e.target.closest('[data-remove-item]');
          if (removeBtn) {
            const itemKey = removeBtn.dataset.itemKey;
            this.removeItem(itemKey);
            return;
          }

          // 5. Toggle Addons (Note/Shipping/Coupon)
          const toggleBtn = e.target.closest('[data-toggle-addon]');
          if (toggleBtn) {
            e.preventDefault();
            e.stopPropagation();
            const target = toggleBtn.dataset.toggleAddon;
            const content = this.drawer.querySelector(`[data-addon-content="${target}"]`);
            if (content) {
              const isActive = toggleBtn.classList.contains('active');
              
              // Hide others
              this.hideAllAddons();
              
              // Show this one
              if (!isActive) {
                content.style.display = 'block';
                setTimeout(() => content.classList.add('is-open'), 10);
                toggleBtn.classList.add('active');
              }
            }
            return;
          }

          // 6. Recommendation Add to Cart
          const recBtn = e.target.closest('[data-add-recommendation]');
          if (recBtn) {
            e.preventDefault();
            const variantId = recBtn.dataset.variantId;
            if (!variantId) return;
            const originalText = recBtn.textContent;
            recBtn.textContent = 'Adding...';
            recBtn.style.pointerEvents = 'none';
            recBtn.style.opacity = '0.6';
            try {
              const response = await fetch('/cart/add.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
              });
              if (response.ok) {
                await this.refreshCart();
                document.dispatchEvent(new CustomEvent('cart:updated'));
                recBtn.textContent = 'Added!';
                recBtn.style.color = '#4caf50';
                setTimeout(() => {
                  recBtn.textContent = originalText;
                  recBtn.style.color = '';
                  recBtn.style.pointerEvents = '';
                  recBtn.style.opacity = '';
                }, 2000);
              }
            } catch (err) {
              recBtn.textContent = originalText;
              recBtn.style.pointerEvents = '';
            }
            return;
          }

          // 7. Apply Discount
          const discBtn = e.target.closest('[data-apply-coupon]');
          if (discBtn) {
            const container = discBtn.closest('[data-discount-form-container]') || document;
            const input = container.querySelector('[data-discount-input]');
            const code = input ? input.value.trim() : '';
            if (!code) return;
            
            const originalText = discBtn.textContent;
            discBtn.textContent = 'Checking...';
            discBtn.disabled = true;

            const messageEl = container.querySelector('[data-discount-message]');
            if (messageEl) messageEl.innerHTML = ''; // Clear previous messages

            try {
              // Step 1: Apply the discount code via Shopify's discount endpoint
              await fetch(`/discount/${encodeURIComponent(code)}`);

              // Step 2: Wait for Shopify to register the discount
              await new Promise(resolve => setTimeout(resolve, 800));

              // Step 3: Refresh cart to check current state
              const cartRes = await fetch('/cart.js', { cache: 'no-store' });
              const cartAfter = await cartRes.json();

              // Step 4: Check if discount is reflected in cart.js
              const hasApp = cartAfter.discount_applications && cartAfter.discount_applications.some(app =>
                (app.title && app.title.toLowerCase() === code.toLowerCase()) ||
                (app.code && app.code.toLowerCase() === code.toLowerCase())
              );
              const hasCartDiscount = cartAfter.total_discount > 0;
              const hasItemDiscount = cartAfter.items && cartAfter.items.some(item =>
                item.discounts && item.discounts.some(d => d.title && d.title.toLowerCase() === code.toLowerCase())
              );

              if (hasApp || hasCartDiscount || hasItemDiscount) {
                // Step 5: SUCCESSFUL DISCOUNT
                this.appliedDiscountCode = code;
                localStorage.setItem('cart_applied_discount', code);
                localStorage.removeItem('cart_discount_cleared');
                localStorage.removeItem('cart_discount_clearing');

                await fetch('/cart/update.js', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ attributes: { 'user_applied_coupon': code } })
                });

                // Update checkout button URL with discount code
                const checkoutBtns = document.querySelectorAll('[data-checkout-btn], button[name="checkout"]');
                checkoutBtns.forEach(checkoutBtn => {
                  if (checkoutBtn.hasAttribute('href')) {
                    const url = new URL(checkoutBtn.getAttribute('href'), window.location.origin);
                    url.searchParams.set('discount', code);
                    checkoutBtn.setAttribute('href', url.pathname + url.search);
                  }
                });

                // Show apply/remove button states
                discBtn.style.display = 'none';
                const removeBtn = container.querySelector('[data-remove-coupon]');
                if (removeBtn) removeBtn.style.display = 'block';

                messageEl.innerHTML = `<span style="color: #4caf50; font-size: 13px; font-weight: 500; margin-top: 8px; display: block;">✓ Discount code "${code}" applied successfully!</span>`;
                this.updateCartUI(cartAfter);
                document.dispatchEvent(new CustomEvent('cart:updated'));
              } else {
                // Step 6: INVALID OR NON-APPLICABLE DISCOUNT
                // Reset the cookie Shopify just set so it doesn't break future checkout logic
                await fetch('/discount/CLEAR'); 
                
                this.appliedDiscountCode = null;
                localStorage.removeItem('cart_applied_discount');

                discBtn.textContent = originalText;
                discBtn.disabled = false;
                
                messageEl.innerHTML = `<span style="color: #f44336; font-size: 13px; font-weight: 500; margin-top: 8px; display: block;">✕ Invalid or non-applicable discount code.</span>`;
                
                // Update UI to ensure no discount remnants are shown
                this.updateCartUI(cartAfter);
              }
            } catch (err) {
              discBtn.textContent = originalText;
              discBtn.disabled = false;
              if (messageEl) messageEl.innerHTML = `<span style="color: #f44336; font-size: 13px; font-weight: 500; margin-top: 8px; display: block;">Error applying discount. Try again.</span>`;
            }

            return;
          }

          // 7b. Remove Discount
          const removeDiscBtn = e.target.closest('[data-remove-coupon]');
          if (removeDiscBtn) {
             const container = removeDiscBtn.closest('[data-discount-form-container]') || document;
             removeDiscBtn.textContent = 'Removing...';
             removeDiscBtn.disabled = true;

             try {
                // Clear Shopify session using multiple methods for reliability
                // Hit both invalid and standard clear endpoints to force a session update
                await fetch('/discount/NONE?t=' + Date.now(), { cache: 'no-store' }); 
                await fetch('/discount/CLEAR?t=' + Date.now(), { cache: 'no-store' }); 
                await fetch('/discount/1?t=' + Date.now(), { cache: 'no-store' }); 
                await fetch('/discount/ ?t=' + Date.now(), { cache: 'no-store' }); 
                await fetch('/checkout?discount=&t=' + Date.now(), { cache: 'no-store' }); 
                await new Promise(resolve => setTimeout(resolve, 1000));
                await fetch('/cart.js', { cache: 'no-store' }); // Wake up cart session
                
                // Clear UI state and flag as intentionally cleared to block staleness in Liquid
                this.appliedDiscountCode = null;
                localStorage.removeItem('cart_applied_discount');
                localStorage.setItem('cart_discount_cleared', 'true');
                localStorage.setItem('cart_discount_clearing', 'true');

                // Update cart attributes for server-side persistence
                await fetch('/cart/update.js', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ attributes: { 'user_applied_coupon': '', 'user_applied_discount': '' } })
                });
                
                // Keep the clearing flag active for several seconds to allow checkout/reloads to finish
                setTimeout(() => {
                  localStorage.removeItem('cart_discount_clearing');
                }, 5000);
                
                const discInput = container.querySelector('[data-discount-input]');
                if (discInput) discInput.value = '';
                
                const discBtn = container.querySelector('[data-apply-coupon]');
                if (discBtn) {
                   discBtn.style.display = 'block';
                   discBtn.textContent = 'Apply';
                   discBtn.disabled = false;
                }
                removeDiscBtn.style.display = 'none';
                removeDiscBtn.textContent = 'Remove';
                removeDiscBtn.disabled = false;

                const messageEl = container.querySelector('[data-discount-message]');
                if (messageEl) messageEl.innerHTML = '';

                // Update checkout link
                const checkoutBtns = document.querySelectorAll('[data-checkout-btn], button[name="checkout"]');
                checkoutBtns.forEach(checkoutBtn => {
                  if (checkoutBtn.hasAttribute('href')) {
                    const url = new URL(checkoutBtn.getAttribute('href'), window.location.origin);
                    url.searchParams.delete('discount');
                    checkoutBtn.setAttribute('href', url.pathname + url.search);
                  }
                });

                // Refresh numbers
                const cart = await this.refreshCart();
                if (cart) this.updateCartUI(cart);
                document.dispatchEvent(new CustomEvent('cart:updated'));
             } catch (err) {
                removeDiscBtn.textContent = 'Remove';
                removeDiscBtn.disabled = false;
             }
             return;
          }

          // 8. Note Save/Cancel
          const saveNoteBtn = e.target.closest('[data-note-save]');
          if (saveNoteBtn) {
            const container = saveNoteBtn.closest('.cart-drawer__note, .addon-content-pane, document');
            const noteInput = container ? container.querySelector('[data-cart-note]') : document.querySelector('[data-cart-note]');
            if (noteInput) {
              this.saveCartNote(noteInput.value, saveNoteBtn);
            }
            return;
          }

          const cancelNoteBtn = e.target.closest('[data-note-cancel]');
          if (cancelNoteBtn) {
            const container = cancelNoteBtn.closest('.cart-drawer__note, .addon-content-pane, document');
            const noteInput = container ? container.querySelector('[data-cart-note]') : document.querySelector('[data-cart-note]');
            if (noteInput) {
               noteInput.value = '';
               this.saveCartNote('');
            }
            return;
          }

          const cancelShippingBtn = e.target.closest('[data-shipping-cancel]');
          if (cancelShippingBtn) {
            const pane = cancelShippingBtn.closest('[data-addon-content="shipping"]');
            if (pane) {
              pane.querySelectorAll('input, select').forEach(el => {
                if (el.tagName === 'SELECT') {
                  el.selectedIndex = 0;
                  el.dispatchEvent(new Event('change', { bubbles: true }));
                } else {
                  el.value = '';
                }
              });
            }
            return;
          }
        });

        // Quantity input changes (delegated)
        document.addEventListener('input', (e) => {
           const discInput = e.target.closest('[data-discount-input]');
           if (discInput) {
             const container = discInput.closest('[data-discount-form-container]') || document;
             const messageEl = container.querySelector('[data-discount-message]');
             if (messageEl) messageEl.innerHTML = '';
           }
        });

        document.addEventListener('change', (e) => {
           const input = e.target.closest('[data-quantity-input]');
           if (input) {
             const itemKey = input.dataset.itemKey;
             const quantity = parseInt(input.value) || 1;
             this.updateQuantity(itemKey, 0, quantity);
           }
        });

        this.additionalCheckoutButtons = this.drawer.querySelector('.cart-drawer__additional-buttons');

        // Terms & Conditions enforcement
        document.addEventListener('click', (e) => {
          const checkoutBtn = e.target.closest('[data-checkout-btn], button[name="checkout"], .cart-drawer__additional-buttons');
          if (checkoutBtn && checkoutBtn.closest('.cart-drawer')) {
            const checkbox = document.querySelector('.cart-drawer [data-terms-checkbox]');
            if (checkbox && !checkbox.checked) {
              checkbox.reportValidity();
              e.preventDefault();
              e.stopPropagation();
              e.stopImmediatePropagation();
            }
          }
        }, true);

        // Ensure buttons are initially enabled
        const checkoutBtns = document.querySelectorAll('.cart-drawer [data-checkout-btn], .cart-drawer button[name="checkout"]');
        const additionalBtns = document.querySelectorAll('.cart-drawer__additional-buttons');
        checkoutBtns.forEach(btn => btn.removeAttribute('disabled'));
        additionalBtns.forEach(btnWrap => btnWrap.style.display = 'block');

        if (this.cartNoteInput) {
           this.lastSavedNote = this.cartNoteInput.value;
        }

        // Restore discount UI state from localStorage
        let storedDiscount = localStorage.getItem('cart_applied_discount');
        const drawerEl = document.querySelector('.cart-drawer');
        const liquidDiscountCode = drawerEl ? drawerEl.getAttribute('data-cart-discount-code') : '';
        const initialTotalDiscount = drawerEl ? parseInt(drawerEl.getAttribute('data-cart-total-discount')) || 0 : 0;
        const isClearing = localStorage.getItem('cart_discount_clearing');
        const hasBeenCleared = localStorage.getItem('cart_discount_cleared');

        if (liquidDiscountCode) {
          storedDiscount = liquidDiscountCode;
          this.appliedDiscountCode = storedDiscount;
          localStorage.setItem('cart_applied_discount', storedDiscount);
          localStorage.removeItem('cart_discount_cleared');
          localStorage.removeItem('cart_discount_clearing');
        } else {
          // If Liquid says there is NO discount code active... 
          // And there's no money being discounted...
          if (initialTotalDiscount === 0 && !isClearing) {
            // Then the discount has been removed (probably at checkout)
            storedDiscount = null;
            this.appliedDiscountCode = null;
            localStorage.removeItem('cart_applied_discount');
          }
        }

        if (storedDiscount && !isClearing) {
          // A discount was manually applied — restore UI to "applied" state
          this.appliedDiscountCode = storedDiscount;
          const discInputs = document.querySelectorAll('[data-discount-input]');
          const discBtns = document.querySelectorAll('[data-apply-coupon]');
          const removeBtns = document.querySelectorAll('[data-remove-coupon]');
          
          discInputs.forEach(input => input.value = storedDiscount);
          discBtns.forEach(btn => btn.style.display = 'none');
          removeBtns.forEach(btn => btn.style.display = 'block');
          
          if (initialTotalDiscount === 0) {
            document.querySelectorAll('[data-discounts-container]').forEach(c => c.style.display = 'none');
          }
          localStorage.removeItem('cart_discount_clearing');
        } else {
          // No discount active — reset UI to default "Apply" state
          if (!isClearing) {
            this.appliedDiscountCode = null;
            localStorage.removeItem('cart_applied_discount');
            document.querySelectorAll('[data-discount-input]').forEach(input => input.value = '');
          }
          document.querySelectorAll('[data-apply-coupon]').forEach(btn => btn.style.display = 'block');
          document.querySelectorAll('[data-remove-coupon]').forEach(btn => btn.style.display = 'none');
          document.querySelectorAll('[data-discounts-container]').forEach(c => {
             c.style.display = 'none';
             c.innerHTML = '';
          });
        }

        // Handle Enter key for discount input in drawer
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' && e.target.closest('[data-discount-input]')) {
            e.preventDefault();
            const container = e.target.closest('[data-discount-form-container]');
            const applyBtn = container ? container.querySelector('[data-apply-coupon]') : null;
            if (applyBtn && applyBtn.style.display !== 'none') {
              applyBtn.click();
            }
          }
        });

        document.addEventListener('cart:updated', async (e) => {
          // Always refresh UI when cart:updated is dispatched, regardless of drawer state
          const cart = await this.refreshCart();
          if (cart) {
            this.updateCartUI(cart);
          }
        });
        document.addEventListener('cart:refresh', async () => {
          const cart = await this.refreshCart();
          if (cart) this.updateCartUI(cart);
        });
        document.addEventListener('cart:open', () => {
          if (this.cartType === 'drawer' && this.drawer) {
            this.open();
          }
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.drawer?.classList.contains('active')) {
            this.close();
          }
        });

      }
      open() {
        if (this.drawer) {
          this.drawer.style.display = 'block';
          // Force a reflow
          this.drawer.offsetHeight;
          this.drawer.classList.add('active');
          document.body.style.overflow = 'hidden';
          this.initCountdown();
          
          // Ensure no hidden discount is applied at checkout if not active in cart
          if (!this.appliedDiscountCode) {
            fetch('/discount/ ');
          }

          this.refreshCart().then(() => {
            setTimeout(() => this.initRecommendationsSlider(), 200);
          }).catch(() => {
            setTimeout(() => this.initRecommendationsSlider(), 200);
          });
        }
      }
      initRecommendationsSlider() {
        const sliderEl = document.querySelector('[data-recommendations-slider]');
        if (!sliderEl) return;
        if (this.recommendationsSwiper) {
          this.recommendationsSwiper.destroy(true, true);
          this.recommendationsSwiper = null;
        }
        if (typeof Swiper !== 'undefined') {
          const slides = sliderEl.querySelectorAll('.swiper-slide');
          if (slides.length > 0) {
            this.recommendationsSwiper = new Swiper(sliderEl, {
              slidesPerView: 1,
              spaceBetween: 16,
              loop: false,
              pagination: {
                el: '[data-recommendations-dots]',
                clickable: true,
                bulletClass: 'dot',
                bulletActiveClass: 'swiper-pagination-bullet-active',
                renderBullet: function (index, className) {
                  return '<span class="' + className + '"></span>';
                }
              },
              breakpoints: {
                320: {
                  slidesPerView: 1,
                  spaceBetween: 12
                },
                480: {
                  slidesPerView: 1,
                  spaceBetween: 16
                }
              }
            });
          }
        }
      }
      close() {
        if (this.drawer) {
          this.drawer.classList.remove('active');
          document.body.style.overflow = '';
          setTimeout(() => {
            if (!this.drawer.classList.contains('active')) {
              this.drawer.style.display = 'none';
            }
          }, 300); // Wait for transition
        }
      }
      async updateQuantity(itemKey, change, newQuantity = null) {
        const item = document.querySelector(`[data-cart-item][data-item-key="${itemKey}"]`);
        if (!item) return;
        const input = item.querySelector('[data-quantity-input]');
        let quantity = parseInt(input.value) || 1;
        if (newQuantity !== null) {
          quantity = Math.max(1, newQuantity);
        } else {
          quantity = Math.max(1, quantity + change);
        }
        try {
          const response = await fetch('/cart/change.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: itemKey, quantity: quantity })
          });
          if (response.ok) {
            await this.refreshCart();
            document.dispatchEvent(new CustomEvent('cart:updated'));
          }
        } catch (error) {
        }
      }
      async removeItem(itemKey) {
        try {
          const response = await fetch('/cart/change.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: itemKey, quantity: 0 })
          });
          if (response.ok) {
            await this.refreshCart();
            document.dispatchEvent(new CustomEvent('cart:updated'));
          }
        } catch (error) {
        }
      }
      async refreshCart() {
        if (!this.drawer) return null;
        try {
          const cartRes = await fetch('/cart.js', { cache: 'no-store' });
          if (!cartRes.ok) return null;
          const cart = await cartRes.json();
          this.updateCartUI(cart);
          return cart;
        } catch (error) {
          return null;
        }
      }
      checkCartState() {
        const cartCount = parseInt(document.querySelector('[data-cart-count]')?.textContent || '0');
        const recommendationsSection = document.querySelector('.cart-drawer__recommendations');
        const footerSection = document.querySelector('.cart-drawer__footer');
        const countdownSection = document.querySelector('.cart-drawer__countdown');
        const shippingSection = document.querySelector('[data-shipping-progress]');
        if (cartCount === 0) {
          if (recommendationsSection) recommendationsSection.style.display = 'none';
          if (footerSection) footerSection.style.display = 'none';
          if (countdownSection) countdownSection.style.display = 'none';
          if (shippingSection) shippingSection.style.display = 'none';
        } else {
          if (recommendationsSection) recommendationsSection.style.display = 'block';
          if (footerSection) footerSection.style.display = 'block';
          if (countdownSection) countdownSection.style.display = 'flex';
          if (shippingSection) shippingSection.style.display = 'block';
        }
      }
      async updateCartUI(cart) {
        // Sync state from localStorage for cross-component consistency
        const storedDiscount = localStorage.getItem('cart_applied_discount');
        this.appliedDiscountCode = storedDiscount || null;
        
        const discInputs = document.querySelectorAll('[data-discount-input]');
        discInputs.forEach(input => {
          input.value = this.appliedDiscountCode || '';
        });

        const countEl = document.querySelector('[data-cart-count]');
        if (countEl) {
          countEl.textContent = cart.item_count;
        }
        const headerCounts = document.querySelectorAll('.header__cart-count');
        headerCounts.forEach(el => {
          if (cart.item_count > 0) {
            el.textContent = cart.item_count;
            el.style.display = 'flex';
          } else {
            el.style.display = 'none';
          }
        });
        const totalEls = document.querySelectorAll('[data-cart-total]');
        const subtotalEls = document.querySelectorAll('[data-cart-subtotal]');
        const originalTotalEls = document.querySelectorAll('[data-cart-original-total]');
        const discountAmountEls = document.querySelectorAll('[data-cart-discount-amount]');
        const discountWrappers = document.querySelectorAll('[data-discount-wrapper]');

        const hasDiscountApps = cart.discount_applications && cart.discount_applications.length > 0;
        // showDiscount: true when user has manually applied a code (regardless of cart.js discount visibility)
        const showDiscount = !!this.appliedDiscountCode;
        // showDiscountAmount: true only when cart.js actually reflects the discount
        const showDiscountAmount = showDiscount && (cart.total_discount > 0 || hasDiscountApps);

        totalEls.forEach(totalEl => {
          if (totalEl) {
            if (!showDiscount && cart.total_discount > 0) {
              // If no manual code applied but Shopify has auto-discount, show original price
              const originalPrice = parseInt(cart.total_price) + parseInt(cart.total_discount);
              totalEl.innerHTML = this.formatMoney(originalPrice);
            } else {
              totalEl.innerHTML = this.formatMoney(cart.total_price);
            }
          }
        });

        subtotalEls.forEach(subtotalEl => {
          if (subtotalEl) {
            const totalDiscounts = (cart.discount_applications || []).reduce((sum, app) => sum + (app.total_allocated_amount || 0), 0) || cart.total_discount;
            const originalSubtotal = parseInt(cart.total_price) + parseInt(totalDiscounts);
            subtotalEl.innerHTML = this.formatMoney(originalSubtotal);
          }
        });

        // Update generic discount containers (mostly used in cart page)
        const discountContainers = document.querySelectorAll('[data-discounts-container]');
        discountContainers.forEach(container => {
          container.innerHTML = ''; // Clear previous
          if (hasDiscountApps) {
            cart.discount_applications.forEach(app => {
              const row = document.createElement('div');
              row.className = 'summary-total-row discount-row';
              row.style.cssText = 'color: #2e7d32; display: flex; justify-content: space-between; align-items: center; font-weight: 700; font-size: 16px; width: 100%;';
              if (container.closest('.cart-main-column')) {
                 row.style.cssText = 'color: #2e7d32; display: flex;'; // Fallback for Design 1 layout specifics if needed
              }
              row.innerHTML = `
                <span class="cart-total-label" style="margin-bottom:0;">Discount (${this.escapeHtml(app.title)}):</span>
                <span class="value" style="text-align:right;">-${this.formatMoney(app.total_allocated_amount)}</span>
              `;
              container.appendChild(row);
            });
            container.style.display = 'block';
          } else {
            container.style.display = 'none';
          }
        });

        // Only show discount amount row if cart.js reflects the discount amount
        discountWrappers.forEach((discountWrapper, index) => {
          const originalTotalEl = originalTotalEls[index] || originalTotalEls[0];
          const discountAmountEl = discountAmountEls[index] || discountAmountEls[0];
          
          if (originalTotalEl && discountAmountEl && discountWrapper) {
            if (showDiscountAmount) {
              const originalPrice = parseInt(cart.total_price) + parseInt(cart.total_discount);
              originalTotalEl.innerHTML = this.formatMoney(originalPrice);
              discountAmountEl.innerHTML = `-${this.formatMoney(cart.total_discount)}`;
              discountWrapper.style.display = 'flex';
            } else {
              discountWrapper.style.display = 'none';
            }
          }
        });

        // Update checkout button URL — always include discount code when applied
        const checkoutBtns = document.querySelectorAll('[data-checkout-btn], button[name="checkout"]');
        checkoutBtns.forEach(checkoutBtn => {
          try {
            if (checkoutBtn.hasAttribute('href') || checkoutBtn.tagName === 'A') {
              const url = new URL(checkoutBtn.getAttribute('href'), window.location.origin);
              if (this.appliedDiscountCode) {
                url.searchParams.set('discount', this.appliedDiscountCode);
              } else {
                url.searchParams.delete('discount');
              }
              checkoutBtn.setAttribute('href', url.pathname + url.search);
            }
          } catch (e) {
          }
        });

        // Toggle all discount buttons globally
        const discBtns = document.querySelectorAll('[data-apply-coupon]');
        const removeBtns = document.querySelectorAll('[data-remove-coupon]');
        
        if (showDiscount) {
           discBtns.forEach(btn => btn.style.display = 'none');
           removeBtns.forEach(btn => btn.style.display = 'block');
        } else {
           discBtns.forEach(btn => btn.style.display = 'block');
           removeBtns.forEach(btn => btn.style.display = 'none');
           // Only clear localStorage if NO discount is applied AND cart has no discount
           if (!this.appliedDiscountCode && cart.total_discount === 0 && !hasDiscountApps) {
              localStorage.removeItem('cart_applied_discount');
           }
        }

        if (this.cartNoteInput && cart.note !== undefined) {
           this.cartNoteInput.value = cart.note || '';
           this.lastSavedNote = cart.note || '';
        }
        this.updateShippingProgress(cart.total_price);
        const itemsContainer = document.querySelector('[data-cart-items]');
        if (!itemsContainer) return;
        const recommendationsSection = document.querySelector('.cart-drawer__recommendations');
        const footerSection = document.querySelector('.cart-drawer__footer');
        const countdownSection = document.querySelector('.cart-drawer__countdown');
        const shippingSection = document.querySelector('[data-shipping-progress]');
        if (cart.item_count === 0) {
          if (recommendationsSection) recommendationsSection.style.display = 'none';
          if (footerSection) footerSection.style.display = 'none';
          if (countdownSection) countdownSection.style.display = 'none';
          if (shippingSection) shippingSection.style.display = 'none';
        } else {
          if (recommendationsSection) recommendationsSection.style.display = 'block';
          if (footerSection) footerSection.style.display = 'block';
          if (countdownSection) countdownSection.style.display = 'flex';
          if (shippingSection) shippingSection.style.display = 'block';
          // Start countdown if not already running
          if (!this.countdownInterval) {
            this.initCountdown();
          }
        }

        if (cart.item_count === 0) {
          itemsContainer.innerHTML = `
            <div class="cart-drawer__empty">
              <p>Your cart is empty</p>
              <a href="${window.Shopify?.routes?.collections_url || '/collections/all'}" class="cart-drawer__continue-shopping">Continue Shopping</a>
            </div>
          `;
        } else {
          let itemsHTML = '';
          cart.items.forEach(item => {
            let imageUrl = '';
            if (item.image) {
              if (item.image.includes('?')) {
                imageUrl = item.image.split('?')[0] + '?width=120&height=120';
              } else if (item.image.includes('_')) {
                imageUrl = item.image.replace(/_\d+x\d+/i, '_120x120');
              } else {
                imageUrl = item.image + '?width=120&height=120';
              }
            }
            const originalPrice = item.original_price !== item.final_price ? `<span class="cart-item__price--original">${this.formatMoney(item.original_price)}</span>` : '';
            itemsHTML += `
              <div class="cart-item" data-cart-item data-item-key="${item.key}">
                <div class="cart-item__image">
                  ${imageUrl ? `<a href="${item.url}"><img src="${imageUrl}" alt="${this.escapeHtml(item.product_title)}" loading="lazy" width="120" height="120" class="cart-item__img"></a>` : `<a href="${item.url}"><div class="cart-item__placeholder" style="width:100px;height:100px;background:#f5f5f5;display:flex;align-items:center;justify-content:center;border-radius:8px;color:#999;font-size:12px;">No Image</div></a>`}
                </div>
                <div class="cart-item__details">
                  <div class="cart-item__title">
                    <a href="${item.url}">${this.escapeHtml(item.product_title)}</a>
                  </div>
                  ${item.vendor ? `<p class="cart-item__vendor">${this.escapeHtml(item.vendor)}</p>` : ''}
                  ${item.variant_title && item.variant_title !== 'Default Title' ? `<p class="cart-item__variant">${this.escapeHtml(item.variant_title)}</p>` : ''}
                  <div class="cart-item__price">
                    ${originalPrice}
                    <span class="cart-item__price--current">${this.formatMoney(item.final_price)}</span>
                  </div>
                  <div class="cart-item__quantity">
                    <div class="quantity-input" data-quantity-selector>
                      <button type="button" class="quantity-input__btn quantity-input__btn--minus" data-quantity-selector-button="minus" aria-label="Decrease quantity" data-item-key="${item.key}" data-quantity-decrease>
                        <svg width="9" height="9" viewBox="0 0 12 2" fill="none" xmlns="https://www.w3.org/2000/svg">
                          <path d="M0 1H12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                      </button>
                      <input type="number" name="quantity" value="${item.quantity}" min="1" class="quantity-input__input" data-quantity-selector-input data-item-key="${item.key}" data-quantity-input>
                      <button type="button" class="quantity-input__btn quantity-input__btn--plus" data-quantity-selector-button="plus" aria-label="Increase quantity" data-item-key="${item.key}" data-quantity-increase>
                        <svg width="9" height="9" viewBox="0 0 12 12" fill="none" xmlns="https://www.w3.org/2000/svg">
                          <path d="M6 0V12M0 6H12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                      </button>
                    </div>
                  </div>
                </div>
                <button type="button" class="cart-item__remove" aria-label="Remove ${this.escapeHtml(item.product_title)}" data-remove-item data-item-key="${item.key}">
                 <svg xmlns="https://www.w3.org/2000/svg" width="16" height="18" viewBox="0 0 16 18" fill="none">
                  <path d="M1.25 4.5H2.75M2.75 4.5H14.75M2.75 4.5L2.75 15C2.75 15.3978 2.90804 15.7794 3.18934 16.0607C3.47064 16.342 3.85218 16.5 4.25 16.5H11.75C12.1478 16.5 12.5294 16.342 12.8107 16.0607C13.092 15.7794 13.25 15.3978 13.25 15V4.5M5 4.5V3C5 2.60218 5.15804 2.22064 5.43934 1.93934C5.72064 1.65804 6.10218 1.5 6.5 1.5H9.5C9.89782 1.5 10.2794 1.65804 10.5607 1.93934C10.842 2.22064 11 2.60218 11 3V4.5M6.5 8.25V12.75M9.5 8.25V12.75" stroke="#1E1E1E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                </button>
              </div>
            `;
          });
          itemsContainer.innerHTML = itemsHTML;
        }
      }
      updateShippingProgress(cartTotal) {
        const freeShippingThreshold = 50000; // $500 in cents
        const remaining = Math.max(0, freeShippingThreshold - cartTotal);
        const progress = Math.min(100, (cartTotal / freeShippingThreshold) * 100);
        const progressFill = document.querySelector('.shipping-progress-bar__fill');
        const progressIcon = document.querySelector('.shipping-progress-bar__icon');
        const progressMessage = document.querySelector('.shipping-progress__message');
        const progressWarning = document.querySelector('.shipping-progress__warning');
        if (progressFill) {
          progressFill.style.width = `${progress}%`;
        }
        // if (progressIcon) {
        //   progressIcon.style.left = `${progress}%`;
        // }
        if (progressMessage && progressWarning) {
          if (cartTotal >= freeShippingThreshold) {
            progressMessage.classList.add('shipping-progress__message--success');
            progressMessage.innerHTML = `
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M13.3333 4L6 11.3333L2.66667 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Congratulations! You've got free shipping!
            `;
            progressWarning.style.display = 'none';
          } else {
            progressMessage.classList.remove('shipping-progress__message--success');
            progressMessage.innerHTML = `Add ${this.formatMoney(remaining)} more to get free shipping!`;
            progressWarning.style.display = 'block';
          }
        }
      }
      hideAllAddons() {
        this.drawer.querySelectorAll('[data-addon-content]').forEach(c => {
          c.classList.remove('is-open');
          c.style.display = 'none';
        });
        this.drawer.querySelectorAll('[data-toggle-addon]').forEach(b => b.classList.remove('active'));
      }

      async saveCartNote(note, btn = null) {
        if (btn) {
           btn.textContent = 'SAVING...';
           btn.disabled = true;
        }
        try {
          await fetch('/cart/update.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ note: note })
          });
          this.lastSavedNote = note;
          if (this.cartNoteInput) {
            this.cartNoteInput.value = ''; // Clear textarea after successful save
          }
          if (btn) {
            btn.textContent = 'SAVED!';
            setTimeout(() => {
              btn.textContent = 'SAVE';
              btn.disabled = false;
            }, 2000);
          }
        } catch (error) {
          if (btn) {
            btn.textContent = 'SAVE';
            btn.disabled = false;
          }
        }
      }

      formatMoney(cents, format) {
        if (typeof cents === 'string') { cents = cents.replace('.', ''); }
        let value = '';
        const placeholderRegex = /\{\{\s*(\w+)\s*\}\}/;
        const formatString = format || window.Shopify?.money_format || window.Shopify?.shop?.money_format || '${{amount}}';

        function defaultOption(opt, def) {
          return (typeof opt == 'undefined' ? def : opt);
        }

        function formatWithDelimiters(number, precision, thousands, decimal) {
          precision = defaultOption(precision, 2);
          thousands = defaultOption(thousands, ',');
          decimal = defaultOption(decimal, '.');

          if (isNaN(number) || number == null) { return 0; }

          number = (number / 100.0).toFixed(precision);

          var parts = number.split('.'),
            dollars = parts[0].replace(/(\d)(?=(\d{3})+(?!\d))/g, '$1' + thousands),
            cents = parts[1] ? (decimal + parts[1]) : '';

          return dollars + cents;
        }

        switch (formatString.match(placeholderRegex)[1]) {
          case 'amount':
            value = formatWithDelimiters(cents, 2);
            break;
          case 'amount_no_decimals':
            value = formatWithDelimiters(cents, 0);
            break;
          case 'amount_with_comma_separator':
            value = formatWithDelimiters(cents, 2, '.', ',');
            break;
          case 'amount_no_decimals_with_comma_separator':
            value = formatWithDelimiters(cents, 0, '.', ',');
            break;
        }

        let formattedValue = formatString.replace(placeholderRegex, value);
  
        // Allow EUR swap logic if needed, plus INR logic
        if (window.Shopify && window.Shopify.currency) {
          if (window.Shopify.currency.active === 'EUR') {
            formattedValue = formattedValue.replace('.', 'TEMP').replace(',', '.').replace('TEMP', ',');
          } else if (window.Shopify.currency.active === 'INR') {
             formattedValue = formattedValue.replace(/Rs\./g, '₹').replace(/Rs/g, '₹').replace(/R /g, '₹ ');
          }
        }
        return formattedValue;
      }
      escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
      }
      getCartType() {
        if (this.drawer) {
          return this.drawer.getAttribute('data-cart-type') || 'drawer';
        }
        const hasDrawerOpen = document.querySelector('[data-cart-drawer-open]');
        if (hasDrawerOpen) {
          return 'drawer';
        }
        return 'page';
      }
      initCountdown() {
        const timerEl = document.getElementById('cart-countdown-timer');
        const countdownContainer = document.querySelector('.cart-drawer__countdown');
        if (!timerEl) return;

        // If countdown already running, don't start a new one
        if (this.countdownInterval) return;

        // Initialize timer if not already set
        if (this.countdownTime === undefined) {
          this.countdownTime = 600; // 10 minutes in seconds
        }

        const updateTimer = () => {
          const minutes = Math.floor(this.countdownTime / 60);
          const seconds = this.countdownTime % 60;
          timerEl.textContent = `${minutes.toString().padStart(2, '0')} m ${seconds.toString().padStart(2, '0')} s`;
          if (this.countdownTime > 0) {
            this.countdownTime--;
          } else {
            clearInterval(this.countdownInterval);
            this.countdownInterval = null;
          }
        };

        updateTimer();
        this.countdownInterval = setInterval(updateTimer, 1000);
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        window.cartDrawer = new CartDrawer();
        if (window.__queuedDrawerOpen) window.cartDrawer.open();
      });
    } else {
      window.cartDrawer = new CartDrawer();
      if (window.__queuedDrawerOpen) window.cartDrawer.open();
    }
  })();
</script>

