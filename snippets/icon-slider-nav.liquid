{% comment %}
  Renders slider navigation icons (prev/next).
  Usage:
  {% render 'icon-slider-nav', direction: 'prev' %}
  {% render 'icon-slider-nav', direction: 'next' %}
{% endcomment %}

{%- case direction -%}
  {%- when 'prev' -%}
    <svg class="icon-slider-nav-svg" width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M16 21L7 12L16 3" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'next' -%}
    <svg class="icon-slider-nav-svg" width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M8 21L17 12L8 3" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
{%- endcase -%}
